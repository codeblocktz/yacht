# Copy to .env and adjust. Every value can also be set directly in the
# environment; .env is a convenience, not a requirement.

# Required — Postgres connection string.
YACHT_DATABASE_URL=postgres://yacht:yacht@localhost:5432/yacht?sslmode=disable

# Listen address for the dashboard.
YACHT_ADDR=:8080

# Path to a kubeconfig. Leave unset to use the standard client-go loading
# rules (KUBECONFIG, then ~/.kube/config).
YACHT_KUBECONFIG=

# Set true when running inside the cluster with a mounted service account.
YACHT_KUBE_IN_CLUSTER=false

# Bearer token required on every request. Leaving this unset means the
# dashboard is UNAUTHENTICATED — acceptable on a laptop or a private network,
# not on anything reachable from the internet.
#   openssl rand -hex 24
YACHT_AUTH_TOKEN=

# The single owner every resource belongs to.
YACHT_OWNER_ID=owner-local
YACHT_OWNER_NAME=Local

YACHT_DEBUG=false
