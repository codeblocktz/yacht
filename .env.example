# Copy to .env and adjust. Every value can also be set directly in the
# environment; .env is a convenience, not a requirement.

# Custom-domain certificates are a cluster dependency, not a Yacht process
# setting. Fresh installs pin K3s to the reviewed v1.36 channel, pin
# cert-manager, and create the install-wide
# ClusterIssuer `yacht-acme` against Let's Encrypt staging by default. Select
# production explicitly when provisioning the host:
#
#   install.sh --acme-environment production --acme-email ops@example.com
#
# Production is rejected without the email. Use --skip-cert-manager when the
# capability should remain unavailable; Yacht and platform wildcard TLS still
# work. With --skip-k3s, the installer only inspects an already-ready compatible
# cert-manager, IngressClass/traefik, and ClusterIssuer and never changes the
# operator-managed cluster — ACME flags become validation only.
#
# Changing an existing issuer between staging and production is allowed only
# while no Certificate resources reference it. Otherwise the installer refuses
# the change: migrate/reissue through a separately named ClusterIssuer first.
#
# HTTP-01 requires public port 80 to reach the ingress controller. Do not apply
# a cluster-wide HTTP-to-HTTPS redirect: it prevents the ACME challenge even if
# each Yacht custom-domain Ingress is configured correctly.

# Required — Postgres connection string.
YACHT_DATABASE_URL=postgres://yacht:yacht@localhost:5432/yacht?sslmode=disable

# Listen address for the dashboard.
YACHT_ADDR=:8080

# Path to a kubeconfig. Leave unset to use the standard client-go loading
# rules (KUBECONFIG, then ~/.kube/config).
YACHT_KUBECONFIG=

# Set true when running inside the cluster with a mounted service account.
YACHT_KUBE_IN_CLUSTER=false

# Bearer token required on every request. Leaving this unset means the
# dashboard is UNAUTHENTICATED — acceptable on a laptop or a private network,
# not on anything reachable from the internet.
#   openssl rand -hex 24
YACHT_AUTH_TOKEN=

# The single owner every resource belongs to.
YACHT_OWNER_ID=owner-local
YACHT_OWNER_NAME=Local

YACHT_DEBUG=false

# Platform domain. An app has no public address until somebody presses
# Generate Domain, which gives it <app>-<environment>.up.<this>. Apps created
# before that existed keep the <name>.<this> they were given. Point wildcard DNS
# records for both *.apps.example.com and *.up.apps.example.com at the cluster:
# the second is not covered by the first once anything is published under
# up.apps.example.com, which an ACME challenge for its certificate does.
# Empty switches per-app hostnames off.
YACHT_APP_DOMAIN=

# Serve platform hostnames over TLS using the ingress controller's default
# certificate, which the operator provisions as a wildcard for YACHT_APP_DOMAIN
# carrying two names, *.<domain> and *.up.<domain>: a wildcard covers one label,
# and generated hostnames are two below the domain.
#
# One wildcard rather than a certificate per app because Let's Encrypt allows
# 50 certificates per registered domain per week — a subdomain per app stops
# being issuable after app #50, and the failure surfaces as a rate limit
# against a domain nobody touched.
YACHT_WILDCARD_TLS=false

# The cert-manager ClusterIssuer each custom domain gets its own certificate
# from. The installer sets this to yacht-acme when cert-manager is ready.
#
# Custom domains only: the wildcard above can never cover a name outside the
# platform domain, and one certificate per brought domain stays well inside
# Let's Encrypt's limits in a way one per app would not. Issuance is HTTP-01,
# so public port 80 must reach the cluster and must not be redirected to HTTPS
# cluster-wide. Empty serves custom domains over plain HTTP.
YACHT_CERT_ISSUER=

# The people who run the install itself, as email addresses, comma separated:
# the only ones who see and change nodes, pods across teams, the registry and
# DNS. Empty means the owner of whichever team is signed in — right for an
# install with one team. Set it the moment an install hosts more than one:
# otherwise every team's owner can drain the nodes the others run on.
YACHT_OPERATORS=

# Pin custom-domain lookups to one nameserver, as host or host:port.
#
# Empty is almost always right. By default Yacht asks the domain's own
# nameservers, which hold no cache: a record created two seconds ago verifies
# two seconds later. Naming a recursive resolver here gives that up — every
# recursive resolver caches negative answers, and the check made just before
# somebody creates a record is what puts one there.
#
# Worth setting for a split-horizon install, where the answer that matters is
# the one a particular resolver gives rather than the one the public internet
# would.
# YACHT_DNS_RESOLVER=10.0.0.53

# TCP proxies: a public <host>:<port> on every machine for an app's own port,
# for databases and anything else that does not speak HTTP. The host is the
# name people are told to connect to — any name that resolves to the machines.
# Empty switches TCP proxies off.
# YACHT_TCP_PROXY_HOST=proxy.apps.example.com
# The ports proxies are given, as a range. They are NodePorts, so they must be
# within the cluster's NodePort range (30000-32767 by default), and every
# machine's firewall must let them in from the internet. The default is the
# range's low band, which Kubernetes hands to no Service that did not ask for
# a port of its own.
# YACHT_TCP_PROXY_PORTS=30000-30085

# How far teams are kept apart on the cluster's network. "team" (the default)
# refuses every connection into a team's apps from another team's, or from a
# build. "strict" also limits what apps and builds connect out to: DNS, their
# own team, and public addresses, never the nodes' network or anything else
# private. "off" writes no network policy.
# YACHT_NETWORK_ISOLATION=team
# Private ranges strict isolation still lets apps and builds reach, as CIDRs,
# comma-separated: an image registry on the LAN, say.
# YACHT_EGRESS_ALLOW=10.0.0.20/32

# The region new apps are placed in when nobody chooses one, and the one every
# app made before regions existed is recorded in: a value of the
# topology.kubernetes.io/region label on the cluster's nodes. Empty leaves it
# to the open regions — the only one, or the first by name. Ignored while no
# node carries a region.
# YACHT_DEFAULT_REGION=fsn

# Whether edits to an app's variables and rolling settings wait for Deploy on
# the canvas's changes bar (true), or deploy as each one is saved (false).
# YACHT_STAGE_CHANGES=true

# Additional domain suffixes no tenant may claim, comma-separated.
# YACHT_APP_DOMAIN is always reserved whether or not it is listed here.
YACHT_RESERVED_DOMAINS=

# How long to wait for in-flight requests during graceful shutdown.
YACHT_SHUTDOWN_TIMEOUT=15s

# Cluster-wide build admission ceiling. Build containers also receive CPU and
# memory defaults/maxima in the dedicated namespace, so this is a real bound.
YACHT_MAX_CONCURRENT_BUILDS=2

# The install's GitHub App, which a team connects on its Team page to build
# private repositories and deploy on push with no webhook of its own. Create
# the App on GitHub first — the README's "GitHub App" section has every
# setting — then copy its values here. Leave all of these empty for no App:
# a repository is then a pasted URL, cloned anonymously. Set any, and all of
# them are required, with YACHT_BASE_URL.
#
# The numeric App ID, and the slug from the App's public page,
# github.com/apps/<slug>.
YACHT_GITHUB_APP_ID=
YACHT_GITHUB_APP_SLUG=
# The private key GitHub generated, as its PEM text — newlines may be written
# \n to keep it on one line — or as the path of the .pem file instead. One or
# the other, not both.
YACHT_GITHUB_APP_PRIVATE_KEY=
YACHT_GITHUB_APP_PRIVATE_KEY_FILE=
# The webhook secret given to GitHub, at least 16 characters.
# Generate with: openssl rand -hex 32
YACHT_GITHUB_APP_WEBHOOK_SECRET=
# The App's OAuth client ID and a client secret, which prove that the person
# connecting an installation can reach it on GitHub.
YACHT_GITHUB_APP_CLIENT_ID=
YACHT_GITHUB_APP_CLIENT_SECRET=

# Where the cluster reaches the engine's waker, as ip:port. An app that sleeps
# when idle has its hostnames routed here, and the waker scales it back up on
# the next request. Unset, no app can sleep — nothing could wake it.
#
# An IP the ingress controller's pods can reach: this node's address when the
# engine runs as a process on a cluster node (the installer's layout), or the
# cluster IP of a Service in front of it when it runs in the cluster. Open the
# port to the cluster's pod network. The waker is its own listener, never the
# dashboard's, so exposing it to the cluster exposes nothing else.
YACHT_WAKER_ADDR=
# Where the waker listens. Defaults to every interface on YACHT_WAKER_ADDR's port.
YACHT_WAKER_LISTEN=
# How long a wake may take — from asking for a sleeping app's pods to one being
# ready — before it is put back to sleep. A request is held this long at most.
YACHT_WAKE_TIMEOUT=60s

# Public URL the dashboard is reached at. This is what a sign-in link is built
# from, and setting it is what switches accounts on: people, teams, invitations
# and session cookies instead of a single owner.
#
# Accounts stay off until it is set, because sign-in with no address to put in
# the link locks you out of your own dashboard with no way back.
YACHT_BASE_URL=

# SMTP relay for sign-in links, as host:port. Empty means no relay.
#
# With no relay and no Resend key, links are written to the log instead. That
# is deliberate: it is the only way back in when mail delivery breaks after
# accounts are switched on, and it is only safe because reading the log
# already implies host access.
YACHT_SMTP_ADDR=

# Relay credentials. Leave both empty for an unauthenticated relay; a password
# with no username is rejected at startup rather than sent anonymously.
YACHT_SMTP_USER=
YACHT_SMTP_PASSWORD=

# Envelope sender for relayed mail. Required whenever YACHT_SMTP_ADDR is set.
YACHT_SMTP_FROM=

# Resend's HTTP API instead of a relay, for a host with no SMTP to hand.
# Configuring more than one transport fails at startup rather than picking one.
YACHT_RESEND_API_KEY=
YACHT_RESEND_FROM=

# Cloudflare Email Sending's HTTP API, for a domain onboarded to it: its SMTP
# is on port 465 only, which many hosts block. The token needs Email Sending:
# Edit on the account.
YACHT_CLOUDFLARE_EMAIL_TOKEN=
YACHT_CLOUDFLARE_EMAIL_ACCOUNT_ID=
YACHT_CLOUDFLARE_EMAIL_FROM=
# Where replies go, when not to the from address (a no-reply one, say).
YACHT_CLOUDFLARE_EMAIL_REPLY_TO=

# How long a signed-in browser stays signed in.
YACHT_SESSION_TTL=720h

# How long a sign-in link stays redeemable. Short on purpose: the link is a
# bearer credential sitting in a mailbox until it is used or expires.
YACHT_MAGIC_LINK_TTL=15m

# The address that may sign in to a fresh install before anybody has an
# account. Links are only ever sent to addresses that already exist, which is
# what stops the sign-in form filling the user table — and would otherwise
# leave a new install with accounts on impossible to enter. Only applies until
# that address has an account.
YACHT_OWNER_EMAIL=

# Lets anybody make an account. An address nobody holds is mailed a link that
# creates its account when followed — never before, so the form still cannot
# fill the user table — and whoever follows it gets a team of their own. The
# team the install runs as stays kept for YACHT_OWNER_EMAIL. Off by default,
# which keeps an install to its owner and the people they invite.
#
# Requires YACHT_OPERATORS, YACHT_OWNER_EMAIL and a mail transport: without
# named operators everybody who signs up owns a team, and so runs the install.
YACHT_OPEN_SIGNUP=false

# Seals secret environment variables before they are stored, so a database
# dump is useless without it. Generate with: openssl rand -base64 32
#
# Unset, variables still work but marking one secret is refused rather than
# stored readable. Losing this key means losing every secret sealed with it.
YACHT_SECRET_KEY=

# Keys kept only to open values sealed before the current one, comma-separated.
# Nothing is ever sealed with these.
#
# Leave it empty until you replace a key. To replace one: put the new key in
# YACHT_SECRET_KEY, move the old one here, restart. Every stored value keeps
# opening either way, and each one moves to the new key the next time it is
# written. Remove the old key from here only once nothing still needs it —
# taken away too early, those values cannot be recovered.
YACHT_SECRET_KEY_PREVIOUS=
