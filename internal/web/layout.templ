package web

import (
	"github.com/codeblocktz/yacht/internal/identity"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// Layout renders the chrome around a page.
//
// Note what this component does NOT do: it never reads an owner, a session, or
// anything about who is asking. Everything variable arrives as Slots. That is
// what lets a wrapping application change the entire look of the shell without
// touching this file.
templ Layout(s Slots, page templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.Title }</title>
			// SVG first for anything that takes one, with a raster fallback
			// behind it: Safari before 16 ignores an SVG favicon entirely and
			// shows a blank page glyph rather than falling back to nothing.
			<link rel="icon" type="image/svg+xml" href={ asset("/assets/brand/icon.svg") }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ asset("/assets/brand/icon-32.png") }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ asset("/assets/brand/icon-180.png") }/>
			// A link to this dashboard is usually pasted into a chat. Without
			// these it arrives as a bare URL with no name and no picture.
			<meta property="og:title" content={ s.Title }/>
			<meta property="og:type" content="website"/>
			<meta property="og:image" content={ asset("/assets/brand/social.png") }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="stylesheet" href={ asset("/assets/css/app.css") }/>
			@themeScript()
			@sidebarScript()
			<script src={ asset("/assets/js/htmx.min.js") } defer></script>
			@sheet.Script()
			if s.FullBleed {
				<script src={ asset("/assets/js/canvas.js") } defer></script>
			}
		</head>
		<body class="h-full">
			<div class="flex h-full">
				<div class="nav-backdrop" onclick="yachtSidebarToggle()" aria-hidden="true"></div>
				@sidebar(s)
				<div class="flex min-w-0 flex-1 flex-col">
					@topbar(s)
					if s.Banner != nil {
						<div class="border-b border-border px-6 py-3">
							@slot(s.Banner)
						</div>
					}
					if s.FullBleed {
						// No wrapper and no scroll here: the page fills what is
						// left of the window and scrolls its own content, which
						// is what lets a canvas be the size of the screen.
						<main class="flex min-h-0 flex-1 flex-col overflow-hidden">
							@page
						</main>
					} else {
						<main class="min-h-0 flex-1 overflow-y-auto">
							<div class="mx-auto w-full max-w-[1240px] px-6 py-6">
								@page
							</div>
						</main>
					}
				</div>
			</div>
		</body>
	</html>
}

// sidebar renders the navigation panel.
//
// Every label in here is wrapped rather than bare, because the collapsed rail
// hides labels and shows icons, and CSS can only hide what it can select. The
// markup therefore has one form in both states: nothing below decides whether
// the sidebar is collapsed, and neither does the server. See sidebarScript().
//
// The aside is deliberately not overflow-hidden. In the rail both menus open
// beside the sidebar rather than inside it, and a clipping context here erases
// them. Nothing overflows anyway: the labels are display:none when collapsed
// rather than merely too wide to fit.
templ sidebar(s Slots) {
	<aside
		id="sidebar"
		class="sidebar"
	>
		<a
			href={ templ.URL(s.BrandHref) }
			class="brand relative mb-1 flex items-center gap-2.5 px-2 py-1.5 text-[14px] font-semibold tracking-tight"
			aria-label={ s.BrandName }
		>
			@brandMark("h-[19px] w-auto shrink-0")
			<span class="rail-hide truncate">
				if s.BrandName == DefaultBrandName {
					@brandWordmark("h-[13px] w-auto")
				} else {
					{ s.BrandName }
				}
			</span>
			<span class="nav-tip" aria-hidden="true">{ s.BrandName }</span>
		</a>
		if s.SidebarTop != nil {
			<div class="mb-1">
				@slot(s.SidebarTop)
			</div>
		}
		<nav class="flex flex-col gap-px">
			for _, g := range s.Nav {
				if g.Heading != "" {
					<div class="nav-group">{ g.Heading }</div>
				}
				for _, item := range g.Items {
					<a
						href={ templ.URL(item.Href) }
						class={ "nav-item", templ.KV("nav-active", item.Active) }
						aria-label={ item.Label }
					>
						if item.Icon != "" {
							@icon(item.Icon)
						}
						<span class="rail-hide truncate">{ item.Label }</span>
						if item.Badge != "" {
							<span class="rail-hide ml-auto tag">{ item.Badge }</span>
						}
						<span class="nav-tip" aria-hidden="true">{ item.Label }</span>
					</a>
				}
			}
		</nav>
		<div class="mt-auto pt-3">
			if s.SidebarFooter != nil {
				@slot(s.SidebarFooter)
			}
		</div>
	</aside>
}

// TeamSwitcher moves the session between the teams a person belongs to.
//
// Every entry is a submit button in one POST form. A link would be a GET that
// changes what the whole dashboard is scoped by, and prefetchers and crawlers
// follow links — being moved into another team by a page you merely hovered
// over is a confusing way to end up acting somewhere you did not choose.
//
// The list is only the chrome's copy of what the session already proved.
// Membership is checked again on the way in, so an entry forged into this form
// switches into nothing.
//
// details/summary rather than a scripted menu: the dashboard's one piece of
// state that must work is the control that says which team you are in, and it
// should not need JavaScript to open.
//
// The bordered box is not decoration. Sitting flush in a column of navigation
// links, this read as one more link — and the one control on the page that
// changes what every query is scoped by should not look like a way to go to a
// page. The border is what says it opens something.
//
// Shares a name with the user menu so the browser closes one when the other
// opens. Two panels hanging over the sidebar at once is the kind of thing a
// scripted menu needs a listener for; native exclusive details does it for
// free.
templ TeamSwitcher(teams []TeamChoice) {
	<details name="sidebar-menu" class="group relative">
		<summary class="switcher">
			<span class="avatar">{ initials(activeTeamName(teams)) }</span>
			<span class="rail-hide min-w-0 flex-1 truncate text-left font-medium">
				{ activeTeamName(teams) }
			</span>
			<svg
				class="rail-hide size-3.5 shrink-0 opacity-60 group-open:rotate-180"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M6 9l6 6 6-6"></path>
			</svg>
			<span class="nav-tip" aria-hidden="true">{ activeTeamName(teams) }</span>
		</summary>
		<form
			method="post"
			action="/teams/switch"
			class="switcher-menu left-0 right-0 top-full mt-1"
		>
			for _, team := range teams {
				<button
					type="submit"
					name="team"
					value={ team.ID }
					class={ "switcher-item",
						templ.KV("font-medium text-foreground", team.Active) }
				>
					<span class="min-w-0 flex-1 truncate">{ team.Name }</span>
					if team.Active {
						<span class="text-[11px] text-muted-foreground">current</span>
					} else {
						<span class="text-[11px] text-muted-foreground">{ string(team.Role) }</span>
					}
				</button>
			}
		</form>
	</details>
}

// UserMenu is the sidebar's floor: who the session belongs to, and the actions
// that belong to the session rather than to any page.
//
// A details/summary for the same reason the switcher is one — the control that
// signs you out is the last thing that should need JavaScript to open — and it
// opens upward because it sits on the floor of the panel.
//
// canSignOut is false on a token-authenticated install. There is no session to
// end there and /sign-out is not routed at all, so the buttons would 404;
// drawing nothing is better than drawing a control that cannot work. It is the
// same question the switcher answers by having no teams to offer.
templ UserMenu(owner identity.Owner, canSignOut bool) {
	<details name="sidebar-menu" class="group relative">
		<summary class="switcher">
			<span class="avatar">{ initials(ownerLabel(owner)) }</span>
			<span class="rail-hide flex min-w-0 flex-1 flex-col text-left">
				<span class="truncate font-medium leading-tight">{ ownerLabel(owner) }</span>
				if owner.Email != "" && owner.Email != ownerLabel(owner) {
					<span class="truncate text-[11px] leading-tight text-muted-foreground">
						{ owner.Email }
					</span>
				}
			</span>
			<svg
				class="rail-hide size-3.5 shrink-0 opacity-60 group-open:rotate-180"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M6 9l6 6 6-6"></path>
			</svg>
			<span class="nav-tip" aria-hidden="true">{ ownerLabel(owner) }</span>
		</summary>
		<div class="switcher-menu bottom-full left-0 right-0 mb-1">
			<a href="/settings" class="switcher-item">
				@icon("settings")
				<span class="flex-1">Settings</span>
			</a>
			if canSignOut {
				<div class="my-1 h-px bg-border"></div>
				<form method="post" action="/sign-out">
					<button type="submit" class="switcher-item switcher-danger">
						@icon("log-out")
						<span class="flex-1">Sign out</span>
					</button>
				</form>
				// Separate from Sign out on purpose: it ends sessions on every
				// other browser too, which is a bigger thing than leaving here,
				// and the two should not be one slip apart.
				<form method="post" action="/sign-out-everywhere">
					<button type="submit" class="switcher-item">
						<span class="size-4 shrink-0"></span>
						<span class="flex-1 text-[11px]">Sign out everywhere</span>
					</button>
				</form>
			}
		</div>
	</details>
}

templ topbar(s Slots) {
	<header class="flex h-12 shrink-0 items-center gap-3 border-b border-border px-6">
		@sidebarToggle()
		<div class="flex min-w-0 items-center gap-2 text-[12.5px] text-muted-foreground">
			for i, crumb := range s.Breadcrumb {
				if i > 0 {
					<span class="text-border">/</span>
				}
				if crumb.Href != "" {
					<a href={ templ.URL(crumb.Href) } class="truncate hover:text-foreground">
						{ crumb.Label }
					</a>
				} else {
					<span class="truncate text-foreground">{ crumb.Label }</span>
				}
			}
		</div>
		<div class="flex-1"></div>
		if s.HeaderTools != nil {
			@slot(s.HeaderTools)
		}
		@themeToggle()
	</header>
}

// themeScript resolves the theme before first paint.
//
// Inline and synchronous on purpose. Applying the class from a deferred script
// or after DOMContentLoaded means a dark-mode user sees a white flash on every
// navigation, which looks broken however good the rest of the page is.
templ themeScript() {
	<script nonce="">
		(function() {
			try {
				var stored = localStorage.getItem("yacht-theme");
				var dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			} catch (e) {
				/* Private browsing can throw on localStorage. The OS preference
				   is a fine fallback and a broken toggle must not break the page. */
			}
		})();
	</script>
}

// sidebarToggle collapses the sidebar to its icon rail and back.
//
// It lives in the top bar rather than in the sidebar because it has to be in
// the same place in both states: a control that moves when you use it is one
// you have to find again every time. Hidden below md, where there is no
// sidebar to collapse.
templ sidebarToggle() {
	<button
		type="button"
		class="btn btn-ghost btn-icon -ml-2"
		aria-label="Toggle sidebar"
		aria-controls="sidebar"
		aria-expanded="true"
		data-sidebar-toggle
		onclick="yachtSidebarToggle()"
	>
		@icon("panel-left")
	</button>
}

// sidebarScript resolves the collapsed state before first paint.
//
// Inline and synchronous for the same reason as themeScript: applying the
// attribute after DOMContentLoaded means anyone who keeps the sidebar
// collapsed watches it snap shut on every navigation.
//
// Setting the attribute before the aside exists also means the width
// transition never runs on load — it animates when someone presses the
// button, and not when a page arrives already collapsed.
templ sidebarScript() {
	<script nonce="">
		(function() {
			var root = document.documentElement;
			try {
				if (localStorage.getItem("yacht-sidebar") === "collapsed") {
					root.setAttribute("data-sidebar", "collapsed");
				}
			} catch (e) {
				/* Private browsing can throw on localStorage. An expanded
				   sidebar is the right fallback and a broken toggle must not
				   break the page. */
			}
			function sync() {
				var open = onPhone()
					? root.getAttribute("data-nav") === "open"
					: root.getAttribute("data-sidebar") !== "collapsed";
				var buttons = document.querySelectorAll("[data-sidebar-toggle]");
				for (var i = 0; i < buttons.length; i++) {
					buttons[i].setAttribute("aria-expanded", open ? "true" : "false");
				}
			}
			/* Below md the same button opens a drawer instead of collapsing a
			   rail, because there is no room beside the page for a rail and no
			   other way to reach another page.

			   The drawer state is deliberately not stored. Every link here is a
			   full page load, so a drawer that remembered being open would
			   reopen itself over whatever you had just navigated to. The rail's
			   collapsed state is stored for the opposite reason: it is where you
			   left the furniture, not a thing you are in the middle of. */
			function onPhone() {
				return !window.matchMedia("(min-width: 768px)").matches;
			}

			window.yachtSidebarToggle = function() {
				if (onPhone()) {
					var open = root.getAttribute("data-nav") === "open";
					root.setAttribute("data-nav", open ? "closed" : "open");
					sync();
					return;
				}
				var collapsed = root.getAttribute("data-sidebar") === "collapsed";
				root.setAttribute("data-sidebar", collapsed ? "expanded" : "collapsed");
				try {
					localStorage.setItem(
						"yacht-sidebar",
						collapsed ? "expanded" : "collapsed"
					);
				} catch (e) {}
				sync();
			};
			/* Escape closes the drawer. It covers the page, so the usual way
			   out of something covering the page has to work. */
			document.addEventListener("keydown", function(event) {
				if (
					event.key === "Escape" &&
					root.getAttribute("data-nav") === "open"
				) {
					root.setAttribute("data-nav", "closed");
					sync();
				}
			});

			/* The button does not exist yet at this point in the head, so the
			   state it advertises is corrected once the body has parsed. On a
			   phone that correction matters: the markup says expanded, and the
			   drawer starts shut. */
			document.addEventListener("DOMContentLoaded", sync);
		})();
	</script>
}

templ themeToggle() {
	<button
		type="button"
		class="btn btn-ghost btn-icon"
		aria-label="Toggle theme"
		onclick="(function(){var d=document.documentElement.classList.toggle('dark');try{localStorage.setItem('yacht-theme',d?'dark':'light')}catch(e){}})()"
	>
		<svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
		</svg>
		<svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
			<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
		</svg>
	</button>
}

// icon renders one of a small fixed set of inline glyphs.
//
// The paths are Lucide (ISC licensed), copied in rather than pulled from a
// package. Inline SVG rather than an icon font or a sprite request: the set is
// tiny, and a self-hosted dashboard should not need a second network round trip
// to draw its own navigation. Copying also means only the dozen icons actually
// used are carried, instead of the whole set for the sake of twelve.
//
// Lucide's own names are kept where they match. Where this dashboard's word is
// clearer in context — "disk" for hard-drive, "storage" for database — the
// mapping is here and nowhere else, so a name in a template does not have to be
// translated to find the drawing.
templ icon(name string) {
	<svg
		class="size-4 shrink-0 opacity-70"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		switch name {
			case "grid":
				<rect width="7" height="7" x="3" y="3" rx="1"></rect>
				<rect width="7" height="7" x="14" y="3" rx="1"></rect>
				<rect width="7" height="7" x="14" y="14" rx="1"></rect>
				<rect width="7" height="7" x="3" y="14" rx="1"></rect>
			case "boxes":
				<path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"></path>
				<path d="m7 16.5-4.74-2.85"></path>
				<path d="m7 16.5 5-3"></path>
				<path d="M7 16.5v5.17"></path>
				<path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"></path>
				<path d="m17 16.5-5-3"></path>
				<path d="m17 16.5 4.74-2.85"></path>
				<path d="M17 16.5v5.17"></path>
				<path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"></path>
				<path d="M12 8 7.26 5.15"></path>
				<path d="m12 8 4.74-2.85"></path>
				<path d="M12 13.5V8"></path>
			case "maximize":
				<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
				<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
				<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
				<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
			case "plus":
				<path d="M5 12h14"></path>
				<path d="M12 5v14"></path>
			case "minus":
				<path d="M5 12h14"></path>
			case "box":
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			case "package":
				<path d="m7.5 4.27 9 5.15"></path>
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "server":
				<rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
				<rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect>
				<line x1="6" x2="6.01" y1="6" y2="6"></line>
				<line x1="6" x2="6.01" y1="18" y2="18"></line>
			case "cpu":
				<rect width="16" height="16" x="4" y="4" rx="2"></rect>
				<rect width="6" height="6" x="9" y="9" rx="1"></rect>
				<path d="M15 2v2"></path>
				<path d="M15 20v2"></path>
				<path d="M2 15h2"></path>
				<path d="M2 9h2"></path>
				<path d="M20 15h2"></path>
				<path d="M20 9h2"></path>
				<path d="M9 2v2"></path>
				<path d="M9 20v2"></path>
			case "layers":
				<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path>
				<path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
				<path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
			case "rocket":
				<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
				<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
				<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
				<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
			case "disk":
				<line x1="22" x2="2" y1="12" y2="12"></line>
				<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
				<line x1="6" x2="6.01" y1="16" y2="16"></line>
				<line x1="10" x2="10.01" y1="16" y2="16"></line>
			case "storage":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
				<path d="M3 12A9 3 0 0 0 21 12"></path>
			case "grip":
				<circle cx="9" cy="12" r="1"></circle>
				<circle cx="9" cy="5" r="1"></circle>
