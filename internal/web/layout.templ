package web

import "github.com/codeblocktz/yacht/internal/web/ui/sheet"

// Layout renders the chrome around a page.
//
// Note what this component does NOT do: it never reads an owner, a session, or
// anything about who is asking. Everything variable arrives as Slots. That is
// what lets a wrapping application change the entire look of the shell without
// touching this file.
templ Layout(s Slots, page templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.Title }</title>
			<link rel="icon" href="data:,"/>
			<link rel="stylesheet" href={ asset("/assets/css/app.css") }/>
			@themeScript()
			<script src={ asset("/assets/js/htmx.min.js") } defer></script>
			@sheet.Script()
			if s.FullBleed {
				<script src={ asset("/assets/js/canvas.js") } defer></script>
			}
		</head>
		<body class="h-full">
			<div class="flex h-full">
				@sidebar(s)
				<div class="flex min-w-0 flex-1 flex-col">
					@topbar(s)
					if s.Banner != nil {
						<div class="border-b border-border px-6 py-3">
							@slot(s.Banner)
						</div>
					}
					if s.FullBleed {
						// No wrapper and no scroll here: the page fills what is
						// left of the window and scrolls its own content, which
						// is what lets a canvas be the size of the screen.
						<main class="flex min-h-0 flex-1 flex-col overflow-hidden">
							@page
						</main>
					} else {
						<main class="min-h-0 flex-1 overflow-y-auto">
							<div class="mx-auto w-full max-w-[1240px] px-6 py-6">
								@page
							</div>
						</main>
					}
				</div>
			</div>
		</body>
	</html>
}

templ sidebar(s Slots) {
	<aside class="hidden w-[228px] shrink-0 flex-col gap-px border-r border-sidebar-border bg-sidebar px-2.5 py-3 md:flex">
		<a
			href={ templ.URL(s.BrandHref) }
			class="mb-1 flex items-center gap-2.5 px-2 py-1.5 text-[14px] font-semibold tracking-tight"
		>
			<span class="size-4 shrink-0 rounded-[5px] bg-gradient-to-br from-brand to-brand/40 ring-1 ring-inset ring-white/10"></span>
			{ s.BrandName }
		</a>
		if s.SidebarTop != nil {
			<div class="mb-1 px-1">
				@slot(s.SidebarTop)
			</div>
		}
		<nav class="flex flex-col gap-px">
			for _, g := range s.Nav {
				if g.Heading != "" {
					<div class="nav-group">{ g.Heading }</div>
				}
				for _, item := range g.Items {
					<a
						href={ templ.URL(item.Href) }
						class={ "nav-item", templ.KV("nav-active", item.Active) }
					>
						if item.Icon != "" {
							@icon(item.Icon)
						}
						<span class="truncate">{ item.Label }</span>
						if item.Badge != "" {
							<span class="ml-auto tag">{ item.Badge }</span>
						}
					</a>
				}
			}
		</nav>
		<div class="mt-auto pt-3">
			if s.SidebarFooter != nil {
				@slot(s.SidebarFooter)
			}
		</div>
	</aside>
}

// TeamSwitcher moves the session between the teams a person belongs to.
//
// Every entry is a submit button in one POST form. A link would be a GET that
// changes what the whole dashboard is scoped by, and prefetchers and crawlers
// follow links — being moved into another team by a page you merely hovered
// over is a confusing way to end up acting somewhere you did not choose.
//
// The list is only the chrome's copy of what the session already proved.
// Membership is checked again on the way in, so an entry forged into this form
// switches into nothing.
//
// details/summary rather than a scripted menu: the dashboard's one piece of
// state that must work is the control that says which team you are in, and it
// should not need JavaScript to open.
templ TeamSwitcher(teams []TeamChoice) {
	<details class="group relative">
		<summary class="flex cursor-pointer list-none items-center gap-2 rounded-md px-2 py-1.5 text-[12.5px] hover:bg-sidebar-accent [&::-webkit-details-marker]:hidden">
			<span class="size-4 shrink-0 rounded-[5px] bg-muted ring-1 ring-inset ring-border"></span>
			<span class="min-w-0 flex-1 truncate font-medium">{ activeTeamName(teams) }</span>
			<svg
				class="size-3.5 shrink-0 opacity-60 group-open:rotate-180"
				viewBox="0 0 24 24"
				fill="none"
				stroke="currentColor"
				stroke-width="1.7"
				stroke-linecap="round"
				stroke-linejoin="round"
			>
				<path d="M6 9l6 6 6-6"></path>
			</svg>
		</summary>
		<form
			method="post"
			action="/teams/switch"
			class="absolute left-0 right-0 z-20 mt-1 flex flex-col gap-px rounded-md border border-border bg-popover p-1 shadow-lg"
		>
			for _, team := range teams {
				<button
					type="submit"
					name="team"
					value={ team.ID }
					class={ "flex items-center gap-2 rounded px-2 py-1.5 text-left text-[12.5px] hover:bg-muted",
						templ.KV("font-medium", team.Active) }
				>
					<span class="min-w-0 flex-1 truncate">{ team.Name }</span>
					if team.Active {
						<span class="text-[11px] text-muted-foreground">current</span>
					} else {
						<span class="text-[11px] text-muted-foreground">{ string(team.Role) }</span>
					}
				</button>
			}
		</form>
	</details>
}

templ topbar(s Slots) {
	<header class="flex h-12 shrink-0 items-center gap-3 border-b border-border px-6">
		<div class="flex min-w-0 items-center gap-2 text-[12.5px] text-muted-foreground">
			for i, crumb := range s.Breadcrumb {
				if i > 0 {
					<span class="text-border">/</span>
				}
				if crumb.Href != "" {
					<a href={ templ.URL(crumb.Href) } class="truncate hover:text-foreground">
						{ crumb.Label }
					</a>
				} else {
					<span class="truncate text-foreground">{ crumb.Label }</span>
				}
			}
		</div>
		<div class="flex-1"></div>
		if s.HeaderTools != nil {
			@slot(s.HeaderTools)
		}
		@themeToggle()
	</header>
}

// themeScript resolves the theme before first paint.
//
// Inline and synchronous on purpose. Applying the class from a deferred script
// or after DOMContentLoaded means a dark-mode user sees a white flash on every
// navigation, which looks broken however good the rest of the page is.
templ themeScript() {
	<script nonce="">
		(function () {
			try {
				var stored = localStorage.getItem("yacht-theme");
				var dark = stored ? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			} catch (e) {
				/* Private browsing can throw on localStorage. The OS preference
				   is a fine fallback and a broken toggle must not break the page. */
			}
		})();
	</script>
}

templ themeToggle() {
	<button
		type="button"
		class="btn btn-ghost btn-icon"
		aria-label="Toggle theme"
		onclick="(function(){var d=document.documentElement.classList.toggle('dark');try{localStorage.setItem('yacht-theme',d?'dark':'light')}catch(e){}})()"
	>
		<svg class="size-4 dark:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M6.3 17.7l-1.4 1.4M19.1 4.9l-1.4 1.4"></path>
		</svg>
		<svg class="hidden size-4 dark:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
			<path d="M21 12.8A9 9 0 1111.2 3a7 7 0 009.8 9.8z"></path>
		</svg>
	</button>
}

// icon renders one of a small fixed set of inline glyphs.
//
// Inline SVG rather than an icon font or a sprite request: the set is tiny, and
// a self-hosted dashboard should not need a second network round trip to draw
// its own navigation.
templ icon(name string) {
	<svg
		class="size-4 shrink-0 opacity-70"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="1.7"
		stroke-linecap="round"
		stroke-linejoin="round"
	>
		switch name {
			case "grid":
				<rect x="3" y="3" width="7" height="7" rx="1.5"></rect>
				<rect x="14" y="3" width="7" height="7" rx="1.5"></rect>
				<rect x="3" y="14" width="7" height="7" rx="1.5"></rect>
				<rect x="14" y="14" width="7" height="7" rx="1.5"></rect>
			case "box":
				<path d="M21 8v8l-9 5-9-5V8l9-5 9 5z"></path>
				<path d="M3 8l9 5 9-5M12 13v8"></path>
			case "server":
				<rect x="3" y="4" width="18" height="7" rx="2"></rect>
				<rect x="3" y="13" width="18" height="7" rx="2"></rect>
				<path d="M7 8h.01M7 17h.01"></path>
			case "cpu":
				<rect x="7" y="7" width="10" height="10" rx="2"></rect>
				<path d="M10 3v2M14 3v2M10 19v2M14 19v2M3 10h2M3 14h2M19 10h2M19 14h2"></path>
			case "layers":
				<path d="M12 3l9 5-9 5-9-5 9-5z"></path>
				<path d="M3 13l9 5 9-5"></path>
			case "rocket":
				<path d="M5 13l-2 6 6-2 8-8a4 4 0 00-4-4z"></path>
				<path d="M14 5l5 5M9 15l-2-2"></path>
			case "disk":
				<rect x="3" y="6" width="18" height="12" rx="2"></rect>
				<path d="M7 12h.01M11 12h6"></path>
			case "grip":
				<circle cx="9" cy="6" r="1"></circle>
				<circle cx="15" cy="6" r="1"></circle>
				<circle cx="9" cy="12" r="1"></circle>
				<circle cx="15" cy="12" r="1"></circle>
				<circle cx="9" cy="18" r="1"></circle>
				<circle cx="15" cy="18" r="1"></circle>
			case "activity":
				<path d="M3 12h4l2-6 4 12 2-6h6"></path>
			case "external":
				<path d="M14 4h6v6"></path>
				<path d="M20 4l-8 8"></path>
				<path d="M18 14v5a1 1 0 01-1 1H5a1 1 0 01-1-1V7a1 1 0 011-1h5"></path>
			case "users":
				<path d="M16 21v-2a4 4 0 00-4-4H6a4 4 0 00-4 4v2"></path>
				<circle cx="9" cy="7" r="4"></circle>
				<path d="M22 21v-2a4 4 0 00-3-3.87"></path>
				<path d="M16 3.13a4 4 0 010 7.75"></path>
			case "settings":
				<circle cx="12" cy="12" r="3"></circle>
				<path d="M19.4 15a1.7 1.7 0 00.3 1.9l.1.1a2 2 0 11-2.8 2.8l-.1-.1a1.7 1.7 0 00-2.9 1.2v.2a2 2 0 11-4 0v-.1a1.7 1.7 0 00-2.9-1.3l-.1.1a2 2 0 11-2.8-2.8l.1-.1A1.7 1.7 0 003.5 15a2 2 0 010-4h.2a1.7 1.7 0 001.2-2.9l-.1-.1a2 2 0 112.8-2.8l.1.1A1.7 1.7 0 0011 4.6a2 2 0 014 0v.2a1.7 1.7 0 002.9 1.2l.1-.1a2 2 0 112.8 2.8l-.1.1a1.7 1.7 0 00.3 1.9 2 2 0 010 4z"></path>
		}
	</svg>
}
