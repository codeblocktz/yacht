package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/identity"
	"github.com/codeblocktz/yacht/internal/web/ui/checkbox"
	"github.com/codeblocktz/yacht/internal/web/ui/dialog"
	"github.com/codeblocktz/yacht/internal/web/ui/popover"
	"github.com/codeblocktz/yacht/internal/web/ui/selectbox"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// Layout renders the chrome around a page.
//
// Note what this component does NOT do: it never reads an owner, a session, or
// anything about who is asking. Everything variable arrives as Slots. That is
// what lets a wrapping application change the entire look of the shell without
// touching this file.
templ Layout(s Slots, page templ.Component) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ s.Title }</title>
			// SVG first for anything that takes one, with a raster fallback
			// behind it: Safari before 16 ignores an SVG favicon entirely and
			// shows a blank page glyph rather than falling back to nothing.
			<link rel="icon" type="image/svg+xml" href={ asset("/assets/brand/icon.svg") }/>
			<link rel="icon" type="image/png" sizes="32x32" href={ asset("/assets/brand/icon-32.png") }/>
			<link rel="apple-touch-icon" sizes="180x180" href={ asset("/assets/brand/icon-180.png") }/>
			// A link to this dashboard is usually pasted into a chat. Without
			// these it arrives as a bare URL with no name and no picture.
			<meta property="og:title" content={ s.Title }/>
			<meta property="og:type" content="website"/>
			<meta property="og:image" content={ asset("/assets/brand/social.png") }/>
			<meta name="twitter:card" content="summary_large_image"/>
			<link rel="stylesheet" href={ asset("/assets/css/app.css") }/>
			@themeScript()
			@sidebarScript()
			<script src={ asset("/assets/js/htmx.min.js") } defer></script>
			@sheet.Script()
			@selectbox.Script()
			// Sheet already pulls dialog's script in, so asking for it by name
			// costs nothing — both sit behind the same once-handle — and says
			// out loud that dialogs are used here in their own right rather than
			// arriving as a side effect of sheets.
			//
			// Popover genuinely was not loaded, which made every popover in the
			// tree inert markup. Loaded here rather than per page for the reason
			// logs.js is: a script that does nothing without its markup costs
			// less than every future page remembering to ask for it.
			@dialog.Script()
			@popover.Script()
			@checkbox.Script()
			if s.FullBleed {
				<script src={ asset("/assets/js/canvas.js") } defer></script>
				<script src={ asset("/assets/js/charts.js") } defer></script>
			}
			// Loaded everywhere rather than behind a flag: it does nothing on a
			// page with no [data-log-stream], and gating it would mean every
			// future page that shows a log remembering to ask for it.
			<script src={ asset("/assets/js/logs.js") } defer></script>
			<script src={ asset("/assets/js/forms.js") } defer></script>
			<script src={ asset("/assets/js/toasts.js") } defer></script>
			<script src={ asset("/assets/js/copy.js") } defer></script>
			<script src={ asset("/assets/js/sliders.js") } defer></script>
			// The sidebar's menus, project tree and theme choice, and the
			// command palette. Their own files rather than inline: they are
			// the largest scripts the chrome has, and only the parts that must
			// run before paint are worth the inline cost.
			<script src={ asset("/assets/js/sidebar.js") } defer></script>
			<script src={ asset("/assets/js/palette.js") } defer></script>
		</head>
		<body class="h-full">
			if s.Bare {
				// No sidebar, no top bar, no skip link — there is nothing to
				// skip past. The page is the window.
				// min-h-dvh rather than min-h-full: a percentage height only
				// resolves against a parent that has one, and justify-center
				// then does nothing at all — the card sits at the top of an
				// empty screen looking like the page failed to finish loading.
				// The dynamic viewport unit also survives a mobile browser's
				// address bar sliding away.
				<main id="main-content" class="flex min-h-dvh flex-col justify-center overflow-y-auto px-4 py-10">
					@page
				</main>
				@confirmationDialog()
				@toastHost(s.Flash)
			} else {
				@appShell(s, page)
			}
		</body>
	</html>
}

// appShell is the dashboard's chrome: the sidebar, the top bar, and the content
// column between them.
//
// Split out of Layout so that a bare page is an alternative to the whole shell
// rather than the shell with every part of it emptied. Nilling the slots leaves
// the rail and the header behind, which is how a sign-in form ended up sitting
// beside an empty sidebar.
templ appShell(s Slots, page templ.Component) {
	<a class="skip-link" href="#main-content">Skip to content</a>
	<div class="flex h-full">
		<button type="button" tabindex="-1" class="nav-backdrop" data-nav-backdrop onclick="yachtSidebarToggle()" aria-label="Close navigation"></button>
		@sidebar(s)
		<div class="flex min-w-0 flex-1 flex-col" data-app-shell>
			@topbar(s)
			// The acting notice is composed in here, above whatever Banner the
			// slots carry, rather than left to the SlotProvider. See
			// withActingBanner for why this is the one thing the layout reads
			// from the request.
			{{ banner := withActingBanner(ctx, s.Banner) }}
			if isActingBanner(banner) {
				@banner
			} else if banner != nil {
				<div class="border-b border-border px-6 py-3">
					@slot(banner)
				</div>
			}
			if s.FullBleed {
				// No wrapper and no scroll here: the page fills what is left of
				// the window and scrolls its own content, which is what lets a
				// canvas be the size of the screen.
				<main id="main-content" tabindex="-1" class="flex min-h-0 flex-1 flex-col overflow-hidden">
					@page
				</main>
			} else {
				<main id="main-content" tabindex="-1" class="min-h-0 flex-1 overflow-y-auto">
					<div class="mx-auto w-full max-w-[1240px] px-4 py-6 sm:px-6">
						@page
					</div>
				</main>
			}
		</div>
	</div>
	// Outside the shell rather than in it: the shell is made inert while the
	// phone drawer is open, and a dialog inside an inert subtree cannot take
	// focus even as a modal.
	@palette(s.SearchIndex)
	@confirmationDialog()
	@toastHost(s.Flash)
}

// toastHost renders the outcome of whatever the last request did.
//
// The host element exists even with nothing to say, because it is the live
// region: a region announced only when it appears is a region added at the same
// moment as its content, and a screen reader has nothing registered to announce
// against. Present and empty, it announces what arrives in it.
//
// A message rendered here on page load is still not announced — a live region
// reports changes, and content that was in the initial HTML never changed. That
// is what toasts.js re-inserts it for. Without JavaScript it stays exactly where
// it is and stays readable, which is the part that matters.
templ toastHost(f *Flash) {
	<div class="toast-host" data-toast-host role="status" aria-live="polite">
		if f != nil {
			<div
				class={ "toast", f.Class() }
				data-toast
				if f.Assertive() {
					data-toast-assertive
				}
			>
				<div class="toast-body">{ f.Text }</div>
				<button
					type="button"
					class="toast-close"
					aria-label="Dismiss"
					data-toast-close
				>
					<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M18 6 6 18M6 6l12 12"></path>
					</svg>
				</button>
			</div>
		}
	</div>
}

// sidebar renders the navigation panel.
//
// Three bands. The top says where you are — the product, the team, and a way
// to search it. The middle is everywhere you can go, and scrolls when that is
// more than the window holds. The floor is you. Top and floor stay put while
// the middle scrolls, because "which team is this" and "sign out" should never
// be scrolled out of reach.
//
// Every label in here is wrapped rather than bare, because the collapsed rail
// hides labels and shows icons, and CSS can only hide what it can select. The
// markup therefore has one form in both states: nothing below decides whether
// the sidebar is collapsed, and neither does the server. See sidebarScript().
//
// The aside is deliberately not overflow-hidden. In the rail the menus and the
// tooltips open beside the sidebar rather than inside it, and a clipping
// context here erases them. Only the middle band scrolls, and in the rail it
// stops scrolling for the same reason (see the collapsed-rail rules in
// input.css).
templ sidebar(s Slots) {
	{{ lead, rest, admin := navSections(s.Nav) }}
	{{ parent := treeParentHref(s.Projects) }}
	<aside
		id="sidebar"
		class="sidebar"
		aria-label="Primary navigation"
	>
		<div class="sidebar-head">
			<a
				href={ templ.URL(s.BrandHref) }
				class="brand"
				aria-label={ s.BrandName }
			>
				if s.BrandMark != nil {
					@s.BrandMark
				} else {
					@brandMark("h-[19px] w-auto shrink-0")
				}
				<span class="rail-hide truncate">
					if s.BrandName == DefaultBrandName {
						@brandWordmark("h-[13px] w-auto")
					} else {
						{ s.BrandName }
					}
				</span>
				<span class="nav-tip" aria-hidden="true">{ s.BrandName }</span>
			</a>
			if s.SidebarTop != nil {
				@slot(s.SidebarTop)
			}
			@searchButton()
		</div>
		<div class="sidebar-body">
			<nav class="sidebar-nav" aria-label="Main">
				for _, g := range lead {
					@navGroup(g, parent)
				}
				if s.Projects != nil {
					@projectTree(*s.Projects)
				}
				for _, g := range rest {
					@navGroup(g, parent)
				}
				// The install's own pages sit apart, at the bottom, whatever
				// order the groups arrived in: the line that matters is between
				// the people who run the install and the people using it, and a
				// wrapping application that reorders its groups keeps it.
				if len(admin) > 0 {
					<div class="nav-admin">
						for _, g := range admin {
							@navGroup(g, parent)
						}
					</div>
				}
			</nav>
		</div>
		if s.SidebarFooter != nil {
			<div class="sidebar-foot">
				@slot(s.SidebarFooter)
			</div>
		}
	</aside>
}

// navGroup is one labelled block of links.
//
// parent is the href of the link that leads to the project tree, when the
// tree itself is showing where you are. That link is then drawn as the
// section you are in rather than as the place: one filled row in the sidebar,
// not two saying the same thing at different sizes. In the rail, where the
// tree is hidden, it is filled again.
templ navGroup(g NavGroup, parent string) {
	<div class="nav-section">
		if g.Heading != "" {
			<div class="nav-group">{ g.Heading }</div>
		}
		for _, item := range g.Items {
			@navItem(item, g.Heading, item.Active && parent != "" && item.Href == parent)
		}
	</div>
}

// navItem is one link. data-nav-item is what the command palette reads its
// pages from, so every link here — a wrapping application's too — is also
// somewhere the palette can go, with nothing to register.
templ navItem(item NavItem, group string, parent bool) {
	<a
		href={ templ.URL(item.Href) }
		class={ "nav-item", templ.KV("nav-active", item.Active), templ.KV("nav-parent", parent) }
		aria-label={ navItemName(item) }
		if item.Active {
			aria-current="page"
		}
		data-nav-item
		data-nav-label={ item.Label }
		data-nav-group={ group }
	>
		if item.Icon != "" {
			@icon(item.Icon)
		}
		<span class="rail-hide min-w-0 flex-1 truncate">{ item.Label }</span>
		if item.Badge != "" {
			<span class={ "nav-badge rail-hide", templ.KV("nav-badge-live", item.Live) }>{ item.Badge }</span>
			// In the rail there is no room for a number, but there is for the
			// fact that something is happening.
			<span class={ "nav-dot", templ.KV("nav-dot-live", item.Live) } aria-hidden="true"></span>
		}
		<span class="nav-tip" aria-hidden="true">
			{ item.Label }
			if item.Badge != "" {
				<span class="nav-tip-badge">{ item.Badge }</span>
			}
		</span>
	</a>
}

// searchButton opens the command palette.
//
// Drawn like a field rather than an icon, because a field says "type here"
// and an icon only says "something about search". The shortcut is on it so
// that the second time, nobody needs the button.
templ searchButton() {
	<button
		type="button"
		class="sidebar-search"
		aria-label="Search"
		aria-haspopup="dialog"
		aria-controls="palette"
		aria-keyshortcuts="Meta+K Control+K /"
		data-palette-open
	>
		@icon("search")
		<span class="rail-hide flex-1 truncate text-left">Search…</span>
		<kbd class="kbd rail-hide" data-shortcut-label>⌘K</kbd>
		<span class="nav-tip" aria-hidden="true">Search <span class="nav-tip-badge" data-shortcut-label>⌘K</span></span>
	</button>
}

// projectTree is the team's projects, each opening to the apps on its canvas.
//
// A tree in the ARIA sense, not just in looks: one tab stop, arrow keys to move
// and to open and close, the way a file tree in an editor behaves. The rows are
// links, so a click still goes to the canvas; the chevron beside a row is what
// opens it, and is left out of the tab order because the arrow keys already do
// its job.
//
// Which projects are open is remembered by the browser, per project, and
// applied by the inline script at the end before the tree is painted — so a
// project left open does not visibly snap open on every navigation. The one
// being looked at is opened by the server regardless.
//
// Not drawn in the collapsed rail. A column of project initials is a column of
// guesses; the Projects entry above it is one click from the whole list.
templ projectTree(p SidebarProjects) {
	<div class="nav-section rail-hide">
		<div class="nav-group" id="nav-projects-heading">Projects</div>
		if len(p.Items) > 0 {
			<ul class="tree" role="tree" aria-labelledby="nav-projects-heading" data-tree>
				for i, pr := range p.Items {
					<li
						role="none"
						class="tree-node"
						data-tree-node={ pr.Key }
						if pr.Open {
							data-open
						}
					>
						<div class="tree-row">
							<a
								role="treeitem"
								href={ templ.URL(pr.Href) }
								class={ "tree-item", templ.KV("tree-active", pr.Active) }
								aria-level="1"
								if len(pr.Apps) > 0 {
									aria-expanded={ ariaBool(pr.Open) }
									aria-owns={ "tree-group-" + pr.Key }
								}
								if pr.Active {
									aria-current="page"
								}
								tabindex={ treeTabIndex(p.Items, i) }
							>
								<span class="tree-avatar" aria-hidden="true">{ initials(pr.Name) }</span>
								<span class="min-w-0 flex-1 truncate">{ pr.Name }</span>
								if len(pr.Apps) > 0 {
									// A deploy in flight shows on the project while it is
									// closed, so it is not only findable by opening each one.
									if projectDeploying(pr) {
										<span class="tree-live status-info" title="Deploying" aria-hidden="true"></span>
									}
									<span class="tree-count" aria-hidden="true">{ strconv.Itoa(len(pr.Apps)) }</span>
								}
							</a>
							if len(pr.Apps) > 0 {
								<button
									type="button"
									class="tree-toggle"
									tabindex="-1"
									aria-hidden="true"
									data-tree-toggle
								>
									@icon("chevron-right")
								</button>
							}
						</div>
						if len(pr.Apps) > 0 {
							<ul role="group" class="tree-group" id={ "tree-group-" + pr.Key }>
								for _, a := range pr.Apps {
									<li role="none">
										<a
											role="treeitem"
											href={ templ.URL(a.Href) }
											class={ "tree-item tree-leaf", templ.KV("tree-active", a.Active) }
											aria-level="2"
											if a.Active {
												aria-current="page"
											}
											tabindex="-1"
											title={ appStateLabel(a.State) }
										>
											<span class={ "tree-dot", appStateClass(a.State) } aria-hidden="true"></span>
											<span class="min-w-0 flex-1 truncate">{ a.Name }</span>
											<span class="sr-only">— { appStateLabel(a.State) }</span>
										</a>
									</li>
								}
							</ul>
						}
					</li>
				}
			</ul>
			@treeRestore()
		}
		if p.More > 0 && p.AllHref != "" {
			<a href={ templ.URL(p.AllHref) } class="tree-extra">
				@icon("arrow-right")
				<span class="flex-1">All projects</span>
				<span class="tree-count">+{ strconv.Itoa(p.More) }</span>
			</a>
		}
		if p.NewHref != "" {
			<a href={ templ.URL(p.NewHref) } class="tree-extra">
				@icon("plus")
				<span class="flex-1">New project</span>
			</a>
		}
	</div>
}

// treeRestore re-opens the projects this browser left open, before paint.
//
// Inline and synchronous for the reason themeScript is: applied from a deferred
// script, every open project would draw shut and then snap open on every page.
templ treeRestore() {
	<script nonce="">
		(function() {
			try {
				var open = JSON.parse(localStorage.getItem("yacht-tree") || "{}") || {};
				var nodes = document.querySelectorAll("[data-tree-node]");
				for (var i = 0; i < nodes.length; i++) {
					if (open[nodes[i].getAttribute("data-tree-node")] !== true) continue;
					nodes[i].setAttribute("data-open", "");
					var item = nodes[i].querySelector("[aria-expanded]");
					if (item) item.setAttribute("aria-expanded", "true");
				}
			} catch (e) {
				/* Nothing remembered is the right fallback. */
			}
		})();
	</script>
}

// TeamSwitcher moves the session between the teams a person belongs to.
//
// Every entry is a submit button for one POST form. A link would be a GET that
// changes what the whole dashboard is scoped by, and prefetchers and crawlers
// follow links — being moved into another team by a page you merely hovered
// over is a confusing way to end up acting somewhere you did not choose. The
// form sits outside the menu and the buttons name it, so the menu holds only
// menu items.
//
// The list is only the chrome's copy of what the session already proved.
// Membership is checked again on the way in, so an entry forged into this form
// switches into nothing.
//
// details/summary underneath the menu behaviour: the dashboard's one piece of
// state that must work is the control that says which team you are in, and it
// opens without JavaScript. sidebar.js adds what a menu should have on top —
// arrow keys, Escape, closing when you click away.
//
// It is not a bordered box any more, where it sat at the bottom among the
// links and needed one to not read as a link. At the top, under the brand,
// with the viewer's role beneath the name and the up-down chevron beside it,
// it reads as the thing that says where you are — which is how the tools this
// borrows from draw it.
//
// Shares a name with the user menu so the browser closes one when the other
// opens.
templ TeamSwitcher(teams []TeamChoice) {
	{{ name := activeTeamName(teams) }}
	<details name="sidebar-menu" class="group relative" data-menu>
		<summary class="switcher" aria-haspopup="menu" aria-label={ "Team: " + name + ". Switch team" }>
			<span class="team-avatar" aria-hidden="true">{ initials(name) }</span>
			<span class="rail-hide flex min-w-0 flex-1 flex-col text-left">
				<span class="truncate text-[13px] font-medium leading-[1.25] text-foreground">{ name }</span>
				<span class="truncate text-[11px] leading-[1.3] text-muted-foreground">{ roleLabel(activeTeamRole(teams)) }</span>
			</span>
			<span class="rail-hide switcher-chevron">
				@icon("chevrons-up-down")
			</span>
			<span class="nav-tip" aria-hidden="true">{ name }</span>
		</summary>
		<form id="team-switch" method="post" action="/teams/switch" hidden></form>
		<div class="switcher-menu menu-down" role="menu" aria-label="Teams">
			<div class="menu-label" aria-hidden="true">Teams</div>
			for _, team := range teams {
				if team.Active {
					// Choosing the team you are already in closes the menu
					// rather than posting a switch to where you already are.
					<button
						type="button"
						role="menuitemradio"
						aria-checked="true"
						class="switcher-item"
						data-team={ team.ID }
						data-menu-close
					>
						<span class="team-avatar team-avatar-sm" aria-hidden="true">{ initials(team.Name) }</span>
						<span class="min-w-0 flex-1 truncate text-foreground">{ team.Name }</span>
						<span class="menu-check">
							@icon("check")
						</span>
					</button>
				} else {
					<button
						type="submit"
						form="team-switch"
						name="team"
						value={ team.ID }
						role="menuitemradio"
						aria-checked="false"
						class="switcher-item"
					>
						<span class="team-avatar team-avatar-sm" aria-hidden="true">{ initials(team.Name) }</span>
						<span class="min-w-0 flex-1 truncate">{ team.Name }</span>
						<span class="text-[11px] text-muted-foreground">{ roleLabel(team.Role) }</span>
					</button>
				}
			}
			<div class="menu-sep" role="separator"></div>
			<a href="/team" role="menuitem" class="switcher-item">
				@icon("users")
				<span class="flex-1">Team settings</span>
			</a>
		</div>
	</details>
}

// TeamIdentity is the top of the sidebar where there is nothing to switch
// between: an install with no accounts, where the one owner is the team, or an
// operator acting as a team for support, who stops from the banner rather than
// from here.
//
// The same shape as the switcher, so the top of the sidebar answers "where am
// I" the same way on every install; no chevron, because it opens nothing.
templ TeamIdentity(name, role string, acting bool) {
	<div class="switcher switcher-static" aria-label={ name + ", " + role } role="group">
		<span class={ "team-avatar", templ.KV("team-avatar-acting", acting) } aria-hidden="true">{ initials(name) }</span>
		<span class="rail-hide flex min-w-0 flex-1 flex-col text-left">
			<span class="truncate text-[13px] font-medium leading-[1.25] text-foreground">{ name }</span>
			<span class={ "truncate text-[11px] leading-[1.3]", templ.KV("text-warning", acting), templ.KV("text-muted-foreground", !acting) }>{ role }</span>
		</span>
		<span class="nav-tip" aria-hidden="true">{ name }</span>
	</div>
}

// UserMenu is the sidebar's floor: who the session belongs to, and the actions
// that belong to the session rather than to any page.
//
// A details/summary for the same reason the switcher is one — the control that
// signs you out is the last thing that should need JavaScript to open — and it
// opens upward because it sits on the floor of the panel.
//
// The theme lives here rather than as a button in the top bar. It is a
// preference of the person, not of the page, and a three-way choice — light,
// dark, or whatever the system says — does not fit on one icon that can only
// flip between two. The palette's "Toggle theme" is there for the keyboard.
//
// canSignOut is false on a token-authenticated install. There is no session to
// end there and /sign-out is not routed at all, so the buttons would 404;
// drawing nothing is better than drawing a control that cannot work. The same
// holds for /account, which is routed exactly when sign-out is.
templ UserMenu(owner identity.Owner, canSignOut bool) {
	{{ label := ownerLabel(owner) }}
	<details name="sidebar-menu" class="group relative" data-menu>
		<summary class="switcher" aria-haspopup="menu" aria-label={ label + ". Account menu" }>
			<span class="user-avatar" aria-hidden="true">{ initials(label) }</span>
			<span class="rail-hide flex min-w-0 flex-1 flex-col text-left">
				<span class="truncate text-[13px] font-medium leading-[1.25] text-foreground">{ label }</span>
				if owner.Email != "" && owner.Email != label {
					<span class="truncate text-[11px] leading-[1.3] text-muted-foreground">{ owner.Email }</span>
				}
			</span>
			<span class="rail-hide switcher-chevron">
				@icon("chevrons-up-down")
			</span>
			<span class="nav-tip" aria-hidden="true">{ label }</span>
		</summary>
		<div class="switcher-menu menu-up" role="menu" aria-label="Account">
			if canSignOut {
				<a href="/account" role="menuitem" class="switcher-item">
					@icon("user")
					<span class="flex-1">Account</span>
				</a>
			}
			<div class="menu-theme" role="group" aria-label="Theme">
				<span class="menu-theme-label" aria-hidden="true">
					@icon("sun-moon")
					Theme
				</span>
				<span class="seg">
					<button type="button" role="menuitemradio" aria-checked="false" class="seg-item" data-theme-set="light" aria-label="Light theme" title="Light">
						@icon("sun")
					</button>
					<button type="button" role="menuitemradio" aria-checked="false" class="seg-item" data-theme-set="dark" aria-label="Dark theme" title="Dark">
						@icon("moon")
					</button>
					<button type="button" role="menuitemradio" aria-checked="false" class="seg-item" data-theme-set="system" aria-label="Match the system theme" title="System">
						@icon("monitor")
					</button>
				</span>
			</div>
			<a href="https://github.com/codeblocktz/yacht#readme" role="menuitem" class="switcher-item" target="_blank" rel="noreferrer">
				@icon("book-open")
				<span class="flex-1">Docs</span>
				<span class="menu-trail">
					@icon("external")
				</span>
			</a>
			if canSignOut {
				<div class="menu-sep" role="separator"></div>
				<form method="post" action="/sign-out" role="none">
					<button type="submit" role="menuitem" class="switcher-item switcher-danger">
						@icon("log-out")
						<span class="flex-1">Sign out</span>
					</button>
				</form>
				// Separate from Sign out on purpose: it ends sessions on every
				// other browser too, which is a bigger thing than leaving here,
				// and the two should not be one slip apart.
				<form method="post" action="/sign-out-everywhere" role="none">
					<button type="submit" role="menuitem" class="switcher-item switcher-quiet">
						<span class="size-4 shrink-0"></span>
						<span class="flex-1">Sign out everywhere</span>
					</button>
				</form>
			}
		</div>
	</details>
}

// palette is the command palette: every page the sidebar offers, the team's
// projects and apps, and a few actions, behind ⌘K.
//
// A native modal dialog, so the page behind it is inert and Escape closes it
// without a line of script; palette.js adds the searching. The pages come from
// the sidebar's own links rather than a second list, so a wrapping
// application's navigation is searchable the moment it is drawn.
//
// The actions are declared here rather than in the script so the server
// decides what is offered, and a test can read the list.
templ palette(index string) {
	<dialog
		id="palette"
		class="palette"
		aria-label="Search and commands"
		data-palette
		data-index={ index }
	>
		<div class="palette-bar">
			@icon("search")
			<span class="palette-scope" data-palette-scope hidden></span>
			<input
				type="text"
				class="palette-input"
				role="combobox"
				aria-expanded="true"
				aria-controls="palette-list"
				aria-autocomplete="list"
				aria-label="Search pages, projects, apps and actions"
				placeholder="Search pages, projects, apps…"
				autocomplete="off"
				spellcheck="false"
				data-palette-input
			/>
			<kbd class="kbd">esc</kbd>
		</div>
		<div id="palette-list" class="palette-list" role="listbox" aria-label="Results" data-palette-list></div>
		<div class="palette-foot" aria-hidden="true">
			<span><kbd class="kbd">↑</kbd><kbd class="kbd">↓</kbd> to move</span>
			<span><kbd class="kbd">↵</kbd> to open</span>
			<span><kbd class="kbd">esc</kbd> to close</span>
		</div>
		<div hidden>
			<i data-palette-action data-label="Deploy an app" data-url="/apps/new" data-icon="rocket" data-keywords="new create service image repository"></i>
			<i data-palette-action data-label="New project" data-url="/projects?new=1" data-icon="plus" data-keywords="create canvas"></i>
			<i data-palette-action data-label="Add a custom domain…" data-pick="app" data-url="/apps/{name}/domains" data-needs="domains" data-icon="globe" data-keywords="dns hostname certificate"></i>
			<i data-palette-action data-label="Toggle theme" data-run="theme" data-icon="sun-moon" data-keywords="dark light mode appearance"></i>
			for _, name := range paletteIcons {
				<template data-palette-icon={ name }>
					@icon(name)
				</template>
			}
		</div>
	</dialog>
}

templ topbar(s Slots) {
	<header class="topbar">
		@sidebarToggle()
		<span class="topbar-sep" aria-hidden="true"></span>
		<nav class="crumbs" aria-label="Breadcrumb">
			<ol class="flex min-w-0 items-center gap-1.5">
				for i, crumb := range s.Breadcrumb {
					if i > 0 {
						<li class="crumb-sep" aria-hidden="true">/</li>
					}
					<li class="min-w-0">
						if crumb.Href != "" {
							<a href={ templ.URL(crumb.Href) } class="crumb">{ crumb.Label }</a>
						} else {
							<span class="crumb crumb-current" aria-current="page">{ crumb.Label }</span>
						}
					</li>
				}
			</ol>
		</nav>
		<div class="flex-1"></div>
		if s.HeaderTools != nil {
			<div class="flex items-center gap-2">
				@slot(s.HeaderTools)
			</div>
		}
	</header>
}

// themeScript resolves the theme before first paint.
//
// Inline and synchronous on purpose. Applying the class from a deferred script
// or after DOMContentLoaded means a dark-mode user sees a white flash on every
// navigation, which looks broken however good the rest of the page is.
templ themeScript() {
	<script nonce="">
		(function() {
			try {
				var stored = localStorage.getItem("yacht-theme");
				var dark = stored
					? stored === "dark"
					: window.matchMedia("(prefers-color-scheme: dark)").matches;
				document.documentElement.classList.toggle("dark", dark);
			} catch (e) {
				/* Private browsing can throw on localStorage. The OS preference
				   is a fine fallback and a broken toggle must not break the page. */
			}
		})();
	</script>
}

// sidebarToggle collapses the sidebar to its icon rail and back.
//
// It lives in the top bar rather than in the sidebar because it has to be in
// the same place in both states: a control that moves when you use it is one
// you have to find again every time. Hidden below md, where there is no
// sidebar to collapse.
templ sidebarToggle() {
	<button
		type="button"
		class="btn btn-ghost btn-icon -ml-2"
		aria-label="Toggle sidebar"
		aria-controls="sidebar"
		aria-expanded="true"
		data-sidebar-toggle
		onclick="yachtSidebarToggle()"
	>
		@icon("panel-left")
	</button>
}

// sidebarScript resolves the collapsed state before first paint.
//
// Inline and synchronous for the same reason as themeScript: applying the
// attribute after DOMContentLoaded means anyone who keeps the sidebar
// collapsed watches it snap shut on every navigation.
//
// Setting the attribute before the aside exists also means the width
// transition never runs on load — it animates when someone presses the
// button, and not when a page arrives already collapsed.
templ sidebarScript() {
	<script nonce="">
		(function() {
			var root = document.documentElement;
			var previousFocus = null;
			function drawer() { return document.getElementById("sidebar"); }
			function shell() { return document.querySelector("[data-app-shell]"); }
			function setDrawerInert(open) {
				var content = shell();
				if (content) content.inert = open;
			}
			function focusDrawer() {
				var panel = drawer();
				if (!panel) return;
				var target = panel.querySelector("a, button, summary, input, select, textarea, [tabindex]:not([tabindex='-1'])");
				if (target) target.focus();
			}
			function trapFocus(event) {
				if (event.key !== "Tab" || !onPhone() || root.getAttribute("data-nav") !== "open") return;
				var panel = drawer();
				var focusable = panel ? panel.querySelectorAll("a, button, summary, input, select, textarea, [tabindex]:not([tabindex='-1'])") : [];
				if (!focusable.length) return;
				var first = focusable[0], last = focusable[focusable.length - 1];
				if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
				else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
			}
			try {
				if (localStorage.getItem("yacht-sidebar") === "collapsed") {
					root.setAttribute("data-sidebar", "collapsed");
				}
			} catch (e) {
				/* Private browsing can throw on localStorage. An expanded
				   sidebar is the right fallback and a broken toggle must not
				   break the page. */
			}
			function sync() {
				var open = onPhone()
					? root.getAttribute("data-nav") === "open"
					: root.getAttribute("data-sidebar") !== "collapsed";
				var buttons = document.querySelectorAll("[data-sidebar-toggle]");
				for (var i = 0; i < buttons.length; i++) {
					buttons[i].setAttribute("aria-expanded", open ? "true" : "false");
				}
			}
			/* Below md the same button opens a drawer instead of collapsing a
			   rail, because there is no room beside the page for a rail and no
			   other way to reach another page.

			   The drawer state is deliberately not stored. Every link here is a
			   full page load, so a drawer that remembered being open would
			   reopen itself over whatever you had just navigated to. The rail's
			   collapsed state is stored for the opposite reason: it is where you
			   left the furniture, not a thing you are in the middle of. */
			function onPhone() {
				return !window.matchMedia("(min-width: 768px)").matches;
			}

			window.yachtSidebarToggle = function() {
				if (onPhone()) {
					var open = root.getAttribute("data-nav") === "open";
					root.setAttribute("data-nav", open ? "closed" : "open");
					setDrawerInert(!open);
					if (!open) {
						previousFocus = document.activeElement;
						window.requestAnimationFrame(focusDrawer);
					} else if (previousFocus) {
						previousFocus.focus();
					}
					sync();
					return;
				}
				var collapsed = root.getAttribute("data-sidebar") === "collapsed";
				root.setAttribute("data-sidebar", collapsed ? "expanded" : "collapsed");
				try {
					localStorage.setItem(
						"yacht-sidebar",
						collapsed ? "expanded" : "collapsed"
					);
				} catch (e) {}
				sync();
			};
			/* Escape closes the drawer. It covers the page, so the usual way
			   out of something covering the page has to work. */
			document.addEventListener("keydown", function(event) {
				/* Already answered — by a menu inside the drawer closing. */
				if (event.defaultPrevented) return;
				if (
					event.key === "Escape" &&
					root.getAttribute("data-nav") === "open"
				) {
					root.setAttribute("data-nav", "closed");
					setDrawerInert(false);
					if (previousFocus) previousFocus.focus();
					sync();
				}
			});
			document.addEventListener("keydown", trapFocus);

			/* The button does not exist yet at this point in the head, so the
			   state it advertises is corrected once the body has parsed. On a
			   phone that correction matters: the markup says expanded, and the
			   drawer starts shut. */
			document.addEventListener("DOMContentLoaded", sync);
		})();
	</script>
}

templ confirmationDialog() {
	<dialog class="confirm-dialog" data-confirm-dialog aria-labelledby="confirm-title" aria-describedby="confirm-description">
		<div class="flex flex-col gap-2">
			<h2 id="confirm-title" class="text-[16px] font-semibold tracking-tight">Confirm action</h2>
			<p id="confirm-description" class="text-[12.5px] text-muted-foreground"></p>
		</div>
		<div class="mt-5 flex flex-col-reverse gap-2 sm:flex-row sm:justify-end">
			<button class="btn" type="button" data-confirm-cancel>Cancel</button>
			<button class="btn btn-danger" type="button" data-confirm-submit>Confirm</button>
		</div>
	</dialog>
	<script nonce="">
		(function() {
			var dialog, pendingForm, pendingSubmitter, trigger;
			function closeDialog() { if (dialog && dialog.open) dialog.close(); }
			document.addEventListener("DOMContentLoaded", function() {
				dialog = document.querySelector("[data-confirm-dialog]");
				if (!dialog) return;
				document.addEventListener("submit", function(event) {
					var form = event.target;
					var source = form.matches("form[data-confirm]") ? form : event.submitter;
					if (!source || !source.matches("[data-confirm]") || form.dataset.confirmed === "true") return;
					event.preventDefault();
					pendingForm = form;
					pendingSubmitter = event.submitter;
					trigger = document.activeElement;
					dialog.querySelector("#confirm-title").textContent = source.dataset.confirmTitle || "Confirm action";
					dialog.querySelector("#confirm-description").textContent = source.dataset.confirm;
					dialog.querySelector("[data-confirm-submit]").textContent = source.dataset.confirmLabel || "Confirm";
					dialog.showModal();
					dialog.querySelector("[data-confirm-cancel]").focus();
				});
				dialog.querySelector("[data-confirm-cancel]").addEventListener("click", closeDialog);
				dialog.querySelector("[data-confirm-submit]").addEventListener("click", function() {
					if (!pendingForm) return;
					pendingForm.dataset.confirmed = "true";
					closeDialog();
					pendingForm.requestSubmit(pendingSubmitter || undefined);
				});
				dialog.addEventListener("close", function() {
					if (pendingForm) delete pendingForm.dataset.confirmed;
					pendingForm = null;
					pendingSubmitter = null;
					if (trigger) trigger.focus();
				});
			});
		})();
	</script>
}

// icon renders one of a small fixed set of inline glyphs.
//
// The paths are Lucide (ISC licensed), copied in rather than pulled from a
// package. Inline SVG rather than an icon font or a sprite request: the set is
// tiny, and a self-hosted dashboard should not need a second network round trip
// to draw its own navigation. Copying also means only the dozen icons actually
// used are carried, instead of the whole set for the sake of twelve.
//
// Lucide's own names are kept where they match. Where this dashboard's word is
// clearer in context — "disk" for hard-drive, "storage" for database — the
// mapping is here and nowhere else, so a name in a template does not have to be
// translated to find the drawing.
templ icon(name string) {
	<svg
		class="size-4 shrink-0 opacity-70"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		aria-hidden="true"
	>
		switch name {
			case "grid":
				<rect width="7" height="7" x="3" y="3" rx="1"></rect>
				<rect width="7" height="7" x="14" y="3" rx="1"></rect>
				<rect width="7" height="7" x="14" y="14" rx="1"></rect>
				<rect width="7" height="7" x="3" y="14" rx="1"></rect>
			case "boxes":
				<path d="M2.97 12.92A2 2 0 0 0 2 14.63v3.24a2 2 0 0 0 .97 1.71l3 1.8a2 2 0 0 0 2.06 0L12 19v-5.5l-5-3-4.03 2.42Z"></path>
				<path d="m7 16.5-4.74-2.85"></path>
				<path d="m7 16.5 5-3"></path>
				<path d="M7 16.5v5.17"></path>
				<path d="M12 13.5V19l3.97 2.38a2 2 0 0 0 2.06 0l3-1.8a2 2 0 0 0 .97-1.71v-3.24a2 2 0 0 0-.97-1.71L17 10.5l-5 3Z"></path>
				<path d="m17 16.5-5-3"></path>
				<path d="m17 16.5 4.74-2.85"></path>
				<path d="M17 16.5v5.17"></path>
				<path d="M7.97 4.42A2 2 0 0 0 7 6.13v4.37l5 3 5-3V6.13a2 2 0 0 0-.97-1.71l-3-1.8a2 2 0 0 0-2.06 0l-3 1.8Z"></path>
				<path d="M12 8 7.26 5.15"></path>
				<path d="m12 8 4.74-2.85"></path>
				<path d="M12 13.5V8"></path>
			case "maximize":
				<path d="M8 3H5a2 2 0 0 0-2 2v3"></path>
				<path d="M21 8V5a2 2 0 0 0-2-2h-3"></path>
				<path d="M3 16v3a2 2 0 0 0 2 2h3"></path>
				<path d="M16 21h3a2 2 0 0 0 2-2v-3"></path>
			case "plus":
				<path d="M5 12h14"></path>
				<path d="M12 5v14"></path>
			case "minus":
				<path d="M5 12h14"></path>
			case "box":
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "lock":
				<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
			case "lock-open":
				<rect width="18" height="11" x="3" y="11" rx="2" ry="2"></rect>
				<path d="M7 11V7a5 5 0 0 1 9.9-1"></path>
			case "globe":
				<circle cx="12" cy="12" r="10"></circle>
				<path d="M12 2a14.5 14.5 0 0 0 0 20 14.5 14.5 0 0 0 0-20"></path>
				<path d="M2 12h20"></path>
			case "package":
				<path d="m7.5 4.27 9 5.15"></path>
				<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
				<path d="m3.3 7 8.7 5 8.7-5"></path>
				<path d="M12 22V12"></path>
			case "server":
				<rect width="20" height="8" x="2" y="2" rx="2" ry="2"></rect>
				<rect width="20" height="8" x="2" y="14" rx="2" ry="2"></rect>
				<line x1="6" x2="6.01" y1="6" y2="6"></line>
				<line x1="6" x2="6.01" y1="18" y2="18"></line>
			case "cpu":
				<rect width="16" height="16" x="4" y="4" rx="2"></rect>
				<rect width="6" height="6" x="9" y="9" rx="1"></rect>
				<path d="M15 2v2"></path>
				<path d="M15 20v2"></path>
				<path d="M2 15h2"></path>
				<path d="M2 9h2"></path>
				<path d="M20 15h2"></path>
				<path d="M20 9h2"></path>
				<path d="M9 2v2"></path>
				<path d="M9 20v2"></path>
			case "layers":
				<path d="M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z"></path>
				<path d="M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12"></path>
				<path d="M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17"></path>
			case "rocket":
				<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.71-.84.7-2.13-.09-2.91a2.18 2.18 0 0 0-2.91-.09z"></path>
				<path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.88 12.88 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.35 22.35 0 0 1-4 2z"></path>
				<path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"></path>
				<path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"></path>
			case "disk":
				<line x1="22" x2="2" y1="12" y2="12"></line>
				<path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"></path>
				<line x1="6" x2="6.01" y1="16" y2="16"></line>
				<line x1="10" x2="10.01" y1="16" y2="16"></line>
			case "storage":
				<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse>
				<path d="M3 5V19A9 3 0 0 0 21 19V5"></path>
				<path d="M3 12A9 3 0 0 0 21 12"></path>
			case "grip":
				<circle cx="9" cy="12" r="1"></circle>
				<circle cx="9" cy="5" r="1"></circle>
				<circle cx="9" cy="19" r="1"></circle>
				<circle cx="15" cy="12" r="1"></circle>
				<circle cx="15" cy="5" r="1"></circle>
				<circle cx="15" cy="19" r="1"></circle>
			case "activity":
				<path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"></path>
			case "external":
				<path d="M15 3h6v6"></path>
				<path d="M10 14 21 3"></path>
				<path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
			case "panel-left":
				<rect width="18" height="18" x="3" y="3" rx="2"></rect>
				<path d="M9 3v18"></path>
			case "log-out":
				<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
				<polyline points="16 17 21 12 16 7"></polyline>
				<line x1="21" x2="9" y1="12" y2="12"></line>
			case "users":
				<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
