package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"

	"github.com/codeblocktz/yacht/internal/web/ui/popover"
)

// WorkspaceHome is the workspace's home, Railway's Projects page: every
// project as a small canvas of what it runs, searchable, in a grid or a
// list.
templ WorkspaceHome(d WorkspaceHomeData) {
	<div class="ws-home">
		<div class="ws-home-head">
			<h1 class="page-title">Projects</h1>
			<div class="flex items-center gap-2">
				<form method="get" action="/" class="ws-search" role="search">
					@icon("search")
					<input
						type="search"
						name="q"
						value={ d.Query }
						placeholder="Search projects…"
						aria-label="Search projects"
						autocomplete="off"
						hx-get="/"
						hx-trigger="input changed delay:150ms, search"
						hx-target="#project-grid"
						hx-select="#project-grid"
						hx-swap="outerHTML"
						hx-push-url="true"
						hx-include="next [name='sort'], next [name='view']"
					/>
					<input type="hidden" name="sort" value={ d.Sort }/>
					<input type="hidden" name="view" value={ d.View }/>
				</form>
				@newProjectMenu(d)
			</div>
		</div>
		if d.Checklist != nil {
			@checklist(*d.Checklist)
		}
		if d.Error != "" {
			<div class="callout callout-err mb-5">
				<div class="min-w-0">
					<div class="font-medium">Could not create that project</div>
					<p class="mt-0.5 text-muted-foreground">{ d.Error }</p>
				</div>
			</div>
		}
		<div class="ws-home-bar">
			<span class="flex items-center gap-1.5">
				@icon("grid")
				{ plural(d.Total, "Project") }
			</span>
			<span class="ws-home-sep" aria-hidden="true"></span>
			<span class="flex items-center gap-1">
				Sort by:
				if d.Sort == sortName {
					<a class="ws-home-link" href={ templ.SafeURL(homeHref(d, "sort", sortRecent)) }>Name</a>
				} else {
					<a class="ws-home-link" href={ templ.SafeURL(homeHref(d, "sort", sortName)) }>Recent activity</a>
				}
			</span>
			<span class="flex-1"></span>
			<div class="seg" role="radiogroup" aria-label="View">
				<a class="seg-item" role="radio" aria-checked={ boolAttr(d.View == viewGrid) } aria-label="Grid" href={ templ.SafeURL(homeHref(d, "view", viewGrid)) }>
					@icon("grid")
				</a>
				<a class="seg-item" role="radio" aria-checked={ boolAttr(d.View == viewList) } aria-label="List" href={ templ.SafeURL(homeHref(d, "view", viewList)) }>
					@icon("list")
				</a>
			</div>
		</div>
		<div id="project-grid" class={ templ.KV("project-grid", d.View == viewGrid), templ.KV("project-list", d.View == viewList) }>
			if len(d.Cards) == 0 {
				<div class="panel col-span-full">
					<div class="empty">
						if d.Query != "" {
							<p class="font-medium text-foreground">No project matches “{ d.Query }”</p>
							<p><a class="underline hover:text-foreground" href="/">Show every project</a></p>
						} else {
							<p class="font-medium text-foreground">No projects yet</p>
							<p>A project is one canvas: the services that make up a system, and what connects them.</p>
							<form method="post" action="/projects" class="mt-3 flex items-center justify-center gap-2">
								<input class="control h-8 w-[200px]" name="name" placeholder="My project" aria-label="Project name" required/>
								<button class="btn btn-primary btn-sm" type="submit">Create project</button>
							</form>
							@productNote(d.Note)
						}
					</div>
				</div>
			}
			for _, c := range d.Cards {
				if d.View == viewList {
					@projectListRow(c)
				} else {
					@projectCard(c)
				}
			}
		</div>
	</div>
}

// newProjectMenu is the page's New: a project by name, or a template that
// arrives as one.
templ newProjectMenu(d WorkspaceHomeData) {
	@popover.Root() {
		@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeClick}) {
			<button type="button" class="btn btn-primary">
				@icon("plus")
				New
			</button>
		}
		@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Exclusive: true}) {
			<div class="flex w-[260px] flex-col gap-2 p-3">
				<form method="post" action="/projects" class="flex flex-col gap-2">
					<label class="text-[12px] font-medium text-muted-foreground" for="new-project">Empty project</label>
					<input id="new-project" class="control h-8" name="name" placeholder="Project name" required autofocus?={ d.Focus }/>
					<button class="btn btn-primary btn-sm" type="submit">Create project</button>
				</form>
				if d.Templates {
					<div class="menu-sep" role="separator"></div>
					<a class="switcher-item" href="/templates">
						@icon("layers")
						<span class="flex-1">From a template</span>
					</a>
				}
			</div>
		}
	}
}

// projectCard is Railway's project card: the name, a small canvas of the
// production services, and how many of them are up.
templ projectCard(c ProjectCard) {
	<a class="project-card" href={ templ.SafeURL("/projects/" + c.Project.Slug) }>
		<span class="project-card-head">
			<span class="truncate">{ c.Project.Name }</span>
		</span>
		<span class="project-card-canvas">
			if len(c.Services) > 0 {
				<span class="project-card-icons">
					for _, a := range c.Services {
						<span class="project-card-icon" title={ a.ServiceName() }>
							@projectServiceMark(a)
						</span>
					}
					if c.More > 0 {
						<span class="project-card-icon text-[12px] text-muted-foreground">+{ strconv.Itoa(c.More) }</span>
					}
				</span>
			}
			<span class="project-card-foot">
				<span class={ "card-status-dot", projectsDot(c) } aria-hidden="true"></span>
				{ projectsSummary(c) }
			</span>
		</span>
	</a>
}

// projectListRow is a project in the list view.
templ projectListRow(c ProjectCard) {
	<a class="project-row" href={ templ.SafeURL("/projects/" + c.Project.Slug) }>
		<span class="min-w-0 flex-1 truncate font-medium">{ c.Project.Name }</span>
		<span class="project-row-icons">
			for _, a := range c.Services {
				<span class="project-card-icon project-card-icon-sm" title={ a.ServiceName() }>
					@projectServiceMark(a)
				</span>
			}
			if c.More > 0 {
				<span class="text-[12px] text-muted-foreground">+{ strconv.Itoa(c.More) }</span>
			}
		</span>
		<span class="flex w-[220px] items-center gap-1.5 text-[12px] text-muted-foreground">
			<span class={ "card-status-dot", projectsDot(c) } aria-hidden="true"></span>
			{ projectsSummary(c) }
		</span>
	</a>
}

templ projectServiceMark(a app.App) {
	if _, ok := engineLogos[a.Source]; ok {
		@engineMark(a.Source)
	} else {
		@icon(serviceMarkIcon(a))
	}
}
