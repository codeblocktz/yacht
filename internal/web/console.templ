package web

import "github.com/codeblocktz/yacht/internal/web/ui/selectbox"

// appConsole is the Console tab: a shell in one of the app's running
// containers, drawn by xterm.js and fed over a WebSocket.
//
// The cases where no shell can open are said here, on the page, rather than
// left to the socket to refuse. A refusal over a socket can only be shown once
// the terminal has drawn and connected, which is a black box flashing up to
// say the thing the page already knew.
templ appConsole(d AppDetailData) {
	{{ v := consoleViewFrom(ctx) }}
	{{ pods := consolePods(d) }}
	{{ pod := consolePod(d, pods, v.Pod) }}
	if !v.On {
		<div class="panel">
			<div class="empty">
				<p class="font-medium text-foreground">No console on this install</p>
				<p>This install cannot open a shell in a container.</p>
			</div>
		</div>
	} else if d.App.Sleep.Asleep() {
		<div class="panel">
			<div class="empty">
				<p class="font-medium text-foreground">Asleep</p>
				<p>
					A sleeping app runs no containers, so there is nothing to open a
					shell in. Wake it first.
				</p>
				if d.Sleep != nil {
					<form class="mt-3" method="post" action={ templ.URL("/apps/" + d.App.Name + "/wake") }>
						<button class="btn btn-sm" type="submit">Wake now</button>
					</form>
				}
			</div>
		</div>
	} else if pod == "" {
		<div class="panel">
			<div class="empty">
				<p class="font-medium text-foreground">Nothing running</p>
				<p>
					A console opens in a running container, and this app has none.
					Deploy it or scale it up first.
				</p>
			</div>
		</div>
	} else {
		<div
			class="console"
			data-console
			data-console-url={ "/apps/" + d.App.Name + "/console/ws" }
			data-console-pod={ pod }
		>
			<div class="console-bar">
				<span class="console-status" data-console-status data-state="connecting">Connecting</span>
				if len(pods) > 1 {
					// A pod is chosen by opening the tab again for it. Changing
					// replica is a new shell either way, and a link is what
					// works before the script has run and after it has failed.
					<form method="get" action={ templ.URL("/apps/" + d.App.Name + "/console") } class="console-picker">
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "console-pod", Name: "pod", Class: "h-7 min-w-[200px]"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose a replica"})
							}
							@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Filter replicas"}) {
								for _, p := range pods {
									@selectbox.Item(selectbox.ItemProps{Value: p, Selected: p == pod}) {
										{ p }
									}
								}
							}
						}
						<button class="btn btn-sm" type="submit">Open</button>
					</form>
				} else {
					<span class="mono console-pod" data-console-pod-label>{ pod }</span>
				}
				<span class="flex-1"></span>
				<button class="btn btn-sm" type="button" data-console-reconnect hidden>Reconnect</button>
				<button class="btn btn-sm" type="button" data-console-fullscreen title="Full screen">
					@icon("maximize")
					<span data-console-fullscreen-label>Full screen</span>
				</button>
			</div>
			<div class="console-screen" data-console-screen></div>
			<p class="console-note" data-console-note hidden></p>
			<noscript>
				<p class="console-note">The console is a terminal drawn in the browser, and needs JavaScript.</p>
			</noscript>
		</div>
		if SurfacesFromContext(ctx).Operator {
			// What datahuru has in place of an SSH command. There is no SSH
			// gateway into a container, so this is the equivalent for the
			// people who hold the cluster's own credentials — and only them,
			// because a command nobody else can run is a command that says
			// the console is broken.
			{{ cmd := kubectlExec(d, pod) }}
			<div class="panel mt-4">
				<div class="panel-header">
					<span class="panel-title">From a terminal</span>
				</div>
				<div class="panel-body">
					<div class="record">
						<div class="record-row">
							<span class="record-v">{ cmd }</span>
							@copyButton(cmd, "kubectl command")
						</div>
					</div>
					<p class="hint mt-2">
						With the cluster's kubeconfig. Shown to the install's operators only.
					</p>
				</div>
			</div>
		}
		<p class="hint mt-3">
			The shell runs as the app's own user, inside the same restrictions as
			the app: it can do nothing the app could not. It closes after
			{ consoleLimitLabel(defaultConsoleLimits.Idle) } without input, and after
			{ consoleLimitLabel(defaultConsoleLimits.Max) } whatever happens. Who opened it, and
			when, is recorded; what is typed is not.
		</p>
		// Only on this tab. A terminal emulator is the largest script the
		// dashboard has, and no other page draws one.
		<link rel="stylesheet" href={ asset("/assets/css/xterm.css") }/>
		<script src={ asset("/assets/js/xterm.js") } defer></script>
		<script src={ asset("/assets/js/addon-fit.js") } defer></script>
		<script src={ asset("/assets/js/console.js") } defer></script>
	}
}
