package web

import (
	"fmt"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/orchestrator"
)

// ---------------------------------------------------------------- shared
templ pageHead(title, subtitle string, actions templ.Component) {
	<div class="mb-5 flex flex-wrap items-start justify-between gap-4">
		<div class="min-w-0">
			<h1 class="text-[19px] font-semibold tracking-tight">{ title }</h1>
			if subtitle != "" {
				<p class="mt-0.5 text-[12.5px] text-muted-foreground">{ subtitle }</p>
			}
		</div>
		if actions != nil {
			<div class="flex flex-wrap items-center gap-2">
				@actions
			</div>
		}
	</div>
}

templ statusDot(label, class string) {
	<span class={ "status", class }>{ label }</span>
}

templ meter(percent int, class string) {
	<div class={ "meter", class }>
		<i style={ fmt.Sprintf("width:%d%%", clampPercent(percent)) }></i>
	</div>
}

templ metric(label, value, sub string) {
	<div class="metric">
		<div class="metric-k">{ label }</div>
		<div class="metric-v">{ value }</div>
		if sub != "" {
			<div class="metric-sub">{ sub }</div>
		}
	</div>
}

templ metricUsage(label string, percent int, known bool, detail string) {
	<div class="metric">
		<div class="metric-k">{ label }</div>
		if known {
			<div class="metric-v">{ strconv.Itoa(percent) }%</div>
			@meter(percent, meterClass(percent))
			if detail != "" {
				<div class="metric-sub">{ detail }</div>
			}
		} else {
			<div class="metric-v text-muted-foreground/50">&mdash;</div>
			<div class="metric-sub">no metrics-server</div>
		}
	</div>
}

templ clusterCallout(msg string) {
	<div class="callout callout-err mb-5">
		<div class="min-w-0">
			<div class="font-medium">Cluster unreachable</div>
			<p class="mt-0.5 text-muted-foreground">
				Records below come from the database. Live status is unavailable until
				the cluster answers.
			</p>
			if msg != "" {
				<p class="mono mt-1.5 break-all text-muted-foreground">{ msg }</p>
			}
		</div>
	</div>
}

// ---------------------------------------------------------------- overview

type OverviewData struct {
	OwnerName    string
	ClusterOK    bool
	ClusterError string
	AppCount     int64
	Summary      orchestrator.ClusterSummary
	Apps         []app.App

	// Activity is deploys per day. Zero days means the chart is not shown at
	// all, which is the state an install has before it can read its own
	// history — not the same as a window that genuinely had no deploys.
	Activity app.DeployActivity
}

templ Overview(d OverviewData) {
	@pageHead("Overview", "Signed in as "+d.OwnerName, deployButton())
	if !d.ClusterOK {
		@clusterCallout(d.ClusterError)
	}
	<div class="metrics mb-6">
		@metric("Apps", strconv.FormatInt(d.AppCount, 10), "")
		@metric("Nodes", strconv.Itoa(d.Summary.Nodes),
			fmt.Sprintf("%d ready", d.Summary.NodesReady))
		@metric("Pods", strconv.Itoa(d.Summary.Pods), podCapacityLabel(d.Summary))
		@metricUsage("CPU", d.Summary.CPUPercent(), d.Summary.UsageKnown,
			clusterCPUDetail(d.Summary))
		@metricUsage("Memory", d.Summary.MemoryPercent(), d.Summary.UsageKnown,
			clusterMemDetail(d.Summary))
	</div>
	if len(d.Activity.Days) > 0 {
		@deployActivity(d.Activity)
	}
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">Apps</span>
			<a href="/apps" class="text-[12px] text-muted-foreground hover:text-foreground">
				View all
			</a>
		</div>
		if len(d.Apps) == 0 {
			@emptyApps()
		} else {
			@appRows(d.Apps)
		}
	</div>
}

// deployActivity is deploys per day, stacked by how they ended.
//
// A window with no deploys still draws its axis and says so, rather than
// disappearing: an empty chart is information on an install that expected to be
// shipping, and a panel that vanishes is not.
templ deployActivity(a app.DeployActivity) {
	<div class="panel mb-6">
		<div class="panel-header">
			<span class="panel-title">Deploy activity</span>
			<span class="text-muted-foreground tabular-nums">
				{ plural(a.Total(), "deploy") } in { deployWindowLabel(a) }
			</span>
		</div>
		if a.Total() == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">Nothing deployed yet</p>
				<p>Deploys from the last { deployWindowLabel(a) } appear here.</p>
			</div>
		} else {
			<div class="chart">
				<div class="chart-plot" role="img" aria-label={ deployChartLabel(a) }>
					for _, day := range a.Days {
						<div class="chart-day" title={ deployDayTitle(day) }>
							<div class="chart-col" style={ deployColumnStyle(day, deployMax(a)) }>
								// Ordered worst-last so failures sit at the top of a
								// column, where the eye lands, rather than buried
								// under a stack of successes.
								<div
									class="chart-seg chart-seg-ok"
									style={ deploySegmentStyle(day.Succeeded, day.Total()) }
								></div>
								<div
									class="chart-seg chart-seg-idle"
									style={ deploySegmentStyle(day.Cancelled, day.Total()) }
								></div>
								<div
									class="chart-seg chart-seg-run"
									style={ deploySegmentStyle(day.Running, day.Total()) }
								></div>
								<div
									class="chart-seg chart-seg-err"
									style={ deploySegmentStyle(day.Failed, day.Total()) }
								></div>
							</div>
						</div>
					}
				</div>
				<div class="chart-axis">
					<span>{ deployAxisLabel(a.Days[0].Day) }</span>
					<span>{ deployAxisLabel(a.Days[len(a.Days)-1].Day) }</span>
				</div>
				@deployLegend(a)
			</div>
		}
	</div>
}

// deployLegend names only the outcomes present.
//
// A key with three entries that are always zero teaches the reader to stop
// reading the key.
templ deployLegend(a app.DeployActivity) {
	<div class="chart-legend">
		if a.Succeeded > 0 {
			@legendItem("chart-seg-ok", "Succeeded", a.Succeeded)
		}
		if a.Failed > 0 {
			@legendItem("chart-seg-err", "Failed", a.Failed)
		}
		if a.Running > 0 {
			@legendItem("chart-seg-run", "In flight", a.Running)
		}
		if a.Cancelled > 0 {
			@legendItem("chart-seg-idle", "Cancelled", a.Cancelled)
		}
	</div>
}

templ legendItem(class, label string, n int) {
	<span class="chart-key">
		<span class={ "chart-dot", class }></span>
		{ label }
		<span class="tabular-nums text-muted-foreground">{ strconv.Itoa(n) }</span>
	</span>
}

templ deployButton() {
	<a class="btn btn-primary" href="/apps/new">Deploy app</a>
}

templ emptyApps() {
	<div class="empty">
		<p class="font-medium text-foreground">No apps yet</p>
		<p>Deploy a container image to get started.</p>
		<a class="btn btn-primary mt-3" href="/apps/new">Deploy app</a>
	</div>
}

// ---------------------------------------------------------------- apps list
templ AppList(apps []app.App) {
	@pageHead("Apps", "Workloads managed by this install.", deployButton())
	<div class="panel">
		if len(apps) == 0 {
			@emptyApps()
		} else {
			@appRows(apps)
		}
	</div>
}

// appRows is the dense list that replaced a grid of cards.
//
// One row per workload, aligned columns, a single border between them. At ten
// apps a card grid is already unreadable; a list stays scannable at a hundred.
templ appRows(apps []app.App) {
	<div class="rows">
		for _, a := range apps {
			// The row is a link and the menu is its sibling, not its child.
			// A form or a second anchor inside an anchor is markup a browser is
			// free to rearrange — the same reason the hostname below is plain
			// text rather than a link to itself.
			<div class="row-item !gap-0 !p-0">
				<a href={ templ.URL("/apps/" + a.Name) } class="row-link min-w-0 flex-1">
				<span class="text-muted-foreground">
					@icon("box")
				</span>
				<span class="min-w-0 flex-1">
					<span class="block truncate font-medium">{ a.Name }</span>
					<span class={ "mono block truncate text-muted-foreground", templ.KV("italic", imageIsPending(a.Image)) }>{ imageLabel(a.Image) }</span>
				</span>
				// Plain text rather than an anchor: the whole row is already a
				// link, and an anchor inside an anchor is markup a browser is
				// free to rearrange. The clickable URL lives on the detail page.
				if a.Host != "" {
					<span class="mono hidden max-w-[260px] shrink-0 truncate text-[12px] text-muted-foreground lg:block">
						{ a.Host }
					</span>
				}
			<span class="hidden w-24 shrink-0 text-right text-[12px] text-muted-foreground tabular-nums sm:block">
					{ replicaLabel(a) }
				</span>
				// A failed deploy is not the same question as a failed workload,
				// and the list only ever asked the second. The previous version
				// keeps running, so the app stays green while the change
				// somebody made never took — which is exactly the deploy worth
				// finding, and the only way to find it was to open each app.
				if a.LastDeploy == app.DeployFailed {
					<span class="status status-err shrink-0" title="The last deploy failed. The previous version is still running.">
						deploy failed
					</span>
				}
					<span class="w-24 shrink-0 text-right">
						@appStatus(a)
					</span>
				</a>
				<div class="shrink-0 pr-2">
					@rowActions(a)
				</div>
			</div>
		}
	</div>
}

templ appStatus(a app.App) {
	if !a.StatusKnown {
		@statusDot("unknown", "status-neutral")
	} else {
		@statusDot(string(a.Status.Phase), phaseClass(string(a.Status.Phase)))
	}
}

// ---------------------------------------------------------------- app detail

type AppDetailData struct {
	App         app.App
	Siblings    []app.App
	Tab         string
	Pods        []orchestrator.PodInfo
	Deployments []app.Deployment
	BaseURL     string

	// Net is the app's routing. Loaded alongside the rest rather than on its
	// own page: a panel nothing links to is a panel nobody finds, which is
	// exactly what happened the first time.
	Net app.Networking

	// ResolverName is which resolver answered the last domain check, so the
	// page can attribute what it reports rather than stating it as fact.
	ResolverName string

	// The resource tracks, with ceilings taken from the cluster's largest
	// node — what a single pod can actually be scheduled onto.
	CPULimit      ResourceSlider
	MemoryLimit   ResourceSlider
	CPURequest    ResourceSlider
	MemoryRequest ResourceSlider

	// RepoError is why the connected repository could not be read, shown on
	// the source card. A private repo, a typo and an outage all land here.
	RepoError string

	Notice string

	// Error is a refusal from the action that produced this render, shown with
	// the form that caused it rather than carried through a redirect.
	Error string
}

// AppDetail is the Railway-shaped view: a rail of every app on the left so you
// can move between them without going back to a list, and a tabbed pane on the
// right for the one you are looking at.
templ AppDetail(d AppDetailData) {
	<div class="flex flex-col gap-6 lg:flex-row">
		@appRail(d)
		@appMobileSwitcher(d)
		<div class="min-w-0 flex-1">
			@appDetailHeader(d.App)
			<nav class="tabs mb-5">
				@appTab(d.App.Name, d.Tab, "", "Deployments")
				@appTab(d.App.Name, d.Tab, "variables", "Variables")
				@appTab(d.App.Name, d.Tab, "metrics", "Metrics")
				@appTab(d.App.Name, d.Tab, "storage", "Storage")
				@appTab(d.App.Name, d.Tab, "domains", "Domains")
				@appTab(d.App.Name, d.Tab, "settings", "Settings")
			</nav>
			switch d.Tab {
				case "variables":
					@appVariables(d)
				case "metrics":
					@appMetrics(d)
				case "storage":
					@appStorage(d)
				case "domains":
					@appDomains(d)
				case "settings":
					@appSettings(d)
				default:
					@appDeployments(d)
			}
		</div>
	</div>
}

templ appRail(d AppDetailData) {
	<aside class="hidden w-full shrink-0 lg:block lg:w-[212px]">
		<div class="panel overflow-hidden">
			<div class="panel-header">
				<span class="panel-title">Apps</span>
				<a class="btn btn-ghost btn-sm" href="/apps/new" aria-label="Deploy app">+</a>
			</div>
			<div class="rows max-h-[420px] overflow-y-auto">
				for _, s := range d.Siblings {
					<a
						href={ templ.URL("/apps/" + s.Name) }
						class={ "row-link !gap-2.5 !py-2.5",
							templ.KV("bg-accent/70", s.Name == d.App.Name) }
					>
						<span class="min-w-0 flex-1">
							<span class="block truncate text-[12.5px] font-medium">{ s.Name }</span>
							<span class="mt-0.5 block">
								@appStatus(s)
							</span>
						</span>
					</a>
				}
			</div>
		</div>
	</aside>
}

templ appMobileSwitcher(d AppDetailData) {
	<details class="panel group relative lg:hidden" data-app-switcher>
		<summary class="switcher border-0 bg-card px-3 py-2">
			<span class="min-w-0 flex-1 truncate text-left font-medium">{ d.App.Name }</span>
			<span class="text-muted-foreground">Switch app</span>
			<svg class="size-3.5 shrink-0 opacity-60 group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M6 9l6 6 6-6"></path></svg>
		</summary>
		<div class="switcher-menu left-0 right-0 top-full mt-1 max-h-[280px] overflow-y-auto">
			for _, a := range d.Siblings {
				<a href={ templ.URL("/apps/" + a.Name) } class={ "switcher-item", templ.KV("font-medium text-foreground", a.Name == d.App.Name) }>
					<span class="min-w-0 flex-1 truncate">{ a.Name }</span>
					@appStatus(a)
				</a>
			}
		</div>
	</details>
}

templ appDetailHeader(a app.App) {
	<div class="mb-4 flex flex-wrap items-start justify-between gap-3">
		<div class="min-w-0">
			<div class="flex items-center gap-2.5">
				<h1 class="text-[19px] font-semibold tracking-tight">{ a.Name }</h1>
				@appStatus(a)
			</div>
			// The URL sits above the image and in foreground colour: it is the
			// one line on this page a user wants to click, and muted mono next
			// to the image would read as another piece of metadata.
			if a.Host != "" {
				<a
					class="mono mt-1 flex max-w-full items-center gap-1.5 hover:underline"
					href={ templ.URL(a.URLScheme() + "://" + a.Host) }
					target="_blank"
					rel="noreferrer"
				>
					<span class="truncate">{ a.Host }</span>
					<span class="text-muted-foreground [&>svg]:size-3.5">
						@icon("external")
					</span>
				</a>
			}
			<p class={ "mono mt-1 truncate text-muted-foreground", templ.KV("italic", imageIsPending(a.Image)) }>{ imageLabel(a.Image) }</p>
		</div>
		<div class="flex items-center gap-2">
			<form method="post" action={ templ.URL("/apps/" + a.Name + "/redeploy") }>
				<button class="btn" type="submit">Redeploy</button>
			</form>
			<form
				method="post"
				action={ templ.URL("/apps/" + a.Name + "/delete") }
				data-confirm="This deletes the app and its namespace. This cannot be undone."
				data-confirm-title={ "Delete " + a.Name + "?" }
				data-confirm-label="Delete app"
			>
				<button class="btn btn-danger" type="submit">Delete</button>
			</form>
		</div>
	</div>
}

// appTabs is an app's tab strip.
//
// One templ rather than a list repeated per surface, because the log sheet
// renders it too. A panel that covers the app it belongs to has to carry the
// way out of itself: an open sheet makes the rest of the document inert, so
// tabs left behind it are not merely hidden — they cannot be clicked.
templ appTabs(name, active string) {
	<nav class="tabs canvas-sheet-tabs">
		@appTab(name, active, "", "Deployments")
		@appTab(name, active, "variables", "Variables")
		@appTab(name, active, "metrics", "Metrics")
		@appTab(name, active, "storage", "Storage")
		@appTab(name, active, "domains", "Domains")
		@appTab(name, active, "settings", "Settings")
	</nav>
}

templ appTab(name, active, slug, label string) {
	<a
		href={ templ.URL(appTabHref(name, slug)) }
		class={ "tab", templ.KV("tab-active", active == slug) }
	>
		{ label }
	</a>
}

// ---- deployments tab
//
// Polled while anything is in flight, and not otherwise. Before this the panel
// rendered once: a git deploy sat at "running" on screen until somebody
// reloaded, which for a build is potentially half an hour of a page that looks
// stuck rather than busy.
//
// The wrapper carries its own trigger and is replaced whole, so the render that
// finds nothing running comes back without one and the polling stops.
templ appDeployments(d AppDetailData) {
	<div
		id="app-deployments"
		if deploymentsInFlight(d) {
			hx-get={ "/apps/" + d.App.Name + "/deployments/fragment" }
			hx-trigger="every 3s"
			hx-swap="outerHTML"
		}
		aria-busy={ boolAttr(deploymentsInFlight(d)) }
	>
		@AppDeploymentsBody(d)
	</div>
}

templ AppDeploymentsBody(d AppDetailData) {
	if len(d.Deployments) == 0 {
		<div class="panel">
			<div class="empty">
				<p class="font-medium text-foreground">No deployments recorded</p>
				<p>History appears here after the first deploy.</p>
			</div>
		</div>
	} else {
		@activeDeployment(d, d.Deployments[0])
		if len(d.Deployments) > 1 {
			<div class="panel mt-4">
				<div class="panel-header">
					<span class="panel-title">History</span>
				</div>
				<div class="rows">
					for _, dep := range d.Deployments[1:] {
						@deploymentRow(d.App.Name, dep)
					}
				</div>
			</div>
		}
	}
	<div class="panel mt-4">
		<div class="panel-header">
			<span class="panel-title">Pods</span>
			<span class="text-[12px] text-muted-foreground tabular-nums">
				{ strconv.Itoa(len(d.Pods)) }
			</span>
		</div>
		if len(d.Pods) == 0 {
			<div class="empty">
				<p>No pods reported. The workload may be starting, or the cluster is unreachable.</p>
			</div>
		} else {
			@podTable(d.Pods, false)
		}
	</div>
}

// activeDeployment gets the tinted treatment because it is the one answering
// "what is live right now" — the question the page exists for.
templ activeDeployment(d AppDetailData, dep app.Deployment) {
	<div class={ "panel border-l-2 p-4", activeDeploymentBorder(dep) }>
		<div class="flex flex-wrap items-center justify-between gap-3">
			@deployLogsButton(d.App.Name, dep)
			<div class="min-w-0">
				<div class="flex items-center gap-2">
					@deploymentStatus(dep)
					<span class="text-[12px] text-muted-foreground">
						{ relativeTime(dep.StartedAt) } via { dep.Source() }
					</span>
				</div>
				if d.App.Port > 0 {
					<p class="mono mt-1.5 truncate text-muted-foreground">
						{ d.App.Namespace }.svc.cluster.local:80
					</p>
				}
				if dep.Message != "" {
					<p class="mt-1.5 text-[12.5px] text-muted-foreground">{ dep.Message }</p>
				}
			</div>
			<div class="flex items-center gap-2">
				<span class="tag">{ dep.Revision }</span>
			</div>
		</div>
	</div>
}

templ deploymentRow(appName string, dep app.Deployment) {
	<div class="row-item !py-2.5">
		<span class="w-24 shrink-0">
			@deploymentStatus(dep)
		</span>
		<span class="min-w-0 flex-1">
			<span class={ "mono block truncate text-muted-foreground", templ.KV("italic", imageIsPending(dep.Image)) }>{ imageLabel(dep.Image) }</span>
		</span>
		<span class="shrink-0 text-right text-[12px] text-muted-foreground">
			{ relativeTime(dep.StartedAt) } via { dep.Source() }
		</span>
		@deployLogsButton(appName, dep)
	</div>
}

// deployLogsButton opens one deployment's logs over the list.
//
// A sheet rather than a page: the list stays where it was, and the logs belong
// to the deployment that was clicked rather than to whatever is running now.
templ deployLogsButton(appName string, dep app.Deployment) {
	@sheet.Trigger(sheet.TriggerProps{For: "deploy-logs-sheet"}) {
		<button
			class="btn btn-sm order-last"
			type="button"
			hx-get={ "/apps/" + appName + "/deployments/" + dep.ID.String() + "/logs" }
			hx-target="#deploy-log-panel"
			hx-swap="innerHTML"
		>View logs</button>
	}
}

templ deploymentStatus(dep app.Deployment) {
	@statusDot(dep.Status, deploymentClass(dep.Status))
}

// ---- variables tab
templ appVariables(d AppDetailData) {
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Environment</span>
			<span class="text-[12px] text-muted-foreground tabular-nums">
				{ strconv.Itoa(len(d.App.Variables)) }
			</span>
		</div>
		if len(d.App.Variables) == 0 {
			<div class="empty">
				<p>No environment variables set.</p>
			</div>
		} else {
			<div class="table-scroll">
			<table class="dtable min-w-[520px]">
				<thead>
					<tr><th>Key</th><th>Value</th><th class="text-right">Actions</th></tr>
				</thead>
				<tbody>
					for _, v := range d.App.Variables {
						<tr>
							<td class="mono">{ v.Key }</td>
							<td class="mono">
								if v.Secret {
									// The value is not in the struct this page was
									// given, so there is nothing here to reveal.
									// A page that could show it is one an
									// onlooker can read.
									<span class="text-muted-foreground">••••••••</span>
									<span class="ml-2">
										@statusDot("secret", "status-info")
									</span>
								} else {
									{ v.Value }
								}
							</td>
							<td class="text-right">
								<form method="post" action={ templ.SafeURL("/apps/" + d.App.Name + "/variables/" + v.Key + "/delete") }>
									<button class="btn btn-sm btn-danger" type="submit">Remove</button>
								</form>
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
		}
	</div>
	<div class="panel">
		<div class="panel-header"><span class="panel-title">Set a variable</span></div>
		<div class="panel-body">
			<form method="post" action={ templ.SafeURL("/apps/" + d.App.Name + "/variables") } class="flex flex-wrap items-end gap-4">
				<div class="field">
					<label class="label" for="var-key">Key</label>
					<input class="control mono" id="var-key" name="key" required placeholder="DATABASE_URL"/>
				</div>
				<div class="field grow">
					<label class="label" for="var-value">Value</label>
					<input class="control mono" id="var-value" name="value" placeholder="postgres://…"/>
				</div>
				<label class="check-field">
					<input type="checkbox" name="secret" value="1"/>
					Secret
				</label>
				<button class="btn btn-primary" type="submit">Save</button>
			</form>
			<p class="mt-3 text-[12px] text-muted-foreground">
				A secret is encrypted before it is stored and mounted from a Kubernetes
				Secret, so it appears neither in a database dump nor in
				<code class="mono">kubectl get deploy -o yaml</code>. It cannot be shown
				again afterwards — replace it instead. Setting one requires
				<code class="mono">YACHT_SECRET_KEY</code>.
			</p>
		</div>
	</div>
}

// ---- metrics tab
templ appMetrics(d AppDetailData) {
	<div class="metrics mb-4">
		@metric("Desired", strconv.Itoa(int(d.App.Replicas)), "replicas")
		@metric("Ready", readyLabel(d.App), "")
		@metric("Pods", strconv.Itoa(len(d.Pods)), "")
		@metric("Port", portLabel(d.App), "")
	</div>
	if d.App.StatusKnown && d.App.Status.Message != "" {
		<div class="callout callout-warn mb-4">
			<div>
				<div class="font-medium">Cluster reports</div>
				<p class="mt-0.5 text-muted-foreground">{ d.App.Status.Message }</p>
			</div>
		</div>
	}
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">Requested resources</span>
		</div>
		<div class="panel-body">
			<dl class="kv">
				<dt>CPU request</dt>
				<dd class="mono">{ orDash(d.App.CPURequest) }</dd>
				<dt>CPU limit</dt>
				<dd class="mono">{ orDash(d.App.CPULimit) }</dd>
				<dt>Memory request</dt>
				<dd class="mono">{ orDash(d.App.MemoryRequest) }</dd>
				<dt>Memory limit</dt>
				<dd class="mono">{ orDash(d.App.MemoryLimit) }</dd>
			</dl>
			<p class="hint mt-3">
				Empty fields fall back to the namespace LimitRange, so no container
				runs unbounded.
			</p>
		</div>
	</div>
}

// appRuntimeForm is everything about an app that had no way to be changed.
//
// Image, port, what it may consume, whether it is reachable, and where a Git
// app builds from were all decided at create and then frozen — so changing an
// image tag meant deleting the app and starting again, taking its domains and
// its history with it.
//
// A plain form, and the only complete way to do this. The dialogs in the app
// header are shortcuts onto the same endpoint; this is what they are shortcuts
// to, and what still works with no JavaScript at all.
templ appRuntimeForm(d AppDetailData) {
	{{ a := d.App }}
	<form method="post" action={ templ.URL("/apps/" + a.Name + "/runtime") }>
		<section id="source" class="settings-section">
			<div class="settings-section-head">
				<span class="settings-section-mark">@icon("box")</span>
				<h2 class="settings-section-title">Source</h2>
			</div>
			if a.Source == app.SourceGit {
				<div class="field-group">
					<div class="field-label mb-1.5">Source repo</div>
					@sourceCard(d)
				</div>
				<div class="field-group">
					<label class="field-label" for="repo_url">Repository URL</label>
					<p class="field-note">Where a deploy builds from.</p>
					<input class="control mono mt-1.5" id="repo_url" name="repo_url" value={ a.Repo.URL } placeholder="https://github.com/owner/repo"/>
				</div>
				@branchPicker(a.Name, a.Repo.Branch)
				@directoryPicker(a.Name, a.Repo.Subdir)
				<p class="field-note">Changing any of these does not rebuild. The next deploy reads them.</p>
			} else {
				<div class="field-group">
					<label class="field-label" for="image">Image</label>
					<p class="field-note">A new tag here is how this app is upgraded.</p>
					<input class="control mono mt-1.5" id="image" name="image" value={ a.Image } required/>
				</div>
			}
			if a.Source == app.SourceGit {
				<div class="field-group">
					<div class="field-label">Current image</div>
					<p class="field-note">
						What the last build produced. Not editable — the next build replaces it.
					</p>
					<input class="control mono mt-1.5" value={ imageLabel(a.Image) } disabled/>
				</div>
			}
		</section>
		<section id="networking" class="settings-section">
			<div class="settings-section-head">
				<span class="settings-section-mark">@icon("globe")</span>
				<h2 class="settings-section-title">Networking</h2>
			</div>
			<div class="field-group">
				<label class="field-label" for="port">Port</label>
				<p class="field-note">The port your app listens on. 0 for an app that serves nothing.</p>
				<input
					class="control mt-1.5 w-32"
					id="port"
					type="number"
					name="port"
					min="0"
					max="65535"
					value={ strconv.Itoa(int(a.Port)) }
				/>
			</div>
			@toggle("internal", "Internal only",
				"Reachable from inside the cluster and nowhere else. Turning this on withdraws the platform hostname rather than hiding it.",
				a.Internal)
			<p class="field-note mt-2">
				Domains and HTTPS are on the
				<a class="underline hover:text-foreground" href={ templ.URL("/apps/" + a.Name + "/domains") }>Domains</a>
				tab.
			</p>
		</section>
		<section id="scale" class="settings-section">
			<div class="settings-section-head">
				<span class="settings-section-mark">@icon("cpu")</span>
				<h2 class="settings-section-title">Scale</h2>
			</div>
			<div class="field-group">
				<div class="field-label">Limits</div>
				<p class="field-note mb-3">
					The most one replica may use. The ceiling is this cluster's largest
					node, because that is what a single pod can be scheduled onto.
				</p>
				@resourceSlider(d.CPULimit, "cpu")
				@resourceSlider(d.MemoryLimit, "mem")
			</div>
			<div class="field-group">
				<div class="field-label">Reserved</div>
				<p class="field-note mb-3">
					What the scheduler holds for it. A pod with nothing reserved can land
					on a node that has nothing left to give it.
				</p>
				@resourceSlider(d.CPURequest, "cpu")
				@resourceSlider(d.MemoryRequest, "mem")
			</div>
		</section>
		<div class="sticky bottom-0 -mx-4 border-t border-border bg-background/95 px-4 py-3 backdrop-blur sm:-mx-6 sm:px-6">
			<button class="btn btn-primary" type="submit">Save and roll out</button>
			<span class="ml-3 text-[12px] text-muted-foreground">
				Saving applies these to the cluster and records a deployment.
			</span>
		</div>
	</form>
}

// ---- domains tab
//
// Its own tab rather than three panels inside Settings, where these sat between
// health checks and resource limits. Adding a domain is a task with several
// steps and a wait in the middle, and a thing you wait on needs somewhere to be
// watched — which a settings form is not.
templ appDomains(d AppDetailData) {
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	@publicNetworking(netOf(d))
	@customDomains(netOf(d))
	@routingOptions(netOf(d))
}

// ---- settings tab
templ appSettings(d AppDetailData) {
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	if d.Notice != "" {
		<div class="callout mb-5">
			<div class="min-w-0 text-muted-foreground">{ d.Notice }</div>
		</div>
	}
	<div class="settings-shell">
		// The nav is beside the page rather than above it, and every section is
		// on that page. Tabs hide what they are not showing, so finding a
		// setting means guessing which tab owns it; anchors keep it all
		// findable with the browser's own search.
		<nav class="settings-nav" aria-label="Settings sections">
			<a href="#source">Source</a>
			<a href="#networking">Networking</a>
			<a href="#scale">Scale</a>
			<a href="#health">Health</a>
			<a href="#replicas">Replicas</a>
			<a href="#danger">Danger</a>
		</nav>
		<div class="settings-main">
			@appRuntimeForm(d)
			@appLegacySettings(d)
		</div>
	</div>
}

// appLegacySettings is the part of the tab that has not been restructured yet.
//
// Health, replicas and deletion keep the forms they had. They are correct and
// they work; leaving them as panels inside the new shell is honest about what
// has been reworked and what has not, and is cheaper than moving markup around
// for its own sake.
templ appLegacySettings(d AppDetailData) {
	{{ a := d.App }}
	<section id="health" class="settings-section">
		<div class="settings-section-head">
			<span class="settings-section-mark">@icon("activity")</span>
			<h2 class="settings-section-title">Health</h2>
		</div>
	<div class="panel mb-5">
		<div class="panel-header"><span class="panel-title">Health check</span></div>
		<div class="panel-body">
			<form method="post" action={ templ.SafeURL("/apps/" + a.Name + "/health") } class="flex flex-wrap items-end gap-4">
				<div class="field grow">
					<label class="label" for="health-path">Path</label>
					<input class="control mono" id="health-path" name="health_path" value={ a.HealthPath } placeholder="/healthz"/>
					<span class="hint">
						An HTTP GET on this app's own port. Empty means no probe.
					</span>
				</div>
				<label class="flex items-center gap-2 pb-6 text-[12.5px]">
					if a.Liveness {
						<input type="checkbox" name="liveness" value="1" checked/>
					} else {
						<input type="checkbox" name="liveness" value="1"/>
					}
					Also restart when it fails
				</label>
				<button class="btn btn-primary mb-6" type="submit">Save</button>
			</form>
			<p class="text-[12px] text-muted-foreground">
				A health check keeps traffic away from a container that is not serving
				yet. Restarting on failure is separate and off by default: it kills the
				container, so a check that is a little too impatient turns a slow start
				into a restart loop — which looks like the app being broken rather than
				the check being wrong.
			</p>
		</div>
	</div>
	</section>
	<section id="replicas" class="settings-section">
		<div class="settings-section-head">
			<span class="settings-section-mark">@icon("layers")</span>
			<h2 class="settings-section-title">Replicas</h2>
		</div>
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">Scale</span>
		</div>
		<div class="panel-body">
			<form
				method="post"
				action={ templ.URL("/apps/" + a.Name + "/scale") }
				class="flex flex-wrap items-end gap-3"
			>
				<div class="field w-32">
					<label class="label" for="replicas">Replicas</label>
					<input
						class="control"
						id="replicas"
						type="number"
						name="replicas"
						min="0"
						max="50"
						value={ strconv.Itoa(int(a.Replicas)) }
					/>
				</div>
				<button class="btn" type="submit">Apply</button>
				<span class="hint pb-2">Set to 0 to stop without deleting.</span>
			</form>
		</div>
	</div>
	<div class="panel mt-4">
		<div class="panel-header">
			<span class="panel-title">Details</span>
		</div>
		<div class="panel-body">
			<dl class="kv">
				<dt>Namespace</dt>
				<dd class="mono break-all">{ a.Namespace }</dd>
				<dt>Image</dt>
				<dd class={ "mono break-all", templ.KV("italic text-muted-foreground", imageIsPending(a.Image)) }>{ imageLabel(a.Image) }</dd>
				<dt>Created</dt>
				<dd>{ a.CreatedAt.Format("2 Jan 2006, 15:04") }</dd>
				<dt>Updated</dt>
				<dd>{ a.UpdatedAt.Format("2 Jan 2006, 15:04") }</dd>
			</dl>
		</div>
	</div>
	</section>
	<section id="danger" class="settings-section">
		<div class="settings-section-head">
			<span class="settings-section-mark">@icon("minus")</span>
			<h2 class="settings-section-title">Danger</h2>
		</div>
	<div class="panel border-l-2 border-l-destructive">
		<div class="panel-header">
			<span class="panel-title">Danger zone</span>
		</div>
	<div class="panel-body">
			<div class="font-medium">Delete this app</div>
			<p class="hint mt-0.5">
				Removes the workload, its namespace, its domains and its storage. Not
				reversible.
			</p>
			// The name is typed back, and the server checks it.
			//
			// The dialog alone is not a guard: it is JavaScript, and without it
			// the form posts straight through. Deleting a volume has always
			// asked this way for the same reason — the cost of getting it wrong
			// is something that does not come back, and a button somebody can
			// reach with one misplaced click is not enough between them.
			<form
				method="post"
				action={ templ.URL("/apps/" + a.Name + "/delete") }
				class="mt-4 flex flex-wrap items-end gap-3"
			>
				<div class="field min-w-[220px] flex-1">
					<label class="label" for="confirm-delete">
						Type <code class="mono">{ a.Name }</code> to confirm
					</label>
					<input
						class="control mono"
						id="confirm-delete"
						name="confirm"
						placeholder={ a.Name }
						autocomplete="off"
						required
					/>
				</div>
				<button
					class="btn btn-danger"
					type="submit"
					data-confirm="This deletes the app, its namespace, its domains and its storage. This cannot be undone."
					data-confirm-title={ "Delete " + a.Name + "?" }
					data-confirm-label="Delete app"
				>Delete app</button>
			</form>
		</div>
	</div>
	</section>
}

// ---------------------------------------------------------------- new app

type NewAppData struct {
	Error string
	Form  NewAppForm

	// Source is what the person picked. Empty shows the picker instead of a
	// form: there is no sensible default, and choosing for them is how you end
	// up with a database deployed as a bare image.
	Source app.Source

	// Blueprint is the chosen source's settings, so the form can show what is
	// already decided rather than asking again.
	Blueprint app.Blueprint

	Sources []app.Blueprint

	// CanConfigureRegistry decides whether an unavailable Git source offers a
	// way out or only names who has one. The registry page is owner-only, so
	// linking a member to it would replace a dead end with a locked door.
	CanConfigureRegistry bool
}

// NewAppForm preserves what the user typed so a validation error does not
// discard their input.
type NewAppForm struct {
	Name     string
	Image    string
	Port     string
	Replicas string
	Env      string

	// The repository, for a source that is built rather than pulled.
	RepoURL    string
	RepoBranch string
	RepoSubdir string
}

templ NewApp(d NewAppData) {
	if d.Source == "" {
		@sourcePicker(d)
	} else {
		@newAppForm(d)
	}
}

// sourcePicker is the first step: what is this app?
//
// Sources that are not built yet are listed with the reason rather than left
// out. A menu that silently omits things reads as a product that never
// considered them, and somebody will ask anyway.
templ sourcePicker(d NewAppData) {
	@pageHead("Deploy", "What would you like to run?", nil)
	<div class="panel max-w-2xl">
		<div class="rows">
			for _, b := range d.Sources {
				if b.Available {
					<a href={ templ.SafeURL(sourceHref(b.Source)) } class="row-link">
						<span class="text-muted-foreground">
							@icon(sourceIcon(b.Source))
						</span>
						<span class="min-w-0 flex-1">
							<span class="block font-medium">{ b.Label }</span>
							<span class="block text-muted-foreground">{ b.Description }</span>
						</span>
						<span class="text-muted-foreground">&rsaquo;</span>
					</a>
				} else {
					// Greyed, and no longer a dead end. Saying "no image
					// registry is configured" without saying where one is
					// configured leaves the reader to search for a page they
					// have not seen — and on a member's account, to search for
					// one they cannot open at all.
					<div class="row-item cursor-not-allowed">
						<span class="text-muted-foreground opacity-50">
							@icon(sourceIcon(b.Source))
						</span>
						<span class="min-w-0 flex-1 opacity-50">
							<span class="block font-medium">{ b.Label }</span>
							<span class="block text-muted-foreground">Not yet — { b.Because }.</span>
						</span>
						if b.Source == app.SourceGit && d.CanConfigureRegistry {
							<a class="btn btn-sm" href="/cluster/registry">Configure</a>
						} else if b.Source == app.SourceGit {
							<span class="text-[11.5px] text-muted-foreground">
								An owner can set one up.
							</span>
						}
					</div>
				}
			}
		</div>
	</div>
}

// repoFields asks where the source is.
//
// No image field: the image is what the build produces, so offering a box for
// one would be offering to overwrite the answer.
templ repoFields(d NewAppData) {
	<div class="field">
		<label class="label" for="repo_url">Repository</label>
		<input
			class="control mono"
			id="repo_url"
			name="repo_url"
			value={ d.Form.RepoURL }
			placeholder="https://github.com/you/app.git"
			required
		/>
		<span class="hint">
			An https or ssh URL. It is cloned, built, and run here, so plain http is
			refused — anyone on the path could replace what arrives.
		</span>
	</div>
	<div class="grid gap-4 sm:grid-cols-2">
		<div class="field">
			<label class="label" for="repo_branch">Branch</label>
			<input
				class="control mono"
				id="repo_branch"
				name="repo_branch"
				value={ d.Form.RepoBranch }
				placeholder={ app.DefaultBranch }
			/>
			<span class="hint">Empty builds { app.DefaultBranch }.</span>
		</div>
		<div class="field">
			<label class="label" for="repo_subdir">Directory</label>
			<input
				class="control mono"
				id="repo_subdir"
				name="repo_subdir"
				value={ d.Form.RepoSubdir }
				placeholder="services/api"
			/>
			<span class="hint">For a monorepo. Empty builds the root.</span>
		</div>
	</div>
	<p class="text-[12.5px] text-muted-foreground">
		A Dockerfile in that directory is what gets built. Without one, buildpacks
		try to work out what the code is — which is slower and can guess wrong.
	</p>
}

templ newAppForm(d NewAppData) {
	@pageHead("Deploy "+d.Blueprint.Label, d.Blueprint.Description, backToSources())
	if d.Blueprint.Source != app.SourceImage && d.Blueprint.Volume != nil {
		<div class="callout mb-5">
			<div class="min-w-0">
				<div class="font-medium">{ d.Blueprint.Label } configures itself</div>
				<p class="mt-0.5 text-muted-foreground">
					Image <code class="mono">{ d.Blueprint.Image }</code>, a
					{ gigabytes(d.Blueprint.Volume.SizeBytes) } GB volume at
					<code class="mono">{ d.Blueprint.Volume.MountPath }</code>, and generated
					credentials you will find under Variables. It is reachable from other
					apps in this install, and not from the internet.
				</p>
			</div>
		</div>
	}
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div>
				<div class="font-medium">Could not deploy</div>
				<p class="mt-0.5 text-muted-foreground">{ d.Error }</p>
			</div>
		</div>
	}
	<form method="post" action="/apps" class="max-w-2xl">
		<input type="hidden" name="source" value={ string(d.Blueprint.Source) }/>
		<div class="panel">
			<div class="panel-header">
				<span class="panel-title">Source</span>
			</div>
			<div class="panel-body flex flex-col gap-4">
				<div class="field">
					<label class="label" for="name">Name</label>
					<input class="control" id="name" name="name" value={ d.Form.Name } placeholder="web" required/>
					<span class="hint">Lowercase letters, numbers and dashes. Becomes the DNS name.</span>
				</div>
				if d.Blueprint.Source == app.SourceGit {
					@repoFields(d)
				} else {
					<div class="field">
						<label class="label" for="image">Image</label>
						<input class="control mono" id="image" name="image" value={ d.Form.Image } placeholder="nginx:alpine" required/>
						<span class="hint">
							Must run as a non-root user — a restricted security context is enforced.
						</span>
					</div>
				}
			</div>
		</div>
		<div class="panel mt-4">
			<div class="panel-header">
				<span class="panel-title">Runtime</span>
			</div>
			<div class="panel-body flex flex-col gap-4">
				<div class="grid gap-4 sm:grid-cols-2">
					<div class="field">
						<label class="label" for="port">Port</label>
						<input class="control" id="port" name="port" type="number" min="0" max="65535" value={ d.Form.Port } placeholder="8080"/>
						<span class="hint">0 for no inbound traffic.</span>
					</div>
					<div class="field">
						<label class="label" for="replicas">Replicas</label>
						<input class="control" id="replicas" name="replicas" type="number" min="0" max="50" value={ d.Form.Replicas }/>
					</div>
				</div>
				<div class="field">
					<label class="label" for="env">Environment</label>
					<textarea class="control" id="env" name="env" rows="5" placeholder="LOG_LEVEL=info">{ d.Form.Env }</textarea>
					<span class="hint">One KEY=value per line. Blank lines and # comments are ignored.</span>
				</div>
			</div>
		</div>
		<div class="mt-4 flex items-center gap-2">
			<button class="btn btn-primary" type="submit">Deploy</button>
			<a class="btn btn-ghost" href="/apps">Cancel</a>
		</div>
	</form>
}

// ---------------------------------------------------------------- cluster

type ClusterData struct {
	Tab     string
	OK      bool
	Error   string
	Summary orchestrator.ClusterSummary
	Nodes   []orchestrator.NodeInfo
	Pods    []orchestrator.PodInfo

	// CanAddNode and CanManageNodes are separate because the abilities are.
	// Joining needs a key to seal a token; draining needs a credential that can
	// evict across namespaces, and an install can have either without the
	// other. Each gates only what it actually governs, so a link never leads
	// somewhere its viewer would be refused.
	CanAddNode     bool
	CanManageNodes bool
}

templ Cluster(d ClusterData) {
	if d.CanAddNode {
		@pageHead("Cluster", "Kubernetes capacity and workloads.", addNodeButton())
	} else {
		@pageHead("Cluster", "Kubernetes capacity and workloads.", nil)
	}
	if !d.OK {
		@clusterCallout(d.Error)
	}
	<div class="metrics mb-5">
		@metric("Nodes", strconv.Itoa(d.Summary.Nodes),
			fmt.Sprintf("%d ready", d.Summary.NodesReady))
		@metric("Pods", strconv.Itoa(d.Summary.Pods), podCapacityLabel(d.Summary))
		@metricUsage("CPU", d.Summary.CPUPercent(), d.Summary.UsageKnown,
			clusterCPUDetail(d.Summary))
		@metricUsage("Memory", d.Summary.MemoryPercent(), d.Summary.UsageKnown,
			clusterMemDetail(d.Summary))
		@metric("Volumes", strconv.Itoa(d.Summary.Volumes), "")
	</div>
	<nav class="tabs mb-5">
		<a class={ "tab", templ.KV("tab-active", d.Tab == "nodes") } href="/cluster/nodes">Nodes</a>
		<a class={ "tab", templ.KV("tab-active", d.Tab == "pods") } href="/cluster/pods">Pods</a>
	</nav>
	if d.Tab == "pods" {
		<div class="panel">
			if len(d.Pods) == 0 {
				<div class="empty">
					<p class="font-medium text-foreground">No pods</p>
					<p>Nothing is running, or the cluster is unreachable.</p>
				</div>
			} else {
				@podTable(d.Pods, true)
			}
		</div>
	} else {
		if len(d.Nodes) == 0 {
			<div class="panel">
				<div class="empty">
					<p class="font-medium text-foreground">No nodes</p>
					<p>
						The orchestrator is not connected to a cluster. Check
						<code class="mono">YACHT_KUBECONFIG</code> and restart.
					</p>
				</div>
			</div>
		} else {
			<div class="panel">
				<div class="rows">
					for _, n := range d.Nodes {
						@nodeRow(n, d.CanManageNodes)
					}
				</div>
			</div>
		}
	}
}

// nodeRow keeps a node to a single row with inline meters, rather than the
// card-per-node layout it replaced. Four nodes then fit on screen together,
// which is what makes an imbalance visible.
templ addNodeButton() {
	<a class="btn btn-primary" href="/cluster/nodes/add">Add node</a>
}

templ nodeRow(n orchestrator.NodeInfo, manageable bool) {
	<div class="row-item flex-wrap">
		<div class="min-w-[220px] flex-1">
			<div class="flex flex-wrap items-center gap-2">
				if manageable {
					// Linked only for somebody the page would admit. A link to a
					// 403 says you have a permission you do not.
					<a class="font-medium hover:underline" href={ templ.URL("/cluster/nodes/" + n.Name) }>
						{ n.Name }
					</a>
				} else {
					<span class="font-medium">{ n.Name }</span>
				}
				if n.Ready {
					@statusDot("Ready", "status-ok")
				} else {
					@statusDot("Not ready", "status-err")
				}
				for _, role := range n.Roles {
					<span class="tag">{ role }</span>
				}
				if n.Unschedulable {
					@statusDot("Cordoned", "status-warn")
				}
			</div>
			<p class="mt-1 truncate text-[11.5px] text-muted-foreground">{ nodeSubtitle(n) }</p>
		</div>
		<div class="w-40 shrink-0">
			<div class="flex items-baseline justify-between gap-2">
				<span class="micro">CPU</span>
				<span class="text-[11.5px] text-muted-foreground tabular-nums">{ cpuLabel(n) }</span>
			</div>
			@meter(n.CPUPercent(), meterClass(n.CPUPercent()))
		</div>
		<div class="w-40 shrink-0">
			<div class="flex items-baseline justify-between gap-2">
				<span class="micro">Memory</span>
				<span class="text-[11.5px] text-muted-foreground tabular-nums">{ memLabel(n) }</span>
			</div>
			@meter(n.MemoryPercent(), meterClass(n.MemoryPercent()))
		</div>
		<div class="w-16 shrink-0 text-right text-[12px] text-muted-foreground tabular-nums">
			{ strconv.Itoa(n.Pods) } pods
		</div>
	</div>
}

templ podTable(pods []orchestrator.PodInfo, showNamespace bool) {
	<div class="overflow-x-auto">
		<table class="dtable">
			<thead>
				<tr>
					<th>Pod</th>
					if showNamespace {
						<th>Namespace</th>
					}
					<th>Ready</th>
					<th>Restarts</th>
					<th>Node</th>
					<th>Status</th>
				</tr>
			</thead>
			<tbody>
				for _, p := range pods {
					<tr>
						<td class="mono max-w-[240px] truncate">{ p.Name }</td>
						if showNamespace {
							<td class="mono max-w-[200px] truncate text-muted-foreground">{ p.Namespace }</td>
						}
						<td class="tabular-nums text-muted-foreground">
							{ fmt.Sprintf("%d/%d", p.Ready, p.Total) }
						</td>
						<td class="tabular-nums text-muted-foreground">{ strconv.Itoa(int(p.Restarts)) }</td>
						<td class="max-w-[160px] truncate text-muted-foreground">{ orDash(p.Node) }</td>
						<td>
							@statusDot(p.Phase, podPhaseClass(p))
						</td>
					</tr>
					if p.Reason != "" {
						// On its own row rather than in the status cell: the
						// message is a sentence, and a table column sized for
						// "Running" would truncate the half that says what to do.
						<tr>
							<td class="!pt-0 text-muted-foreground" colspan="6">
								<span class="font-medium text-foreground">{ p.Reason }</span>
								if p.Message != "" {
									&mdash; { p.Message }
								}
							</td>
						</tr>
					}
				}
			</tbody>
		</table>
	</div>
}

// ---------------------------------------------------------------- activity

type ActivityData struct {
	Items []app.Activity
}

// Activity is the cross-app deployment feed: what changed recently, anywhere.
// The per-app history answers "what happened to this"; this answers "what
// happened", which is the question you have when something broke and you do
// not yet know where.
templ Activity(d ActivityData) {
	@pageHead("Deployments", "Recent deploys across every app.", nil)
	<div class="panel">
		if len(d.Items) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No deployments yet</p>
				<p>Deploys appear here as they happen.</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="dtable">
					<thead>
						<tr>
							<th>App</th>
							<th>Image</th>
							<th>Trigger</th>
							<th>Status</th>
							<th class="text-right">When</th>
						</tr>
					</thead>
					<tbody>
						for _, it := range d.Items {
							<tr>
								<td>
									<a
										href={ templ.URL("/apps/" + it.AppName) }
										class="font-medium hover:underline"
									>{ it.AppName }</a>
								</td>
								<td class="mono max-w-[280px] truncate text-muted-foreground">{ it.Image }</td>
								<td class="text-muted-foreground">
									<span class="tag">{ it.Revision }</span>
								</td>
								<td>
									@statusDot(it.Status, deploymentClass(it.Status))
								</td>
								<td class="whitespace-nowrap text-right text-muted-foreground">
									{ relativeTime(it.StartedAt) }
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// ---------------------------------------------------------------- volumes

type VolumesData struct {
	OK      bool
	Error   string
	Volumes []orchestrator.VolumeInfo
}

templ Volumes(d VolumesData) {
	@pageHead("Volumes", "Persistent volume claims in the cluster.", nil)
	if !d.OK {
		@clusterCallout(d.Error)
	}
	<div class="panel">
		if len(d.Volumes) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No volumes</p>
				<p>Apps with persistent storage will claim volumes here.</p>
			</div>
		} else {
			<div class="overflow-x-auto">
				<table class="dtable">
					<thead>
						<tr>
							<th>Claim</th>
							<th>Namespace</th>
							<th>Size</th>
							<th>Class</th>
							<th>Access</th>
							<th>Status</th>
						</tr>
					</thead>
					<tbody>
						for _, v := range d.Volumes {
							<tr>
								<td class="mono max-w-[220px] truncate">{ v.Name }</td>
								<td class="mono max-w-[180px] truncate text-muted-foreground">{ v.Namespace }</td>
								<td class="tabular-nums text-muted-foreground">{ volumeSize(v) }</td>
								<td class="text-muted-foreground">{ orDash(v.StorageClass) }</td>
								<td class="text-muted-foreground">
									for _, m := range v.AccessModes {
										<span class="tag mr-1">{ m }</span>
									}
								</td>
								<td>
									@statusDot(v.Phase, volumeClass(v))
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
	</div>
}

// ---------------------------------------------------------------- events

type EventsData struct {
	OK     bool
	Error  string
	Events []orchestrator.EventInfo

	// Page is the window being shown, and Read is how much of the stream was
	// looked at to build it — shown because a search that found nothing needs
	// to say how far it looked.
	Page Page
	Read int
}

// Events is where Kubernetes explains itself. "Pending" is not actionable;
// "Insufficient cpu" or "ErrImagePull" is.
templ Events(d EventsData) {
	@pageHead("Events", "Recent cluster events, warnings first.", nil)
	if !d.OK {
		@clusterCallout(d.Error)
	}
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">
				if d.Page.Filtered() {
					{ plural(d.Page.Matched, "match") } in { plural(d.Read, "event") }
				} else {
					{ plural(d.Page.Matched, "event") }
				}
			</span>
			@searchBox(d.Page, "Search events")
		</div>
		if len(d.Events) == 0 {
			@noMatches(d.Page, "No events",
				"Nothing reported, or the cluster is unreachable. Kubernetes also "+
					"expires events after about an hour.")
		} else {
			// A table rather than stacked cards. An event list is read by
			// scanning one column at a time — every warning, or everything
			// touching one pod — and text that starts at a different x on
			// every row cannot be scanned at all.
			<div class="overflow-x-auto">
				<table class="dtable evt">
					<thead>
						<tr>
							<th class="w-[68px]">Time</th>
							<th class="w-[132px]">Reason</th>
							<th class="w-[220px]">Object</th>
							<th>Message</th>
							<th class="w-[52px] text-right">Count</th>
						</tr>
					</thead>
					<tbody>
						for _, e := range d.Events {
							<tr class={ templ.KV("evt-warn", e.Warning()) }>
								<td class="text-muted-foreground tabular-nums">
									{ shortTime(e.LastSeen) }
								</td>
								<td>
									if e.Warning() {
										@statusDot(e.Reason, "status-warn")
									} else {
										@statusDot(e.Reason, "status-neutral")
									}
								</td>
								// Namespace and object together. The object name alone
								// is not unique across a cluster, so two rows for
								// different pods in different namespaces would read
								// as the same thing said twice.
								<td class="mono max-w-[220px] truncate text-muted-foreground" title={ e.Namespace + "/" + e.Object }>
									<span class="opacity-60">{ e.Namespace }/</span>{ e.Object }
								</td>
								// Not truncated. The message is the one field
								// worth reading in full, and an ellipsis here
								// hides the half that says what to do.
								<td class="whitespace-normal break-words" title={ e.Message }>
									<span class="evt-msg">{ e.Message }</span>
								</td>
								<td class="text-right tabular-nums text-muted-foreground">
									if e.Count > 1 {
										{ fmt.Sprintf("%d", e.Count) }
									} else {
										<span class="opacity-40">&mdash;</span>
									}
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
		}
		@pageControls(d.Page)
	</div>
}

// ---------------------------------------------------------------- settings

type SettingsData struct {
	OwnerID       string
	OwnerName     string
	Authenticated bool
	Version       string
	ClusterOK     bool
	AppDomain     string
	WildcardTLS   bool

	// AccountsOn, MailTransport and SessionTTL describe the sign-in posture.
	// Shown because otherwise the only way to find out whether accounts are on
	// — and whether links are actually being delivered — is to sign out and
	// see what happens.
	AccountsOn    bool
	MailTransport string
	SessionTTL    string
}

templ Settings(d SettingsData) {
	@pageHead("Settings", "This install runs in single-owner mode.", nil)
	if !d.Authenticated {
		<div class="callout callout-warn mb-5">
			<div>
				<div class="font-medium">No authentication configured</div>
				<p class="mt-0.5 text-muted-foreground">
					Set <code class="mono">YACHT_AUTH_TOKEN</code> before exposing this
					dashboard beyond a trusted network.
				</p>
			</div>
		</div>
	}
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">Install</span>
		</div>
		<div class="panel-body">
			<dl class="kv">
				<dt>Owner</dt>
				<dd>
					{ d.OwnerName }
					<span class="mono ml-1 text-muted-foreground">{ d.OwnerID }</span>
				</dd>
				<dt>Authentication</dt>
				<dd>
					if d.Authenticated {
						@statusDot("Bearer token", "status-ok")
					} else {
						@statusDot("None", "status-warn")
					}
				</dd>
				<dt>Cluster</dt>
				<dd>
					if d.ClusterOK {
						@statusDot("Connected", "status-ok")
					} else {
						@statusDot("Unreachable", "status-err")
					}
				</dd>
				<dt>App domain</dt>
				<dd>
					if d.AppDomain == "" {
						<span class="text-muted-foreground">
							Not configured — apps are reachable only inside the cluster. Set
							<code class="mono">YACHT_APP_DOMAIN</code> to give each app a URL.
						</span>
					} else {
						<span class="mono">*.{ d.AppDomain }</span>
						<span class="ml-1 text-muted-foreground">must point at this cluster</span>
					}
				</dd>
				<dt>Platform TLS</dt>
				<dd>
					if d.WildcardTLS {
						@statusDot("Wildcard certificate", "status-ok")
						<span class="ml-1 text-muted-foreground">
							served by the ingress controller
						</span>
					} else {
						@statusDot("Off", "status-neutral")
					}
				</dd>
				<dt>Sign-in</dt>
				<dd>
					if d.AccountsOn {
						@statusDot("Magic link", "status-ok")
						<span class="ml-1 text-muted-foreground">
							sessions last { d.SessionTTL }, links delivered by <span class="mono">{ d.MailTransport }</span>
						</span>
					} else {
						@statusDot("Off", "status-neutral")
						<span class="ml-1 text-muted-foreground">
							single owner. Set <code class="mono">YACHT_BASE_URL</code> to add people.
						</span>
					}
				</dd>
				if d.AccountsOn && d.MailTransport == "log" {
					<dt>Mail</dt>
					<dd>
						@statusDot("Written to the log", "status-warn")
						<span class="ml-1 text-muted-foreground">
							nothing is sent. This is the way back in if delivery breaks, but
							set <code class="mono">YACHT_SMTP_ADDR</code> or
							<code class="mono">YACHT_RESEND_API_KEY</code> before inviting anyone.
						</span>
					</dd>
				}
				<dt>Version</dt>
				<dd class="mono">{ d.Version }</dd>
			</dl>
		</div>
	</div>
}

// appStorage is the tab that attaches, grows and removes an app's volumes.
//
// The two consequences of having storage are stated before the form rather
// than after the surprise: a ReadWriteOnce claim mounts on one node at a time,
// so the app is held to one replica, and a deploy stops the old pod before
// starting the new one instead of overlapping them.
templ appStorage(d AppDetailData) {
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	<div class="callout mb-5">
		<div class="min-w-0">
			<div class="font-medium">Storage changes how this app deploys</div>
			<p class="mt-0.5 text-muted-foreground">
				A volume can be mounted by one pod at a time, so an app with storage runs
				<strong>one replica</strong> and each deploy has brief <strong>downtime</strong> —
				the old pod stops before the new one starts, rather than overlapping.
			</p>
		</div>
	</div>
	<div class="panel mb-5">
		<div class="panel-header"><span class="panel-title">Volumes</span></div>
		if len(d.App.Volumes) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No storage</p>
				<p>Anything this app writes is lost when its pod restarts.</p>
			</div>
		} else {
			<div class="table-scroll">
			<table class="dtable min-w-[760px]">
				<thead>
					<tr><th>Name</th><th>Mounted at</th><th>Size</th><th class="text-right">Actions</th></tr>
				</thead>
				<tbody>
					for _, v := range d.App.Volumes {
						<tr>
							<td class="mono">{ v.Name }</td>
							<td class="mono">{ v.MountPath }</td>
							<td class="tabular-nums">{ gigabytes(v.SizeBytes) } GB</td>
							<td class="text-right">
								<div class="flex justify-end gap-2">
									<form method="post" action={ templ.SafeURL("/apps/" + d.App.Name + "/storage/" + v.Name + "/resize") } class="flex items-center gap-1.5">
										<input class="control w-20 !py-1 !text-[12px]" name="size_gb" type="number" min="1" max="1024" value={ gigabytes(v.SizeBytes) }/>
										<button class="btn btn-sm" type="submit">Grow</button>
									</form>
									<form method="post" action={ templ.SafeURL("/apps/" + d.App.Name + "/storage/" + v.Name + "/delete") } class="flex items-center gap-1.5">
										<input class="control w-28 !py-1 !text-[12px]" name="confirm" placeholder={ v.Name } aria-label="Type the volume name to confirm"/>
										<button class="btn btn-sm btn-danger" type="submit">Delete</button>
									</form>
								</div>
							</td>
						</tr>
					}
				</tbody>
			</table>
			</div>
			<div class="panel-body border-t">
				<p class="text-muted-foreground">
					A volume can grow but never shrink — Kubernetes cannot shrink a claim,
					and the filesystem on it may be full. Deleting one destroys what it
					holds, so its name has to be typed back.
				</p>
			</div>
		}
	</div>
	<div class="panel">
		<div class="panel-header"><span class="panel-title">Add a volume</span></div>
		<div class="panel-body">
			<form method="post" action={ templ.SafeURL("/apps/" + d.App.Name + "/storage") } class="flex flex-wrap items-end gap-4">
				<div class="field">
					<label class="label" for="vol-name">Name</label>
					<input class="control" id="vol-name" name="name" required placeholder="data"/>
				</div>
				<div class="field grow">
					<label class="label" for="vol-mount">Mount path</label>
					<input class="control mono" id="vol-mount" name="mount_path" required placeholder="/var/lib/data"/>
				</div>
				<div class="field">
					<label class="label" for="vol-size">Size (GB)</label>
					<input class="control w-24" id="vol-size" name="size_gb" type="number" min="1" max="1024" value="1"/>
				</div>
				<button class="btn btn-primary" type="submit">Attach</button>
			</form>
		</div>
	</div>
}

templ backToSources() {
	<a class="btn btn-ghost" href="/apps/new">Change source</a>
}
