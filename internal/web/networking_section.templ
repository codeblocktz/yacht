package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"
)

// NetworkingSection is an app's networking as Railway draws it in a
// service's settings: public networking — the platform's domain, with
// Generate Domain, and the custom domains beside it — then private networking,
// then the TCP proxy.
//
// One component taking only NetworkingData, so whichever tab holds it places
// it with one line: today the Domains tab, and Settings once the two are
// folded together. Its forms post the tab back, and come back to it.
templ NetworkingSection(d NetworkingData) {
	<section id="networking" aria-label="Networking">
		@publicDomainPanel(d)
		@customDomains(d)
		@privateNetworking(d)
		@tcpProxyPanel(d)
	</section>
}

// tabField sends the tab a form was posted from, so the answer comes back to
// it.
templ tabField(d NetworkingData) {
	<input type="hidden" name="tab" value={ d.returnTab() }/>
}

templ publicDomainPanel(d NetworkingData) {
	{{ pub := d.Net.Public }}
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Public networking</span>
		</div>
		<div class="panel-body">
			if host := d.publicHost(); host != "" {
				<div class="rows rounded-md border border-border">
					<div class="row-item">
						@icon("globe")
						<span class="min-w-0 flex-1">
							<a
								class="mono block truncate hover:underline"
								href={ templ.URL("https://" + host) }
								target="_blank"
								rel="noreferrer"
							>{ host }</a>
							<span class="block text-muted-foreground">
								if pub.Port > 0 {
									&rarr; port <span class="mono">{ strconv.Itoa(int(pub.Port)) }</span> &middot;
								}
								if pub.Host != "" && !pub.Generated {
									Issued when the app was created; it stays until you change it
								} else {
									Generated by the platform
								}
							</span>
							if pub.Host != "" && !pub.Routed {
								// Said, because a name that no longer answers looks
								// exactly like one that is broken.
								<span class="block text-muted-foreground">
									Not answering: this app has no port, or is internal. It keeps
									the name, and answers on it again once it has a port and is public.
								</span>
							}
							if d.UntrustedCert {
								// Said here rather than left to the browser. The warning
								// somebody gets names the certificate; it does not say
								// that the install has none configured, which is the
								// part they can do something about.
								<span class="block text-muted-foreground">
									Served over https from the ingress controller's default
									certificate, which browsers will not trust. Configure a
									wildcard certificate for this app domain, or turn off
									Enforce HTTPS below to serve it on plain http.
								</span>
							}
						</span>
						@copyButton(host, "domain")
						if pub.Host == "" || pub.Routed {
							<span class="status status-ok">active</span>
						} else {
							<span class="status status-warn">not routed</span>
						}
					</div>
				</div>
				if pub.Host != "" && pub.Unavailable == "" {
					@publicDomainEdit(d)
				}
			} else if pub.Unavailable != "" {
				<div class="empty">
					<p class="font-medium text-foreground">No public domain</p>
					<p>{ pub.Unavailable }</p>
				</div>
			} else {
				@generateDomainForm(d)
			}
		</div>
	</div>
}

// generateDomainForm is Generate Domain, with the port its traffic goes to.
//
// The port is asked for here, as Railway asks, because a domain sent to a port
// nothing listens on is the commonest way a first deploy looks broken: the app
// is running, and every request to it is a gateway error.
templ generateDomainForm(d NetworkingData) {
	{{ pub := d.Net.Public }}
	<div class="empty mb-3">
		<p class="font-medium text-foreground">Not on the internet yet</p>
		<p>
			Generate a domain to reach this app from a browser. It will be
			if pub.Domain != "" {
				<span class="mono">{ pub.Suggested }.{ pub.Domain }</span>,
			}
			or that with a few characters added if the name is taken.
		</p>
	</div>
	<form
		method="post"
		action={ templ.URL("/apps/" + d.App + "/networking/domain/generate") }
		class="flex flex-wrap items-end gap-3"
	>
		@tabField(d)
		@portPicker("generate-port", pub)
		<button class="btn btn-primary" type="submit">Generate Domain</button>
	</form>
}

// publicDomainEdit is "Update your domain or target port", folded away until
// it is wanted, with taking the domain away beside it.
templ publicDomainEdit(d NetworkingData) {
	{{ pub := d.Net.Public }}
	<div class="mt-3 flex flex-wrap items-start gap-2">
		<details class="min-w-0 flex-1" data-public-domain-edit>
			<summary class="btn btn-sm w-fit">Edit domain or port</summary>
			<form
				method="post"
				action={ templ.URL("/apps/" + d.App + "/networking/domain") }
				class="mt-3 flex flex-col gap-3"
			>
				@tabField(d)
				<div class="field">
					<label class="label" for="public-label">Domain</label>
					<div class="flex items-center gap-2">
						<input
							class="control mono min-w-0 flex-1"
							id="public-label"
							name="label"
							value={ pub.Label }
							maxlength="63"
							pattern="[a-z0-9]([a-z0-9\-]*[a-z0-9])?"
							autocapitalize="off"
							spellcheck="false"
							required
						/>
						<span class="mono shrink-0 text-muted-foreground">.{ pub.Domain }</span>
					</div>
					<div class="mt-1 text-[12.5px] text-muted-foreground">
						Lowercase letters, numbers and dashes, up to 63.
						if !pub.Generated {
							This app's address is under the domain itself, from before
							addresses were generated; a new name moves it under
							<span class="mono">{ pub.Domain }</span>, and the old one stops
							answering. Leave the name as it is to change only the port.
						}
					</div>
				</div>
				@portPicker("public-port", pub)
				<div>
					<button class="btn btn-primary btn-sm" type="submit">Update</button>
				</div>
			</form>
		</details>
		<form
			method="post"
			action={ templ.URL("/apps/" + d.App + "/networking/domain/delete") }
			data-confirm="The app stops answering at this address, and the name is free for anyone to take."
			data-confirm-title="Remove this domain?"
			data-confirm-label="Remove domain"
		>
			@tabField(d)
			<button class="btn btn-ghost btn-sm" type="submit">Remove</button>
		</form>
	</div>
}

// portPicker is the target port, with the ports the app is known to listen on
// offered beside it — buttons rather than a datalist, for the reasons
// BranchOptions gives.
templ portPicker(id string, pub app.PublicDomain) {
	<div class="field">
		<label class="label" for={ id }>Target port</label>
		<input
			class="control mono w-[120px]"
			id={ id }
			name="port"
			type="number"
			min="1"
			max="65535"
			inputmode="numeric"
			value={ portValue(pub) }
			required
		/>
		if len(pub.Suggestions) > 1 {
			<div class="mt-1.5 flex flex-wrap items-center gap-1.5 text-[12px] text-muted-foreground">
				<span>Listening on:</span>
				for _, p := range pub.Suggestions {
					<button
						class="tag mono cursor-pointer hover:border-foreground/40 hover:text-foreground"
						type="button"
						data-port={ strconv.Itoa(int(p)) }
						data-port-for={ id }
						onclick="(function(el){document.getElementById(el.dataset.portFor).value=el.dataset.port;})(this)"
					>{ strconv.Itoa(int(p)) }</button>
				}
			</div>
		}
	</div>
}

// privateNetworking is where other apps reach this one.
templ privateNetworking(d NetworkingData) {
	{{ priv := d.Net.Private }}
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Private networking</span>
		</div>
		<div class="panel-body">
			if priv.Host == "" {
				<div class="empty">
					<p>Where other apps reach this one appears once it has been read from the cluster.</p>
				</div>
			} else {
				<div class="record">
					@recordRow("Host", priv.Host)
					if priv.Port > 0 {
						@recordRow("Port", strconv.Itoa(int(priv.Port)))
					}
				</div>
				<div class="mt-3 text-[12.5px] text-muted-foreground">
					if priv.Port > 0 {
						Your team's other apps reach this one here, inside the cluster, and
						nothing outside it can. In a variable, write
						<code class="mono">{ "${{" + d.App + "." + app.RefPrivateHost + "}}" }</code> and
						<code class="mono">{ "${{" + d.App + "." + app.RefPrivatePort + "}}" }</code>
						so it follows if this ever changes.
					} else {
						This app has no port, so nothing can connect to it. Set one in its
						settings and other apps reach it here.
					}
				</div>
			}
		</div>
	</div>
}

// tcpProxyPanel is the app's public TCP port, for what does not speak HTTP.
templ tcpProxyPanel(d NetworkingData) {
	{{ proxy := d.Net.TCPProxy }}
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">TCP proxy</span>
		</div>
		<div class="panel-body">
			switch {
				case !proxy.Available:
					<div class="empty">
						<p class="font-medium text-foreground">Not offered on this install</p>
						<p>
							A TCP proxy reaches a database or anything else that does not speak
							HTTP from outside the cluster. Whoever runs this install turns them
							on with YACHT_TCP_PROXY_HOST.
						</p>
					</div>
				case proxy.Port > 0:
					<div class="record">
						@recordRow("Address", proxy.Address())
						@recordRow("Target", strconv.Itoa(int(proxy.Target)))
					</div>
					<div class="mt-3 flex flex-wrap items-center gap-3">
						<p class="min-w-0 flex-1 text-[12.5px] text-muted-foreground">
							Open to the whole internet: the app's own password is what keeps
							people out. The address stays the same until the proxy is removed.
						</p>
						<form
							method="post"
							action={ templ.URL("/apps/" + d.App + "/networking/tcp-proxy/delete") }
							data-confirm="Connections from outside the cluster stop reaching the app, and the port may be given to another app."
							data-confirm-title="Remove the TCP proxy?"
							data-confirm-label="Remove proxy"
						>
							@tabField(d)
							<button class="btn btn-ghost btn-sm" type="submit">Remove</button>
						</form>
					</div>
				case proxy.Target == 0:
					<div class="empty">
						<p>This app has no port for a proxy to reach. Set one in its settings first.</p>
					</div>
				default:
					<div class="flex flex-wrap items-center gap-3">
						<p class="min-w-0 flex-1 text-[12.5px] text-muted-foreground">
							Reach port <span class="mono">{ strconv.Itoa(int(proxy.Target)) }</span> from
							outside the cluster at <span class="mono">{ proxy.Host }</span> on a port
							of its own — a database from your laptop, say. Anyone can connect to it.
						</p>
						<form method="post" action={ templ.URL("/apps/" + d.App + "/networking/tcp-proxy") }>
							@tabField(d)
							<button class="btn btn-sm" type="submit">Add TCP proxy</button>
						</form>
					</div>
			}
		</div>
	</div>
}
