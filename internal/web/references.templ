package web

import (
	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/web/ui/selectbox"
)

// variableReference shows what a reference points at, each part a link to
// the app it names, and the text as typed underneath for whoever wants to
// write one by hand.
templ variableReference(v app.Variable) {
	<span class="flex flex-col gap-1">
		<span class="flex flex-wrap items-center gap-1.5">
			for _, r := range v.Refs() {
				if r.App == app.SharedScope {
					// A project's shared variable has no app to link to; it
					// lives under Project Settings.
					<span class="ref-chip" title="A shared variable, set under Project Settings">
						@icon("layers")
						<span>shared</span>
						<span class="text-muted-foreground">·</span>
						<span>{ r.Key }</span>
					</span>
				} else {
					<a class="ref-chip" href={ templ.URL("/apps/" + r.App + "/variables") } title={ "From " + r.App }>
						@icon("link")
						<span>{ r.App }</span>
						<span class="text-muted-foreground">·</span>
						<span>{ r.Key }</span>
					</a>
				}
			}
		</span>
		<span class="truncate text-[11.5px] text-muted-foreground">{ v.Value }</span>
	</span>
}

// addReference is the Railway move: pick another app's variable, and this
// app gets it — kept in step, resolved at each deploy, drawn as an arrow on
// the canvas. Nothing is copied, so a password typed once on the database
// is the only copy of it.
templ addReference(d AppDetailData) {
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Add a reference</span>
			<span class="text-[12px] text-muted-foreground">From another app</span>
		</div>
		<div class="panel-body">
			if d.Vars.Failed == variableFormRef {
				@variableRefusal(d.Error)
			}
			<form
				method="post"
				action={ templ.SafeURL("/apps/" + d.App.Name + "/variables") }
				hx-post={ "/apps/" + d.App.Name + "/variables" }
				hx-target="#variables-tab"
				hx-swap="outerHTML"
				data-swap-refusal
				class="flex flex-wrap items-end gap-4"
			>
				<div class="field grow">
					<label class="label" for="var-ref">Variable</label>
					@selectbox.SelectBox(selectbox.Props{Class: "w-full min-w-[260px]"}) {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "var-ref", Name: "ref"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose an app's variable"})
						}
						@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Search variables"}) {
							for _, t := range d.RefTargets {
								for _, k := range t.Keys {
									@selectbox.Item(selectbox.ItemProps{Value: t.App + "." + k.Key}) {
										if t.App == app.SharedScope {
											<span>Shared</span>
										} else {
											<span class="mono">{ t.App }</span>
										}
										<span class="text-muted-foreground"> · </span>
										<span class="mono">{ k.Key }</span>
									}
								}
							}
						}
					}
				</div>
				<div class="field">
					<label class="label" for="ref-key">As</label>
					<input class="control mono" id="ref-key" name="key" placeholder="Same name"/>
				</div>
				<button class="btn btn-primary" type="submit">Add</button>
			</form>
			<p class="mt-3 text-[12px] text-muted-foreground">
				Stored as <code class="mono">{ "${{app.KEY}}" }</code> and read when this app deploys, so it follows
				the other app's value — redeploy this one after that changes. A secret stays secret. The
				project's shared variables are <code class="mono">{ "${{shared.KEY}}" }</code>, set under Project Settings.
				<code class="mono">PRIVATE_HOST</code> and <code class="mono">PRIVATE_PORT</code> are where an
				app is reached inside the cluster.
			</p>
		</div>
	</div>
}

// referrersWarning lists, above a delete, the variables of other services
// that refer to the one being deleted. Railway warns the same way; without
// it the delete went through quietly and the other app's Variables went on
// showing the reference as though it were good.
templ referrersWarning(refs []app.Referrer) {
	if len(refs) > 0 {
		<div class="callout callout-warn mt-3" data-referrers>
			<div class="min-w-0">
				<div class="font-medium">Other services refer to this one</div>
				<p class="mt-0.5 text-muted-foreground">
					These variables stop resolving, and each service's next deploy fails until they are changed:
				</p>
				<ul class="mt-1.5 space-y-0.5">
					for _, r := range refs {
						<li>
							<a class="mono hover:underline" href={ templ.URL("/apps/" + r.App + "/variables") }>{ r.App } · { r.Key }</a>
						</li>
					}
				</ul>
			</div>
		</div>
	}
}
