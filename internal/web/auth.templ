package web

// SignInData is the state of the sign-in form.
//
// Error is what the visitor did wrong or what the server refused, never
// anything about whether the address is registered — that is the one fact this
// page exists to keep quiet about.
type SignInData struct {
	Email string
	Error string
}

templ SignIn(d SignInData) {
	@authCard("Sign in", "Enter your address and we will send you a link. There is no password to remember.") {
		if d.Error != "" {
			<div class="callout callout-err mb-4">
				<div>{ d.Error }</div>
			</div>
		}
		<form method="post" action="/sign-in" class="flex flex-col gap-4">
			<div class="field">
				<label class="label" for="email">Email</label>
				<input
					class="control"
					id="email"
					name="email"
					type="email"
					autocomplete="email"
					autofocus
					required
					value={ d.Email }
					placeholder="you@example.com"
				/>
			</div>
			<button class="btn btn-primary" type="submit">Email me a sign-in link</button>
		</form>
	}
}

// CheckMail takes no data on purpose.
//
// It carries neither the address nor anything derived from it, so the response
// to a registered address and to an unregistered one is the same bytes. A page
// that said "we sent a link to alice@example.com" would only need to say it
// once, for an address that exists, to become the disclosure this whole flow
// avoids.
templ CheckMail() {
	@authCard("Check your mail",
		"If that address has an account, a sign-in link is on its way.") {
		<p class="text-[12.5px] text-muted-foreground">
			The link works once and expires shortly. You can close this page.
		</p>
		<p class="mt-4 text-[12.5px]">
			<a class="text-muted-foreground hover:text-foreground" href="/sign-in">
				Use a different address
			</a>
		</p>
	}
}

// authCard is the frame the signed-out pages share: centred, narrow, and
// without the chrome of a dashboard nobody has been let into yet.
templ authCard(title, subtitle string) {
	<div class="mx-auto w-full max-w-[380px] py-12">
		<div class="mb-5">
			<h1 class="text-[19px] font-semibold tracking-tight">{ title }</h1>
			if subtitle != "" {
				<p class="mt-1 text-[12.5px] text-muted-foreground">{ subtitle }</p>
			}
		</div>
		<div class="panel">
			<div class="panel-body">
				{ children... }
			</div>
		</div>
	</div>
}
