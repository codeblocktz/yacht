package web

import (
	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/domain"
)

// NetworkingData is the app's routing panel.
type NetworkingData struct {
	App string
	Net app.Networking

	// UntrustedCert means this app is served over https with a certificate
	// nobody will trust, because the install has no wildcard certificate.
	UntrustedCert bool

	// ResolverName is which resolver answered the last check.
	//
	// Shown because "this name does not resolve" is one resolver's opinion, and
	// somebody comparing it against their own dig output needs to know whether
	// the two asked the same server.
	ResolverName string

	// Settled reports that no domain here is still moving, which is what stops
	// the polling fragment asking again.
	Settled bool

	Notice string
	Error  string
}

// customDomainURL is where the hostname links to.
//
// http unless the app is HTTPS-only, and deliberately not https-by-default: no
// certificate covers a brought domain, so an https link is one that fails in the
// browser. Sending somebody to a scheme that works is better than sending them
// to the one we wish worked.
func customDomainURL(d NetworkingData, c domain.Custom) string {
	if d.Net.HTTPSOnly {
		return "https://" + c.Host
	}
	return "http://" + c.Host
}

templ publicNetworking(d NetworkingData) {
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Public networking</span>
		</div>
		<div class="panel-body">
			if d.Net.Managed == "" {
				<div class="empty">
					<p class="font-medium text-foreground">No platform hostname</p>
					<p>
						An app gets one when it has a port and is not internal, and when
						the install has an app domain configured.
					</p>
				</div>
			} else {
				<div class="rows rounded-md border border-border">
					<div class="row-item">
						@icon("external")
						<span class="min-w-0 flex-1">
							<a
								class="mono block truncate hover:underline"
								href={ templ.URL("https://" + d.Net.Managed) }
								target="_blank"
								rel="noreferrer"
							>{ d.Net.Managed }</a>
							<span class="block text-muted-foreground">
								Issued by the platform &middot; resolves through the wildcard record
							</span>
							if d.UntrustedCert {
								// Said here rather than left to the browser. The warning
								// somebody gets names the certificate; it does not say
								// that the install has none configured, which is the
								// part they can do something about.
								<span class="block text-muted-foreground">
									Served over https from the ingress controller's default
									certificate, which browsers will not trust. Configure a
									wildcard certificate for this app domain, or turn off
									Enforce HTTPS below to serve it on plain http.
								</span>
							}
						</span>
						<span class="status status-ok">active</span>
					</div>
				</div>
			}
		</div>
	</div>
}

templ customDomains(d NetworkingData) {
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Custom domains</span>
		</div>
		<div class="panel-body">
			if d.Net.Target == "" {
				// Said instead of showing a form that cannot work. A domain
				// added with nothing to point it at could never be verified.
				<div class="empty">
					<p class="font-medium text-foreground">No CNAME target is configured</p>
					<p>
						A custom domain has to point somewhere. An owner sets that once for
						the whole install under Infrastructure &rsaquo; DNS.
					</p>
				</div>
			} else {
				@CustomDomainList(d)
				<form method="post" action={ templ.URL("/apps/" + d.App + "/domains") } class="mt-4 flex flex-wrap items-end gap-3">
					<div class="field min-w-[260px] flex-1">
						<label class="label" for="host">Add custom domain</label>
						<input
							class="control"
							id="host"
							name="host"
							placeholder="shop.example.com"
							required
						/>
					</div>
					<button class="btn btn-primary" type="submit">Add</button>
				</form>
				// A div rather than a p, because the popover's content is a div
				// and a div inside a p makes the browser close the paragraph
				// early — which drops the trigger onto its own line.
				<div class="mt-3 text-[12.5px] text-muted-foreground">
					Add the name and Yacht shows you the record to create, then proves it
					itself — there is nothing to come back and press.
					@helpNote("how verification works") {
						<p>
							Nothing is routed until the record resolves. Until then the
							domain is a claim, and anyone who proves they control it can
							take it instead.
						</p>
						<p class="mt-2">
							An apex domain cannot carry a CNAME. Use whatever your provider
							calls a flattened ALIAS or ANAME — verification compares
							addresses, so any of them is accepted.
						</p>
					}
				</div>
			}
		</div>
	</div>
}

// CustomDomainList is the polled half: every claim and how far it has got.
//
// It renders the element carrying its own polling trigger, and the fragment
// endpoint returns this same component with hx-swap="outerHTML". That is what
// makes the poll self-stopping: once every domain has settled the replacement
// markup carries no trigger, and htmx has nothing left to fire. Swapping only
// the inside would leave the trigger on a wrapper it never replaces, asking
// forever.
//
// Polled separately from the tab so a request every three seconds does not
// re-render the add-domain form under somebody typing a hostname into it.
templ CustomDomainList(d NetworkingData) {
	<div
		id="custom-domains"
		hx-get={ "/apps/" + d.App + "/domains/fragment" }
		hx-swap="outerHTML"
		if !d.Settled {
			hx-trigger="every 3s"
		}
		aria-busy={ boolAttr(!d.Settled) }
	>
		if len(d.Net.Custom) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No custom domains</p>
				<p>Add one below to serve this app on a name you own.</p>
			</div>
		} else {
			<div class="flex flex-col gap-3">
				for _, c := range d.Net.Custom {
					@customDomainCard(d, c)
				}
			</div>
		}
	</div>
}

templ customDomainCard(d NetworkingData, c domain.Custom) {
	<div class="rounded-md border border-border">
		<div class="flex flex-wrap items-center gap-3 border-b border-border px-4 py-3">
			@icon("globe")
			<span class="min-w-0 flex-1">
				<a
					class="mono block truncate hover:underline"
					href={ templ.URL(customDomainURL(d, c)) }
					target="_blank"
					rel="noreferrer"
				>{ c.Host }</a>
			</span>
			{{ label, class := domainStatus(c) }}
			<span class={ "status", class }>{ label }</span>
			<form method="post" action={ templ.URL("/apps/" + d.App + "/domains/" + c.ID.String() + "/verify") }>
				<button class="btn btn-sm" type="submit">Check now</button>
			</form>
			<form
				method="post"
				action={ templ.URL("/apps/" + d.App + "/domains/" + c.ID.String() + "/delete") }
				data-confirm="Traffic for this domain stops being routed to the app."
				data-confirm-title="Remove this domain?"
				data-confirm-label="Remove domain"
			>
				<button class="btn btn-ghost btn-sm" type="submit">Remove</button>
			</form>
		</div>
		<div class="px-4 py-3">
			@stepList(domainSteps(c, d.Net.HTTPSOnly))
			// The record stays on screen while it is still the thing to do.
			// Hiding it the moment a domain goes live is right; hiding it while
			// somebody is trying to get the record correct is not.
			if !c.State.Routable() {
				<div class="mt-4">
					<div class="micro mb-2">Create this record</div>
					@recordTable(domainRecord(c.Host, c.Target))
					<div class="mt-2 text-[11.5px] text-muted-foreground">
						Name is the part before your own domain, which is what most
						providers ask for.
						@helpNote("the record's name field") {
							<p>
								Some providers want the full hostname here instead, and a
								few fill your domain in for you. If pasting
								<code class="mono">{ c.Host }</code> produces something like
								<code class="mono">{ c.Host }.{ c.Host }</code> in their list,
								they wanted just the part shown above.
							</p>
						}
					</div>
				</div>
			}
			@domainCheckLine(c, d.ResolverName)
		</div>
	</div>
}

// domainCheckLine says when this was last looked at and when it will be again.
//
// Without it a page that is quietly working is indistinguishable from one that
// has stopped, and the reader's only recourse is to press the button — which is
// exactly the behaviour the background checker exists to remove.
templ domainCheckLine(c domain.Custom, resolver string) {
	<div class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 border-t border-border pt-3 text-[11.5px] text-muted-foreground">
		if c.LastCheckedAt.IsZero() {
			<span>Not checked yet</span>
		} else {
			<span title={ absoluteTime(c.LastCheckedAt) }>
				Checked { preciseAgo(c.LastCheckedAt) }
			</span>
		}
		if !c.State.Settled() && !c.NextCheckAt.IsZero() {
			<span class="text-border">&middot;</span>
			<span title={ absoluteTime(c.NextCheckAt) }>next { untilTime(c.NextCheckAt) }</span>
		}
		if resolver != "" {
			<span class="text-border">&middot;</span>
			<span>asked { resolver }</span>
		}
	</div>
}

templ routingOptions(d NetworkingData) {
	<div class="panel mb-5">
		<div class="panel-header">
			<span class="panel-title">Routing</span>
		</div>
		<div class="panel-body">
			<form method="post" action={ templ.URL("/apps/" + d.App + "/networking") } class="flex flex-col gap-4">
				<label class="flex items-start gap-2.5">
					<input
						type="checkbox"
						name="https_only"
						class="mt-0.5"
						checked?={ d.Net.HTTPSOnly }
					/>
					<span class="min-w-0">
						<span class="block font-medium">Enforce HTTPS</span>
						<span class="block text-[12.5px] text-muted-foreground">
							Routes through the ingress controller's secure entrypoint only, so
							a request arriving on plain HTTP is not served rather than served
							and redirected.
						</span>
					</span>
				</label>
				<label class="flex items-start gap-2.5">
					<input
						type="checkbox"
						name="cname_only"
						class="mt-0.5"
						checked?={ d.Net.CNAMEOnly }
					/>
					<span class="min-w-0">
						<span class="block font-medium">Publish a CNAME, never node addresses</span>
						<span class="block text-[12.5px] text-muted-foreground">
							Tells ExternalDNS to target
							if d.Net.Target != "" {
								<code class="mono">{ d.Net.Target }</code>
							} else {
								the platform
							}
							rather than publishing this cluster's node addresses as A records.
							Yacht does not run ExternalDNS; if none is installed this changes
							nothing.
						</span>
					</span>
				</label>
				<div>
					<button class="btn btn-primary" type="submit">Save</button>
				</div>
			</form>
		</div>
	</div>
}

// PlatformDNS is the install-wide DNS configuration.
templ PlatformDNS(d PlatformDNSData) {
	@pageHead("DNS",
		"How this install publishes hostnames. One controller, one setting — not per app.", nil)
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">
				<div class="font-medium">That did not work</div>
				<p class="mt-0.5 text-muted-foreground">{ d.Error }</p>
			</div>
		</div>
	}
	<div class="panel mb-5">
		<div class="panel-body">
			<form method="post" action="/cluster/dns" class="flex flex-col gap-4">
				<div class="field">
					<label class="label" for="cname_target">CNAME target</label>
					<input
						class="control"
						id="cname_target"
						name="cname_target"
						value={ d.DNS.CNAMETarget }
						placeholder="edge.yourplatform.com"
					/>
					<p class="mt-1 text-[12.5px] text-muted-foreground">
						What a customer points their CNAME at, and what ExternalDNS is told
						to target so it publishes a CNAME instead of this cluster's node
						addresses. Leave it empty to switch custom domains off: without a
						target there is nothing a claim could be verified against.
					</p>
				</div>
				<div class="field">
					<label class="label" for="txt_prefix">DNS ownership prefix</label>
					<input
						class="control"
						id="txt_prefix"
						name="txt_prefix"
						value={ d.DNS.TXTPrefix }
						placeholder="extdns-"
					/>
					<p class="mt-1 text-[12.5px] text-muted-foreground">
						Keeps the ownership record off the name it owns, which is what lets
						an apex domain work at all. It must match
						<code class="mono">--txt-prefix</code> on your ExternalDNS
						controller.
					</p>
					<p class="mt-1 text-[12.5px] text-muted-foreground">
						Recorded here, not applied. Yacht does not deploy that controller and
						cannot set a flag on it — this is so the two can be kept in step, and
						so the value is written down somewhere other than a shell history.
					</p>
				</div>
				<div>
					<button class="btn btn-primary" type="submit">Save</button>
				</div>
			</form>
		</div>
	</div>
	if d.DNS.UpdatedAt != "" {
		<p class="text-[12.5px] text-muted-foreground">Updated { d.DNS.UpdatedAt }.</p>
	}
}
