package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/web/ui/selectbox"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// AppLogs is the log pane for one app.
templ AppLogs(d LogsData) {
	@pageHead(d.App+" logs", "Output from the running container.", backToDeployments(d.App))
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	<div class="panel mb-5">
		<div class="panel-body">
			<form method="get" action={ templ.URL("/apps/" + d.App + "/logs") } class="flex flex-wrap items-end gap-3">
				if len(d.Logs.Pods) > 1 {
					<div class="field min-w-[220px]">
						<label class="label" for="pod">Pod</label>
						// Searchable, unlike the others: a replica set's pod names differ
						// only in a random suffix, so a list of twenty is read by typing
						// rather than by looking.
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "pod", Name: "pod"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "Choose a pod"})
							}
							@selectbox.Content(selectbox.ContentProps{SearchPlaceholder: "Filter pods"}) {
								for _, pod := range d.Logs.Pods {
									@selectbox.Item(selectbox.ItemProps{
										Value: pod, Selected: pod == d.Logs.Pod,
									}) {
										{ pod }
									}
								}
							}
						}
					</div>
				} else if d.Logs.Pod != "" {
					<div class="field">
						<span class="label">Pod</span>
						<span class="mono text-[12.5px] text-muted-foreground">{ d.Logs.Pod }</span>
					</div>
				}
				<label class="flex items-center gap-2 text-[12.5px]">
					<input type="checkbox" name="previous" value="1" checked?={ d.Previous }/>
					Previous run
				</label>
				<button class="btn" type="submit">Apply</button>
			</form>
			<p class="mt-2 text-[12.5px] text-muted-foreground">
				Previous run reads the container that died rather than the one running
				now. After a crash loop it is the only place the reason survives — the
				running container started after it.
			</p>
		</div>
	</div>
	// Polled on its own so following a log does not re-render the controls
	// under a cursor that is halfway through changing them.
	<div
		hx-get={ logsFragmentHref(d) }
		hx-trigger="load, every 5s"
		hx-swap="innerHTML"
	>
		@AppLogLines(d)
	</div>
}

// AppLogLines is the polled body.
templ AppLogLines(d LogsData) {
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">
				if d.Previous {
					Previous run
				} else {
					Output
				}
			</span>
			<span class="text-muted-foreground tabular-nums">
				{ plural(len(d.Logs.Lines), "line") }
			</span>
		</div>
		if len(d.Logs.Lines) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">Nothing to show</p>
				if d.Logs.Note != "" {
					<p>{ d.Logs.Note }</p>
				}
			</div>
		} else {
			<div class="logs">
				for _, l := range d.Logs.Lines {
					<div class="log-line">
						if !l.At.IsZero() {
							<span class="log-time">{ l.At.Format("15:04:05") }</span>
						}
						<span class="log-text">{ l.Text }</span>
					</div>
				}
			</div>
		}
	</div>
}

templ backToDeployments(name string) {
	<a class="btn" href={ templ.URL("/apps/" + name) }>Back to deployments</a>
}

// DeployLogPanel is one deployment's logs, shown in a sheet over the list.
templ DeployLogPanel(d DeployLogsData) {
	@sheet.Header(sheet.HeaderProps{Class: "canvas-sheet-head"}) {
		@sheet.Title() {
			<span class="flex min-w-0 items-center gap-2.5">
				<span class="mono truncate">{ d.Deploy.Deployment.Revision }</span>
				@deploymentStatus(d.Deploy.Deployment)
			</span>
		}
		@sheet.Description() {
			<span class="mono truncate">{ d.Deploy.Deployment.Image }</span>
		}
	}
	@deployLogTabs(d)
	if d.Error != "" {
		<div class="canvas-sheet-body">
			<div class="callout callout-err">
				<div class="min-w-0">{ d.Error }</div>
			</div>
		</div>
	} else {
		switch d.View {
			case viewBuild:
				@buildLogView(d)
			case viewHTTP:
				@httpLogView(d)
			default:
				@deployLogView(d)
		}
	}
}

// deployLogTabs picks which log is showing.
//
// Named for what wrote the output, because that is the question behind opening
// them: a deploy that never served traffic failed either to build or to start,
// and those are different logs in different places.
templ deployLogTabs(d DeployLogsData) {
	<nav class="tabs canvas-sheet-tabs">
		@deployLogTab(d, viewDeploy, "Deploy logs")
		@deployLogTab(d, viewBuild, "Build logs")
		@deployLogTab(d, viewHTTP, "HTTP logs")
	</nav>
}

templ deployLogTab(d DeployLogsData, view, label string) {
	<a
		class={ "tab", templ.KV("tab-active", d.View == view) }
		href="#"
		hx-get={ deployViewHref(d, view) }
		hx-target="#deploy-log-panel"
		hx-swap="innerHTML"
	>{ label }</a>
}

templ deployLogView(d DeployLogsData) {
	if !d.Deploy.Live {
		// Said rather than filled with the live log under an old revision's
		// heading. That would look like history and be the current output.
		<div class="canvas-sheet-body">
			<div class="empty">
				<p class="font-medium text-foreground">No logs for this deployment</p>
				<p>{ d.Deploy.Logs.Note }</p>
			</div>
		</div>
	} else {
		<div class="canvas-sheet-actions">
			<a
				class={ "btn btn-sm", templ.KV("btn-primary", !d.Previous) }
				href="#"
				hx-get={ deployLogsHref(d, false) }
				hx-target="#deploy-log-panel"
				hx-swap="innerHTML"
			>This run</a>
			<a
				class={ "btn btn-sm", templ.KV("btn-primary", d.Previous) }
				href="#"
				hx-get={ deployLogsHref(d, true) }
				hx-target="#deploy-log-panel"
				hx-swap="innerHTML"
			>Previous run</a>
			<span class="text-[12px] text-muted-foreground tabular-nums">
				{ plural(len(d.Deploy.Logs.Lines), "line") }
			</span>
		</div>
		<div class="canvas-sheet-actions">
			@findBox(d, viewDeploy)
		</div>
		if len(d.Deploy.Logs.Lines) == 0 {
			<div class="canvas-sheet-body">
				<div class="empty">
					<p class="font-medium text-foreground">Nothing to show</p>
					if d.Deploy.Logs.Note != "" {
						<p>{ d.Deploy.Logs.Note }</p>
					}
				</div>
			</div>
		} else {
			// Its own scrolling region, filling what the header and tabs leave.
			// The .logs cap that suits a panel on a page would put a short block
			// with its own scrollbar inside a sheet that scrolls as well.
			<div class="canvas-sheet-log">
				<div class="logs">
					for _, l := range d.Deploy.Logs.Lines {
						<div class="log-line">
							if !l.At.IsZero() {
								<span class="log-time">{ l.At.Format("15:04:05") }</span>
							}
							<span class="log-text">
								@highlight(l.Text, d.Find)
							</span>
						</div>
					}
				</div>
			</div>
		}
	}
}

// buildLogView shows what the build wrote, or says why there is nothing.
//
// This is the one log Yacht keeps. A build is bounded and there is exactly one
// per deploy, so it is stored — which is why this tab still answers for a
// deployment replaced weeks ago, and the deploy log cannot.
templ buildLogView(d DeployLogsData) {
	if !d.HasBuild {
		<div class="canvas-sheet-body">
			<div class="empty">
				<p class="font-medium text-foreground">Nothing was built</p>
				<p>
					This app runs an image that already existed, so this deploy pulled it
					and started it. Only an app deployed from a repository has a build.
				</p>
			</div>
		</div>
	} else {
		<div class="canvas-sheet-actions">
			@buildStatus(d.Build)
			if d.Build.CommitSHA != "" {
				<span class="mono text-[12px] text-muted-foreground">
					{ shortSHA(d.Build.CommitSHA) }
				</span>
			}
			<span class="min-w-0 flex-1 truncate text-[12px] text-muted-foreground">
				{ d.Build.RepoURL } &middot; { d.Build.RepoRef }
			</span>
		</div>
		if d.Build.Message != "" {
			<div class="canvas-sheet-body !pb-0">
				<div class="callout callout-err">
					<div class="min-w-0">{ d.Build.Message }</div>
				</div>
			</div>
		}
		if d.Build.Log == "" {
			<div class="canvas-sheet-body">
				<div class="empty">
					if d.Build.Running() {
						<p class="font-medium text-foreground">Starting the build…</p>
						<p>Output appears here as it arrives.</p>
					} else {
						<p class="font-medium text-foreground">The build wrote nothing</p>
						<p>It ended before any step produced output.</p>
					}
				</div>
			</div>
		} else {
			<div class="canvas-sheet-actions">
				@findBox(d, viewBuild)
			</div>
			<div class="canvas-sheet-log">
				<div class="logs">
					for _, line := range filterBuildLog(buildLines(d.Build.Log), d.Find) {
						<div class="log-line">
							<span class="log-text">
								@highlight(line, d.Find)
							</span>
						</div>
					}
				</div>
			</div>
		}
	}
}

templ buildStatus(b app.Build) {
	switch b.Status {
		case app.BuildSucceeded:
			<span class="status status-ok">built</span>
		case app.BuildFailed:
			<span class="status status-err">failed</span>
		default:
			<span class="status status-warn">building</span>
	}
}

// httpLogView shows what the ingress controller recorded for this app.
//
// One controller logs every tenant's traffic into one stream, so what makes
// this one app's log is the hostname filter — built from an owner-scoped query
// upstream, never from anything the request said.
templ httpLogView(d DeployLogsData) {
	<div class="canvas-sheet-actions">
		<span class="min-w-0 flex-1 truncate text-[12px] text-muted-foreground">
			if len(d.HTTP.Hosts) > 0 {
				Requests to <span class="mono">{ joinHosts(d.HTTP.Hosts) }</span>
			} else {
				No hostname
			}
		</span>
		<span class="text-[12px] text-muted-foreground tabular-nums">
			{ plural(d.HTTPPage.Matched, "request") }
		</span>
	</div>
	if len(d.HTTP.Hosts) > 0 {
		<div class="canvas-sheet-actions">
			@methodPicker(d)
			@searchBox(d.HTTPPage, "Search path, status or client")
		</div>
	}
	if len(d.HTTP.Lines) == 0 {
		<div class="canvas-sheet-body">
			if d.HTTPPage.Filtered() {
				@noMatches(d.HTTPPage, "No requests recorded", d.HTTP.Note)
			} else {
				<div class="empty">
					<p class="font-medium text-foreground">No requests recorded</p>
					if d.HTTP.Note != "" {
						<p>{ d.HTTP.Note }</p>
					}
				</div>
			}
			if d.HTTP.CanEnable {
				<form
					method="post"
					action={ templ.URL("/apps/" + d.App + "/logs/http/enable") }
					class="mt-4"
					onsubmit="return confirm('Turn on request logging? The ingress controller restarts, so every app in this cluster drops connections for a few seconds.')"
				>
					<button class="btn btn-primary" type="submit">Turn on request logging</button>
					<p class="mt-2 text-[12.5px] text-muted-foreground">
						This restarts the ingress controller, so every app in the cluster drops
						connections for a few seconds. It applies to the whole cluster, not just
						this app — there is one controller and one log.
					</p>
				</form>
			} else if d.HTTP.Hint != "" {
				<p class="mt-4 text-[12.5px] text-muted-foreground">
					This cluster's ingress controller was installed by something other than
					k3s, so Yacht cannot reconfigure it. Apply this wherever it was
					installed from:
				</p>
				<div class="logs mt-2 rounded-md border border-border">
					for _, line := range buildLines(d.HTTP.Hint) {
						<div class="log-line"><span class="log-text">{ line }</span></div>
					}
				</div>
			}
		</div>
	} else {
		// The timeline reads its counts from the script beside it rather than
		// from the rows below, because the rows are paged and the shape of the
		// traffic is not.
		<div class="http-chart-wrap">
			@templ.JSONScript("http-chart-data", d.HTTPBuckets)
			<div class="http-chart" data-http-chart data-source="http-chart-data"></div>
		</div>
		<div class="canvas-sheet-log">
			<div class="logs">
				for _, l := range d.HTTP.Lines {
					<div class="log-line">
						if !l.At.IsZero() {
							<span class="log-time">{ l.At.Format("15:04:05") }</span>
						}
						<span class={ "shrink-0 tabular-nums", statusClass(l.Status) }>
							{ strconv.Itoa(l.Status) }
						</span>
						<span class="log-text">
							{ l.Method } { l.Path } &middot; { requestTiming(l) }
						</span>
					</div>
				}
			</div>
		</div>
		@pageControls(d.HTTPPage)
	}
}
