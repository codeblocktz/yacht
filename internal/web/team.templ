package web

import (
	"github.com/codeblocktz/yacht/internal/account"
	"github.com/codeblocktz/yacht/internal/web/ui/selectbox"
)

// TeamPage lists who is in the team and who has been invited.
//
// Note what is not here: an invitation token, or anything it could be derived
// from. account.Invitation has no such field, so a template cannot print one
// even by accident — an invitation link on this page would let any reader join
// as the invitee.
templ TeamPage(d TeamPageData) {
	@pageHead("Team", d.TeamName, nil)
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	<div class="panel mb-5">
		<div class="panel-header"><span class="panel-title">Members</span></div>
		<div class="table-scroll">
		<table class="dtable min-w-[620px]">
			<thead>
				<tr><th>Person</th><th>Role</th><th class="text-right">Actions</th></tr>
			</thead>
			<tbody>
				for _, m := range d.Members {
					<tr>
						<td>
							<span class="mono">{ m.Email }</span>
							if m.Name != "" {
								<span class="text-muted-foreground">{ m.Name }</span>
							}
						</td>
						<td>
							@statusDot(string(m.Role), roleTone(m.Role))
						</td>
						<td class="text-right">
							<div class="flex gap-2 justify-end">
								if d.Viewer.CanOwn() && m.UserID != d.ViewerID {
									<form method="post" action={ templ.SafeURL("/team/members/" + m.UserID.String() + "/role") } class="inline">
										@selectbox.SelectBox() {
											@selectbox.Trigger(selectbox.TriggerProps{
												Name: "role", Class: "h-8 w-[116px] text-[12px]",
											}) {
												@selectbox.Value(selectbox.ValueProps{Placeholder: string(m.Role)})
											}
											@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
												for _, r := range []account.Role{account.RoleMember, account.RoleAdmin, account.RoleOwner} {
													@selectbox.Item(selectbox.ItemProps{
														Value: string(r), Selected: r == m.Role,
													}) {
														{ string(r) }
													}
												}
											}
										}
										<button class="btn btn-sm" type="submit">Change role</button>
									</form>
								}
								if d.Viewer.CanAdminister() && m.UserID != d.ViewerID {
									<form method="post" action={ templ.SafeURL("/team/members/" + m.UserID.String() + "/remove") } class="inline">
										<button class="btn btn-sm btn-danger" type="submit">Remove</button>
									</form>
								}
							</div>
						</td>
					</tr>
				}
			</tbody>
		</table>
		</div>
	</div>
	if d.Viewer.CanAdminister() {
		<div class="panel mb-5">
			<div class="panel-header"><span class="panel-title">Pending invitations</span></div>
			if len(d.Invitations) == 0 {
				<div class="panel-body"><p class="text-muted-foreground">Nobody is waiting to join.</p></div>
			} else {
				<div class="table-scroll">
				<table class="dtable min-w-[480px]">
					<thead>
						<tr><th>Address</th><th>Role</th><th class="text-right">Actions</th></tr>
					</thead>
					<tbody>
						for _, inv := range d.Invitations {
							<tr>
								<td><span class="mono">{ inv.Email }</span></td>
								<td>
									@statusDot(string(inv.Role), roleTone(inv.Role))
								</td>
								<td class="text-right">
									<form method="post" action={ templ.SafeURL("/team/invitations/" + inv.ID.String() + "/revoke") } class="inline">
										<button class="btn btn-sm" type="submit">Revoke</button>
									</form>
								</td>
							</tr>
						}
					</tbody>
				</table>
				</div>
			}
		</div>
		<div class="panel mb-5">
			<div class="panel-header"><span class="panel-title">Invite someone</span></div>
			<div class="panel-body">
				<form method="post" action="/team/invite" class="flex flex-col gap-4 sm:flex-row sm:items-end">
					<div class="field grow">
						<label class="label" for="email">Email</label>
						<input class="control" id="email" name="email" type="email" required placeholder="colleague@example.com"/>
					</div>
					<div class="field">
						<label class="label" for="role">Role</label>
						@selectbox.SelectBox() {
							@selectbox.Trigger(selectbox.TriggerProps{ID: "role", Name: "role"}) {
								@selectbox.Value(selectbox.ValueProps{Placeholder: "member"})
							}
							@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
								@selectbox.Item(selectbox.ItemProps{Value: "member", Selected: true}) {
									member
								}
								@selectbox.Item(selectbox.ItemProps{Value: "admin"}) {
									admin
								}
								// Only an owner may appoint one. The server checks this
								// again; leaving it out here is so the form does not
								// offer something it will refuse.
								if d.Viewer.CanOwn() {
									@selectbox.Item(selectbox.ItemProps{Value: "owner"}) {
										owner
									}
								}
							}
						}
					</div>
					<button class="btn btn-primary" type="submit">Send invitation</button>
				</form>
			</div>
		</div>
	}
}
