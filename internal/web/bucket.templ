package web

import "github.com/codeblocktz/yacht/internal/app"

// canvasAddBucket is Add › Bucket: one click, a bucket named "bucket", as
// Add › Database deploys an engine.
templ canvasAddBucket(project string) {
	<form method="post" action="/apps/new/bucket">
		<input type="hidden" name="project" value={ project }/>
		<button type="submit" class="switcher-item w-full">
			@icon("bucket")
			<span class="flex-1 text-left">Bucket</span>
		</button>
	</form>
}

// BucketFailed is Add › Bucket when it could not make one.
templ BucketFailed(reason string) {
	@pageHead("Could not add the bucket", "", nil)
	<div class="callout callout-err max-w-2xl">
		<div class="min-w-0">
			<div class="font-medium">No bucket was made</div>
			<p class="mt-0.5 text-muted-foreground">{ reason }</p>
		</div>
	</div>
}

// bucketTabs are a bucket's: its files, its variables (what apps refer to),
// and its settings. Nothing runs, so there are no deployments, metrics or
// console.
templ bucketTabs(d AppDetailData) {
	<nav class="tabs canvas-sheet-tabs" aria-label="Bucket">
		@appTab(d.App.Name, bucketTab(d.Tab), "", "Files")
		@appTab(d.App.Name, d.Tab, "variables", "Variables")
		@appTab(d.App.Name, settingsTab(d.Tab), "settings", "Settings")
	</nav>
}

templ bucketPanelBody(d AppDetailData) {
	switch d.Tab {
		case "variables":
			@appVariables(d)
		case "settings", "domains", "storage":
			@bucketSettings(d)
		default:
			@bucketFiles(d)
	}
}

// bucketFiles is the Files tab: what the bucket holds, how to reach it, and
// its contents, loaded after the tab draws and replaced folder by folder.
templ bucketFiles(d AppDetailData) {
	if b := d.Bucket; b != nil {
		<div class="metrics mb-4">
			@metric("Stored", formatBytes(b.Bytes), measuredLabel(*b))
			@metric("Files", itoa(int(b.Objects)), "")
			if b.TeamLimit > 0 {
				@metric("Team's buckets", formatBytes(b.TeamBytes)+" of "+formatBytes(b.TeamLimit), bucketRoom(*b))
			}
			@metric("Bucket", b.Name, b.Endpoint)
		</div>
	}
	<div
		id="bucket-files"
		hx-get={ "/apps/" + d.App.Name + "/files/list" }
		hx-trigger="load"
		hx-swap="outerHTML"
	>
		<div class="panel">
			<div class="panel-body text-muted-foreground">Reading the bucket…</div>
		</div>
	</div>
	if b := d.Bucket; b != nil {
		@bucketConnect(d.App.Name, *b)
	}
}

// bucketConnect says how an app reaches the bucket: its variables, by
// reference, so a key that changes reaches every app at its next deploy.
templ bucketConnect(name string, b app.Bucket) {
	<div class="panel mt-4">
		<div class="panel-header">
			<span class="panel-title">Connect</span>
		</div>
		<div class="panel-body">
			<p class="text-muted-foreground">
				Any S3 client works: AWS's SDKs, boto3, rclone, the aws CLI. Give an app these
				variables, by reference, and point its client at them, with path-style requests.
			</p>
			<pre class="mono mt-3 select-all overflow-x-auto rounded-md border border-border bg-muted/40 p-3 text-[12px] leading-relaxed">{ bucketReferences(name) }</pre>
			<p class="hint mt-2">
				The key reaches this bucket and no other. Files are private: share one with a link
				your app signs, as S3 does everywhere.
			</p>
		</div>
	</div>
}

// BucketListing is one folder of the bucket. It replaces itself as somebody
// opens a folder, uploads or deletes, so the folder they are in stays theirs.
templ BucketListing(d BucketListingData) {
	<div id="bucket-files">
		if d.Error != "" {
			<div class="callout callout-err mb-3">
				<div class="min-w-0">{ d.Error }</div>
			</div>
		}
		if d.Notice != "" {
			<div class="callout mb-3">
				<div class="min-w-0 text-muted-foreground">{ d.Notice }</div>
			</div>
		}
		<div class="panel">
			<div class="panel-header gap-3">
				<nav class="flex min-w-0 flex-1 flex-wrap items-center gap-1 text-[13px]" aria-label="Folder">
					@bucketFolderLink(d.App, "", d.Bucket.Name)
					for _, c := range d.Crumbs() {
						<span class="text-muted-foreground">/</span>
						@bucketFolderLink(d.App, c[1], c[0])
					}
				</nav>
				<form
					hx-post={ "/apps/" + d.App + "/files" }
					hx-encoding="multipart/form-data"
					hx-target="#bucket-files"
					hx-swap="outerHTML"
					hx-trigger="change from:find input[type=file]"
					hx-disabled-elt="find label"
				>
					<input type="hidden" name="prefix" value={ d.Listing.Prefix }/>
					<label class="btn btn-sm cursor-pointer">
						@icon("upload")
						Upload
						<input class="sr-only" type="file" name="file" multiple/>
					</label>
				</form>
			</div>
			if !d.Read {
				<div class="panel-body text-muted-foreground">The folder could not be read.</div>
			} else if len(d.Listing.Folders) == 0 && len(d.Listing.Objects) == 0 {
				<div class="empty">
					<span class="empty-mark" aria-hidden="true">
						@icon("bucket")
					</span>
					if d.Listing.Prefix == "" {
						<p class="font-medium text-foreground">No files yet</p>
						<p>Upload some here, or have an app put them in with the variables below.</p>
					} else {
						<p class="font-medium text-foreground">This folder is empty</p>
					}
				</div>
			} else {
				<table class="dtable">
					<thead>
						<tr>
							<th>Name</th>
							<th class="text-right">Size</th>
							<th>Modified</th>
							<th class="w-0"></th>
						</tr>
					</thead>
					<tbody>
						for _, f := range d.Listing.Folders {
							<tr>
								<td colspan="4">
									<a
										class="inline-flex items-center gap-2 hover:underline"
										href="#"
										hx-get={ bucketListHref(d.App, f, "") }
										hx-target="#bucket-files"
										hx-swap="outerHTML"
									>
										@icon("folder")
										{ folderName(f) }
									</a>
								</td>
							</tr>
						}
						for _, o := range d.Listing.Objects {
							<tr>
								<td class="max-w-0">
									<a
										class="inline-flex max-w-full items-center gap-2 hover:underline"
										href={ templ.URL(bucketDownloadHref(d.App, o.Key)) }
										target="_blank"
										rel="noreferrer"
									>
										@icon("file")
										<span class="truncate">{ o.Name() }</span>
									</a>
								</td>
								<td class="text-right tabular-nums text-muted-foreground">{ formatBytes(o.Size) }</td>
								<td class="whitespace-nowrap text-muted-foreground">{ relativeTime(o.Modified) }</td>
								<td>
									<span class="flex justify-end gap-1">
										<a class="btn btn-ghost btn-sm btn-icon" href={ templ.URL(bucketDownloadHref(d.App, o.Key)) } aria-label={ "Download " + o.Name() }>
											@icon("download")
										</a>
										<form
											hx-post={ "/apps/" + d.App + "/files/delete" }
											hx-target="#bucket-files"
											hx-swap="outerHTML"
										>
											<input type="hidden" name="key" value={ o.Key }/>
											<button
												class="btn btn-ghost btn-sm btn-icon"
												type="submit"
												aria-label={ "Delete " + o.Name() }
												data-confirm={ "Delete " + o.Name() + "? It is gone from the bucket for every app that reads it." }
												data-confirm-title="Delete this file?"
												data-confirm-label="Delete"
											>
												@icon("trash")
											</button>
										</form>
									</span>
								</td>
							</tr>
						}
					</tbody>
				</table>
				if d.Listing.Next != "" || d.After != "" {
					<div class="panel-body flex justify-between text-[13px]">
						if d.After != "" {
							<a href="#" class="hover:underline" hx-get={ bucketListHref(d.App, d.Listing.Prefix, "") } hx-target="#bucket-files" hx-swap="outerHTML">First page</a>
						} else {
							<span></span>
						}
						if d.Listing.Next != "" {
							<a href="#" class="hover:underline" hx-get={ bucketListHref(d.App, d.Listing.Prefix, d.Listing.Next) } hx-target="#bucket-files" hx-swap="outerHTML">More</a>
						}
					</div>
				}
			}
		</div>
	</div>
}

templ bucketFolderLink(app, prefix, label string) {
	<a
		href="#"
		class="mono truncate hover:underline"
		hx-get={ bucketListHref(app, prefix, "") }
		hx-target="#bucket-files"
		hx-swap="outerHTML"
	>{ label }</a>
}

// bucketSettings is a bucket's Settings: only its deletion, which takes every
// file with it. Nothing else about it can be set.
templ bucketSettings(d AppDetailData) {
	{{ a := d.App }}
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">{ d.Error }</div>
		</div>
	}
	<div class="panel border-l-2 border-l-destructive">
		<div class="panel-header">
			<span class="panel-title">Danger zone</span>
		</div>
		<div class="panel-body">
			<div class="font-medium">Delete this bucket</div>
			<p class="hint mt-0.5">
				Deletes every file in it and its key. Apps that read it get errors from then on.
				Not reversible.
			</p>
			<form
				method="post"
				action={ templ.URL("/apps/" + a.Name + "/delete") }
				class="mt-4 flex flex-wrap items-end gap-3"
			>
				<div class="field min-w-[220px] flex-1">
					<label class="label" for="confirm-delete">
						Type <code class="mono">{ a.Name }</code> to confirm
					</label>
					<input
						class="control mono"
						id="confirm-delete"
						name="confirm"
						placeholder={ a.Name }
						autocomplete="off"
						required
					/>
				</div>
				<button
					class="btn btn-danger"
					type="submit"
					data-confirm="This deletes the bucket, every file in it, and its key. This cannot be undone."
					data-confirm-title={ "Delete " + a.Name + "?" }
					data-confirm-label="Delete bucket"
				>Delete bucket</button>
			</form>
		</div>
	</div>
}
