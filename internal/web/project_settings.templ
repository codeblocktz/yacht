package web

import (
	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/web/ui/selectbox"
)

// ProjectSettingsData is a project's settings page.
type ProjectSettingsData struct {
	Project app.Project
	// Apps is how many apps deleting the project deletes with it.
	Apps     int
	Error    string
	CanAdmin bool
	// RoleAdmin is the viewer being an admin of the team, whatever the
	// service supports: what making and deleting environments asks.
	RoleAdmin bool

	// Shared is the project's shared variables, and SharedOn whether the
	// service has them at all; without, the section is left out.
	Shared      []app.Variable
	SharedOn    bool
	SharedAdmin bool

	// Environments are the project's, production first; EnvironmentsOn says
	// the service has them, and Copied is what creating one just did.
	Environments   []app.Environment
	EnvironmentsOn bool
	Copied         []app.EnvironmentCopy
	CopiedEnv      string
	// PROn says the service makes environments for pull requests.
	PROn bool
}

// ProjectSettings is the project's own settings, reached from the rail, as
// Railway's are: what the project is called, and deleting it.
templ ProjectSettings(d ProjectSettingsData) {
	<div class="project-page">
		<div class="project-page-inner">
			<h1 class="text-[20px] font-semibold tracking-tight">Project Settings</h1>
			if d.Error != "" {
				<div class="callout callout-err mt-5">
					<div class="min-w-0">{ d.Error }</div>
				</div>
			}
			<div class="settings-shell mt-6">
				<nav class="settings-nav" aria-label="Settings sections">
					<a href="#general">General</a>
					if d.EnvironmentsOn {
						<a href="#environments">Environments</a>
					}
					if d.SharedOn {
						<a href="#shared-variables">Shared Variables</a>
					}
					<a href="#danger">Danger</a>
				</nav>
				<div class="min-w-0 flex-1">
					<section id="general" class="settings-section">
						<div class="settings-section-head">
							<span class="settings-section-mark">@icon("settings")</span>
							<h2 class="settings-section-title">Project info</h2>
						</div>
						<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/rename") } class="field-group">
							<label class="field-label" for="project-name">Name</label>
							<p class="field-note">What the project is called on screen. Its address stays <code class="mono">{ "/projects/" + d.Project.Slug }</code>.</p>
							<div class="mt-1.5 flex items-center gap-2">
								<input class="control w-72" id="project-name" name="name" value={ d.Project.Name } required maxlength="80" disabled?={ !d.CanAdmin }/>
								if d.CanAdmin {
									<button class="btn" type="submit">Update</button>
								}
							</div>
						</form>
						<div class="field-group">
							<span class="field-label">Project ID</span>
							<p class="mono mt-1 text-[12.5px] text-muted-foreground">{ d.Project.ID.String() }</p>
						</div>
					</section>
					if d.SharedOn {
						@sharedVariablesSection(d)
					}
					if d.EnvironmentsOn {
						@projectEnvironments(d)
					}
					<section id="danger" class="settings-section">
						<div class="settings-section-head">
							<span class="settings-section-mark">@icon("minus")</span>
							<h2 class="settings-section-title">Danger</h2>
						</div>
						<div class="panel border-l-2 border-l-destructive">
							<div class="panel-body">
								<div class="font-medium">Delete this project</div>
								if d.Project.Slug == app.DefaultProjectSlug {
									<p class="hint mt-0.5">
										The default project is where an app lands when nobody chose a project, so it
										cannot be deleted. Delete or move its apps instead.
									</p>
								} else if !d.CanAdmin {
									<p class="hint mt-0.5">Only an admin of the team can delete a project.</p>
								} else {
									<p class="hint mt-0.5">
										Deletes the project and its { plural(d.Apps, "app") } — each one's workload,
										namespace, domains and storage. Not reversible.
									</p>
									<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/delete") } class="mt-4 flex flex-wrap items-end gap-3">
										<div class="field min-w-[220px] flex-1">
											<label class="label" for="confirm-project">
												Type <code class="mono">{ d.Project.Name }</code> to confirm
											</label>
											<input class="control" id="confirm-project" name="confirm" placeholder={ d.Project.Name } autocomplete="off" required/>
										</div>
										<button class="btn btn-danger" type="submit">
											Delete project
											if d.Apps > 0 {
												{ " and its " + plural(d.Apps, "app") }
											}
										</button>
									</form>
								}
							</div>
						</div>
					</section>
				</div>
			</div>
		</div>
	</div>
}

// projectEnvironments is Railway's Project Settings › Environments: each an
// isolated copy of the project's services.
templ projectEnvironments(d ProjectSettingsData) {
	<section id="environments" class="settings-section">
		<div class="settings-section-head">
			<span class="settings-section-mark">@icon("layers")</span>
			<h2 class="settings-section-title">Environments</h2>
		</div>
		<p class="field-note mb-3">
			Each environment is its own copy of the project's services, with its own variables, domains,
			databases and deploys. Nothing in one reaches another.
		</p>
		if len(d.Copied) > 0 {
			<div class="callout mb-4">
				<div class="min-w-0">
					<div class="font-medium">{ d.CopiedEnv } is being deployed</div>
					<ul class="mt-1 list-disc pl-5 text-[12.5px] text-muted-foreground">
						for _, c := range d.Copied {
							<li>
								<span class="mono text-foreground">{ c.Service }</span>
								if c.Err != nil {
									<span class="text-destructive">{ " — not copied: " + c.Err.Error() }</span>
								} else if c.Note != "" {
									{ " — " + c.Note }
								}
							</li>
						}
					</ul>
				</div>
			</div>
		}
		<div class="panel">
			<div class="rows">
				for _, e := range d.Environments {
					<div class="row-item">
						<span class={ "tree-dot", envDot(e.Slug) } aria-hidden="true"></span>
						<a class="min-w-0 flex-1 truncate font-medium hover:underline" href={ templ.URL(envHref(d.Project.Slug, e.Slug)) }>{ e.Name }</a>
						<span class="text-[12px] tabular-nums text-muted-foreground">{ plural(e.Apps, "service") }</span>
						if e.CopiedFrom != "" {
							<span class="tag">{ "copied from " + e.CopiedFrom }</span>
						}
						if !e.Production && d.RoleAdmin {
							<form
								method="post"
								action={ templ.URL("/projects/" + d.Project.Slug + "/environments/" + e.Slug + "/delete") }
								data-confirm={ "Deletes " + e.Name + " and its " + plural(e.Apps, "service") + " — their data, domains and deploys. Production is not touched." }
								data-confirm-title={ "Delete " + e.Name + "?" }
								data-confirm-label="Delete environment"
							>
								<button class="btn btn-sm btn-danger" type="submit">Delete</button>
							</form>
						}
					</div>
				}
			</div>
		</div>
		if d.PROn {
			<div class="panel mt-4">
				<div class="panel-body flex flex-wrap items-center justify-between gap-3">
					<div class="min-w-0">
						<div class="font-medium">PR Environments</div>
						<p class="hint mt-0.5">
							An environment for each pull request opened against a repository this project builds — production
							copied, building the pull request's branch — taken down when it closes. A fork's pull request is
							never built: its code would run with this project's variables.
						</p>
					</div>
					if d.RoleAdmin {
						<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/pr-environments") }>
							if d.Project.PREnvironments {
								<button class="btn btn-sm" type="submit">Disable</button>
							} else {
								<input type="hidden" name="enabled" value="1"/>
								<button class="btn btn-sm btn-primary" type="submit">Enable PR Environments</button>
							}
						</form>
					} else if d.Project.PREnvironments {
						<span class="tag">on</span>
					}
				</div>
			</div>
		}
		if d.RoleAdmin {
			<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/environments") } class="mt-4 flex flex-wrap items-end gap-3">
				<div class="field">
					<label class="label" for="env-name">New environment</label>
					<input class="control w-56" id="env-name" name="name" placeholder="staging" required maxlength="30"/>
				</div>
				<div class="field">
					<label class="label" for="env-from">Start as</label>
					@selectbox.SelectBox(selectbox.Props{Class: "w-56"}) {
						@selectbox.Trigger(selectbox.TriggerProps{ID: "env-from", Name: "from"}) {
							@selectbox.Value(selectbox.ValueProps{Placeholder: "A copy of production"})
						}
						@selectbox.Content(selectbox.ContentProps{NoSearch: true}) {
							for _, e := range d.Environments {
								@selectbox.Item(selectbox.ItemProps{Value: e.Slug, Selected: e.Production}) {
									{ "A copy of " + e.Name }
								}
							}
							@selectbox.Item(selectbox.ItemProps{Value: "-"}) {
								Empty
							}
						}
					}
				</div>
				<button class="btn btn-primary" type="submit">Create</button>
			</form>
		}
	</section>
}
