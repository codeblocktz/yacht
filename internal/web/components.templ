package web

import "github.com/codeblocktz/yacht/internal/web/ui/popover"

// stepList renders a progression through stages that arrive over time.
//
// Deliberately dumb: it draws what it is handed and decides nothing. Which
// stage is active, and what the detail line says, is a question about domains or
// builds or nodes, and answering it here would put three subjects' logic in one
// template that understands none of them.
templ stepList(steps []Step) {
	<div class="steps">
		for _, st := range steps {
			<div class={ "step", string(st.State) }>
				<span class="step-dot" aria-hidden="true"></span>
				<div class="step-body">
					<div class="step-label">{ st.Label }</div>
					if st.Detail != "" {
						<div class="step-detail">{ st.Detail }</div>
					}
					if !st.At.IsZero() {
						<div class="step-time" title={ absoluteTime(st.At) }>
							{ preciseAgo(st.At) }
						</div>
					}
				</div>
			</div>
		}
	</div>
}

// recordTable renders a DNS record as the three fields a provider asks for.
templ recordTable(rec DNSRecord) {
	<div class="record">
		@recordRow("Type", rec.Type)
		@recordRow("Name", rec.Name)
		@recordRow("Value", rec.Value)
	</div>
}

templ recordRow(k, v string) {
	<div class="record-row">
		<span class="record-k">{ k }</span>
		<span class="record-v">{ v }</span>
		@copyButton(v, k)
	</div>
}

// copyButton copies one value to the clipboard.
//
// The value is carried in a data attribute rather than read out of the sibling
// element, so a template that renders the text with a suffix — a trailing dot on
// a fully-qualified name, say — still copies the thing somebody needs to paste
// rather than what happens to be on screen.
//
// Without JavaScript this button does nothing, which is why it is only ever
// beside text that is already selectable. Copying is a shortcut for a thing that
// remains possible by hand.
templ copyButton(value, label string) {
	<button
		type="button"
		class="copy-btn"
		data-copy={ value }
		aria-label={ "Copy " + label }
		title={ "Copy " + label }
	>
		<svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
			<rect width="13" height="13" x="9" y="9" rx="2"></rect>
			<path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
		</svg>
	</button>
}

// helpNote is the secondary half of an explanation, out of the way.
//
// The pages here carry a lot of prose, and it is good prose — but a form field
// with three paragraphs under it pushes the next field off the screen, and the
// sentence somebody actually needs is the first one. The first sentence stays
// on the page; the reasoning moves in here.
//
// Never the primary instruction. A person who cannot open a popover — no
// JavaScript, or a reader that skips it — must still be able to complete the
// task from what is on the page.
templ helpNote(label string) {
	@popover.Root() {
		@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeClick}) {
			<button
				type="button"
				class="ml-1 inline-grid size-4 shrink-0 place-items-center rounded-full border border-border align-[-1px] text-[9px] font-semibold text-muted-foreground transition-colors hover:border-foreground/40 hover:text-foreground focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring/50"
				aria-label={ "Why: " + label }
			>?</button>
		}
		@popover.Content(popover.ContentProps{
			Placement: popover.PlacementBottomStart,
			ShowArrow: true,
			Exclusive: true,
		}) {
			<div class="max-w-[22rem] px-3 py-2.5 text-[12px] leading-relaxed text-muted-foreground">
				{ children... }
			</div>
		}
	}
}
