package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// Canvas draws a project's apps and what connects them.
//
// Server-rendered: the layout is computed in Go and the edges are an SVG path
// list. There is no client-side graph library because there is no Node in this
// project, and a canvas that needs a build step to render is one a self-hoster
// cannot patch. Dragging is progressive — every card is a link first, and the
// script only adds the ability to move it.
templ Canvas(d CanvasData) {
	// A bar rather than a page heading: the graph is the page, and a heading
	// with a paragraph under it would push the thing somebody came to look at
	// below the fold.
	<div class="canvas-bar">
		<a class="canvas-bar-back" href="/projects" aria-label="All projects">
			@icon("layers")
		</a>
		<span class="min-w-0 truncate font-medium">{ d.Project.Name }</span>
		<span class="min-w-0 flex-1 truncate text-muted-foreground">
			How these apps relate to each other.
		</span>
		@deployButton()
	</div>
	if d.Empty {
		<div class="canvas-empty">
			@emptyApps()
		</div>
	} else {
		// The geometry lives here, in one place, so the script that re-routes
		// an edge mid-drag uses the same numbers the server laid out with
		// rather than a second copy that can drift from them.
		<div
			class="canvas"
			data-canvas
			data-card-w={ strconv.Itoa(cardW) }
			data-card-h={ strconv.Itoa(cardH) }
			data-volume-h={ strconv.Itoa(volumeH) }
			data-project={ d.Project.Slug }
		>
			<div class="canvas-inner" style={ canvasSize(d) }>
				<svg class="canvas-edges" width={ strconv.Itoa(d.Width) } height={ strconv.Itoa(d.Height) }>
					<defs>
						<marker
							id="arrow"
							viewBox="0 0 8 8"
							refX="7"
							refY="4"
							markerWidth="6"
							markerHeight="6"
							orient="auto-start-reverse"
						>
							<path d="M0 0 L8 4 L0 8 z" class="canvas-arrow"></path>
						</marker>
					</defs>
					for _, e := range d.Edges {
						<path
							d={ e.Path }
							class="canvas-edge"
							marker-end="url(#arrow)"
							data-from={ e.From }
							data-to={ e.To }
						>
							<title>{ e.Via }</title>
						</path>
					}
				</svg>
				for _, n := range d.Nodes {
					<div
						class="canvas-node"
						style={ nodeAt(n) }
						data-node={ n.App.Name }
						data-has-volume={ boolAttr(n.Volume != nil) }
					>
						<a
							href={ templ.URL("/apps/" + n.App.Name) }
							class={ "canvas-card",
								templ.KV("canvas-card-open", d.Open != nil && d.Open.App.Name == n.App.Name) }
						>
							// The handle is a separate target from the link. Dragging
							// from anywhere on the card would mean every click has to
							// be told apart from a very short drag, and the one that
							// guesses wrong either loses the drag or follows a link
							// somebody was only moving.
							<span class="canvas-grip" data-drag-handle aria-hidden="true">
								@icon("grip")
							</span>
							<span class="canvas-card-head">
								@icon(sourceIcon(n.App.Source))
								<span class="min-w-0 flex-1 truncate font-medium">{ n.App.Name }</span>
							</span>
							<span class="canvas-card-status">
								@appStatus(n.App)
								if n.App.Host != "" {
									<span class="mono truncate text-[11.5px] text-muted-foreground">
										{ n.App.Host }
									</span>
								}
							</span>
						</a>
						if n.Volume != nil {
							<a
								href={ templ.URL("/apps/" + n.App.Name + "/storage") }
								class="canvas-volume"
							>
								@icon("disk")
								<span class="min-w-0 flex-1 truncate">{ n.Volume.Name }</span>
								<span class="text-muted-foreground">{ gigabytes(n.Volume.SizeBytes) } GB</span>
							</a>
						}
					</div>
				}
			</div>
			// Floating on the surface rather than in the bar, because they act on
			// the view rather than on the project — and because an infinite canvas
			// has no edge to hang them off. Hidden until the script runs: buttons
			// that do nothing without JavaScript say the page is broken rather
			// than that the feature is unavailable.
			<div class="canvas-controls" data-canvas-controls hidden>
				<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/arrange") }>
					<button class="canvas-ctl" type="submit" title="Lay the cards out from their dependencies again" aria-label="Auto-arrange">
						@icon("grid")
					</button>
				</form>
				<div class="canvas-ctl-group">
					<button class="canvas-ctl" type="button" data-zoom="in" title="Zoom in" aria-label="Zoom in">
						@icon("plus")
					</button>
					<button class="canvas-ctl canvas-ctl-level" type="button" data-zoom="reset" title="Reset to 100%">
						<span data-zoom-level>100%</span>
					</button>
					<button class="canvas-ctl" type="button" data-zoom="out" title="Zoom out" aria-label="Zoom out">
						@icon("minus")
					</button>
					<button class="canvas-ctl" type="button" data-zoom="fit" title="Fit the whole graph" aria-label="Fit">
						@icon("maximize")
					</button>
				</div>
			</div>
		</div>
		// A second sheet, at page level rather than inside the first: the
		// deployments list lives in the app's sheet, and a panel nested inside
		// the thing it covers cannot sit above it.
		@sheet.Sheet(sheet.Props{ID: "deploy-logs-sheet", Side: sheet.SideRight}) {
			@sheet.Content(sheet.ContentProps{Class: "canvas-sheet"}) {
				<div id="deploy-log-panel" class="flex min-h-0 flex-1 flex-col"></div>
			}
		}
		if d.Open != nil {
			// Rendered open, with its content already in it. Fetching the panel
			// after the page arrives would mean the app somebody navigated
			// straight to shows an empty sheet until a second request lands.
			@sheet.Sheet(sheet.Props{ID: "canvas-sheet", Side: sheet.SideRight, Open: true}) {
				@sheet.Content(sheet.ContentProps{Class: "canvas-sheet"}) {
					@appPanelBody(*d.Open)
				}
			}
		}
	}
}

// appPanelBody is the app's detail, shown in the sheet over its canvas.
//
// The same tabs the app used to have a page of its own for. It does not need
// one: what an app relates to is the canvas behind this panel, and a page that
// replaced the canvas hid every relationship at the moment somebody was
// changing one.
templ appPanelBody(d AppDetailData) {
	@sheet.Header(sheet.HeaderProps{Class: "canvas-sheet-head"}) {
		@sheet.Title() {
			<span class="flex min-w-0 items-center gap-2.5">
				@icon(sourceIcon(d.App.Source))
				<span class="truncate">{ d.App.Name }</span>
				@appStatus(d.App)
			</span>
		}
		if d.App.Host != "" {
			@sheet.Description() {
				<a
					class="mono inline-flex max-w-full items-center gap-1.5 hover:underline"
					href={ templ.URL(d.App.URLScheme() + "://" + d.App.Host) }
					target="_blank"
					rel="noreferrer"
				>
					<span class="truncate">{ d.App.Host }</span>
					<span class="[&>svg]:size-3.5">
						@icon("external")
					</span>
				</a>
			}
		} else {
			@sheet.Description() {
				<span class="mono truncate">{ d.App.Image }</span>
			}
		}
	}
	<div class="canvas-sheet-actions">
		<form method="post" action={ templ.URL("/apps/" + d.App.Name + "/redeploy") }>
			<button class="btn btn-sm" type="submit">Redeploy</button>
		</form>
		<form
			method="post"
			action={ templ.URL("/apps/" + d.App.Name + "/delete") }
			data-confirm="This deletes the app and its namespace. This cannot be undone."
			data-confirm-title={ "Delete " + d.App.Name + "?" }
			data-confirm-label="Delete app"
		>
			<button class="btn btn-danger btn-sm" type="submit">Delete</button>
		</form>
	</div>
	@appTabs(d.App.Name, d.Tab)
	<div class="canvas-sheet-body">
		switch d.Tab {
			case "variables":
				@appVariables(d)
			case "metrics":
				@appMetrics(d)
			case "storage":
				@appStorage(d)
			case "settings":
				@appSettings(d)
			default:
				@appDeployments(d)
		}
	</div>
}

// ProjectList is every canvas a team has.
//
// Shaped like the cluster page, because it answers the same kind of question:
// how much is here, and what are the pieces. The counts come first so the size
// of the install is readable without counting rows.
templ ProjectList(d ProjectListData) {
	@pageHead("Projects", "A project is one canvas: the apps that make up a system, and what connects them.", nil)
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">
				<div class="font-medium">Could not create that project</div>
				<p class="mt-0.5 text-muted-foreground">{ d.Error }</p>
			</div>
		</div>
	}
	<div class="metrics mb-5">
		@metric("Projects", strconv.Itoa(len(d.Projects)), "")
		@metric("Apps", strconv.FormatInt(totalApps(d.Projects), 10), "across every project")
	</div>
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">All projects</span>
			<form method="post" action="/projects" class="flex items-center gap-2">
				<input
					class="control h-8 w-[180px]"
					name="name"
					placeholder="New project"
					aria-label="New project name"
					required
				/>
				<button class="btn btn-sm" type="submit">Create</button>
			</form>
		</div>
		if len(d.Projects) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No projects</p>
				<p>Create one above, then deploy an app onto its canvas.</p>
			</div>
		} else {
			<div class="rows">
				for _, p := range d.Projects {
					@projectRow(p)
				}
			</div>
		}
	</div>
}

templ projectRow(p app.Project) {
	<a class="row-link" href={ templ.URL("/projects/" + p.Slug) }>
		@icon("boxes")
		<span class="min-w-0 flex-1">
			<span class="block truncate font-medium">{ p.Name }</span>
			<span class="mono block truncate text-muted-foreground">/projects/{ p.Slug }</span>
		</span>
		<span class="tabular-nums text-muted-foreground">{ plural(int(p.Apps), "app") }</span>
	</a>
}
