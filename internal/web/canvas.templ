package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// Canvas draws the apps and what connects them.
//
// Server-rendered: the layout is computed in Go and the edges are an SVG path
// list. There is no client-side graph library because there is no Node in this
// project, and a canvas that needs a build step to render is one a self-hoster
// cannot patch.
templ Canvas(d CanvasData) {
	// A bar rather than a page heading: the graph is the page, and a heading
	// with a paragraph under it would push the thing somebody came to look at
	// below the fold.
	<div class="canvas-bar">
		<span class="min-w-0 flex-1 truncate font-medium">Canvas</span>
		<span class="text-muted-foreground">How your apps relate to each other.</span>
		@deployButton()
	</div>
	if d.Empty {
		<div class="canvas-empty">
			@emptyApps()
		</div>
	} else {
		<div class="canvas-wrap">
		<div class="canvas">
			<div class="canvas-inner" style={ canvasSize(d) }>
				<svg class="canvas-edges" width={ strconv.Itoa(d.Width) } height={ strconv.Itoa(d.Height) }>
					<defs>
						<marker id="arrow" viewBox="0 0 8 8" refX="7" refY="4"
							markerWidth="6" markerHeight="6" orient="auto-start-reverse">
							<path d="M0 0 L8 4 L0 8 z" class="canvas-arrow"></path>
						</marker>
					</defs>
					for _, e := range d.Edges {
						<path d={ e.Path } class="canvas-edge" marker-end="url(#arrow)">
							<title>{ e.Via }</title>
						</path>
					}
				</svg>
				for _, n := range d.Nodes {
					<div class="canvas-node" style={ nodeAt(n) }>
						@sheet.Trigger(sheet.TriggerProps{For: "canvas-sheet"}) {
						<a
							href={ templ.URL("/apps/" + n.App.Name) }
							class="canvas-card"
							hx-get={ "/canvas/panel/" + n.App.Name }
							hx-target="#canvas-panel"
							hx-swap="innerHTML"
						>
							<span class="canvas-card-head">
								@icon(sourceIcon(n.App.Source))
								<span class="min-w-0 flex-1 truncate font-medium">{ n.App.Name }</span>
							</span>
							<span class="canvas-card-status">
								@appStatus(n.App)
								if n.App.Host != "" {
									<span class="mono truncate text-[11.5px] text-muted-foreground">
										{ n.App.Host }
									</span>
								}
							</span>
						</a>
					}
					if n.Volume != nil {
							@sheet.Trigger(sheet.TriggerProps{For: "canvas-sheet"}) {
							<a
								href={ templ.URL("/apps/" + n.App.Name + "/storage") }
								class="canvas-volume"
								hx-get={ "/canvas/panel/" + n.App.Name + "/volume/" + n.Volume.Name }
								hx-target="#canvas-panel"
								hx-swap="innerHTML"
							>
								@icon("disk")
								<span class="min-w-0 flex-1 truncate">{ n.Volume.Name }</span>
								<span class="text-muted-foreground">{ gigabytes(n.Volume.SizeBytes) } GB</span>
							</a>
						}
					}
					</div>
				}
			</div>
		</div>
		</div>
		// One sheet for every card rather than one each: the content is fetched
		// when something is clicked, so N sheets would be N copies of an empty
		// panel. Every card keeps its href, so the graph is still navigable with
		// JavaScript off — this is an improvement on that, not a replacement.
		@sheet.Sheet(sheet.Props{ID: "canvas-sheet", Side: sheet.SideRight}) {
			@sheet.Content() {
				<div id="canvas-panel" class="canvas-panel-body"></div>
			}
		}
	}
}

// CanvasPanel is the detail that slides in beside the graph.
//
// A fragment: htmx swaps it into the panel container, so the canvas keeps its
// scroll position and nothing re-renders that did not change. Opened directly
// it is still a readable page of facts, because a fragment that only works
// inside one page is a link nobody can share.
templ CanvasPanel(d CanvasPanelData) {
	@sheet.Header() {
		@sheet.Title() {
			<span class="flex min-w-0 items-center gap-2.5">
				if d.Volume != nil {
					@icon("disk")
					<span class="truncate">{ d.Volume.Name }</span>
				} else {
					@icon(sourceIcon(d.App.Source))
					<span class="truncate">{ d.App.Name }</span>
				}
			</span>
		}
		if d.Volume != nil {
			@sheet.Description() {
				Storage attached to { d.App.Name }.
			}
		}
	}
	<div class="panel-scroll">
		if d.Volume != nil {
			<dl class="kv">
				<dt>Mounted at</dt>
				<dd class="mono">{ d.Volume.MountPath }</dd>
				<dt>Size</dt>
				<dd class="tabular-nums">{ gigabytes(d.Volume.SizeBytes) } GB</dd>
				<dt>Attached to</dt>
				<dd>{ d.App.Name }</dd>
			</dl>
			<a class="btn mt-4" href={ templ.URL("/apps/" + d.App.Name + "/storage") }>
				Manage storage
			</a>
		} else {
			<dl class="kv">
				<dt>Status</dt>
				<dd>
					@appStatus(d.App)
				</dd>
				<dt>Image</dt>
				<dd class="mono break-all">{ d.App.Image }</dd>
				if d.App.Host != "" {
					<dt>URL</dt>
					<dd>
						<a class="mono" href={ templ.URL(d.App.URLScheme() + "://" + d.App.Host) } target="_blank" rel="noreferrer">
							{ d.App.Host }
						</a>
					</dd>
				}
				if d.App.Internal {
					<dt>Reachable</dt>
					<dd class="text-muted-foreground">Inside this install only.</dd>
				}
				<dt>Variables</dt>
				<dd class="tabular-nums">{ strconv.Itoa(len(d.App.Variables)) }</dd>
				<dt>Storage</dt>
				<dd>
					if len(d.App.Volumes) == 0 {
						<span class="text-muted-foreground">None</span>
					} else {
						<span class="mono">{ d.App.Volumes[0].MountPath }</span>
					}
				</dd>
			</dl>
			<div class="mt-4 flex flex-wrap gap-2">
				<a class="btn" href={ templ.URL("/apps/" + d.App.Name) }>Open app</a>
				<a class="btn" href={ templ.URL("/apps/" + d.App.Name + "/variables") }>Variables</a>
			</div>
		}
	</div>
}
