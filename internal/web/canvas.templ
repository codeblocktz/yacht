package web

import (
	"strconv"

	"github.com/codeblocktz/yacht/internal/app"
	"github.com/codeblocktz/yacht/internal/web/ui/popover"
	"github.com/codeblocktz/yacht/internal/web/ui/sheet"
)

// Canvas draws a project's apps and what connects them.
//
// Server-rendered first: the layout is computed in Go, every card is a link,
// and the edges are an SVG path list, so the page works with no script at
// all. canvas.js then hands the same cards to JointJS (vendored, no build
// step), which routes the arrows around them and makes them movable.
templ Canvas(d CanvasData) {
	// The page's one heading, for whoever navigates by headings: the canvas
	// draws the project's name in its bar rather than as a title, and the open
	// service's panel is the heading below this one.
	<h1 class="sr-only">{ d.Project.Name }</h1>
	if d.Empty {
		// An empty project is still a canvas, as Railway's is: the grid, Add
		// in its corner, and a word in the middle about what to put on it.
		<div class="canvas canvas-is-empty">
			<div class="canvas-empty">
				<div class="empty">
					<span class="empty-mark" aria-hidden="true">
						@icon("boxes")
					</span>
					<p class="font-medium text-foreground">Nothing here yet</p>
					<p>Add a GitHub repository, a database or an image — Add is at the top right.</p>
					<a class="btn btn-primary mt-3" href={ templ.SafeURL(newAppHref(d.Project.Slug)) }>Add a service</a>
				</div>
			</div>
			@canvasAdd(d.Project.Slug, d.Buckets)
		</div>
	} else {
		// The geometry lives here, in one place, so the script that re-routes
		// an edge mid-drag uses the same numbers the server laid out with
		// rather than a second copy that can drift from them.
		<div
			class="canvas"
			style={ canvasVars() }
			data-canvas
			data-card-w={ strconv.Itoa(cardW) }
			data-card-h={ strconv.Itoa(cardH) }
			data-volume-h={ strconv.Itoa(volumeH) }
			data-project={ d.Project.Slug }
			data-environment={ d.Env }
		>
			// What the drawing joins, for the script. The cards below are still
			// the server's, and are what a browser without the script shows.
			@templ.JSONScript("canvas-graph", d.Graph())
			<div class="canvas-inner" style={ canvasSize(d) }>
				<svg class="canvas-edges" width={ strconv.Itoa(d.Width) } height={ strconv.Itoa(d.Height) }>
					<defs>
						<marker
							id="arrow"
							viewBox="0 0 8 8"
							refX="7"
							refY="4"
							markerWidth="6"
							markerHeight="6"
							orient="auto-start-reverse"
						>
							<path d="M0 0 L8 4 L0 8 z" class="canvas-arrow"></path>
						</marker>
					</defs>
					for _, e := range d.Edges {
						<path
							d={ e.Path }
							class="canvas-edge"
							marker-end="url(#arrow)"
							data-from={ e.From }
							data-to={ e.To }
						>
							<title>{ e.Via }</title>
						</path>
					}
				</svg>
				for _, n := range d.Nodes {
					<div
						class="canvas-node"
						style={ nodeAt(n) }
						data-node={ n.App.Name }
						data-has-volume={ boolAttr(n.Volume != nil) }
					>
						<a
							href={ templ.URL("/apps/" + n.App.Name) }
							class={ "canvas-card",
								templ.KV("canvas-card-open", d.Open != nil && d.Open.App.Name == n.App.Name) }
						>
							// The handle is a separate target from the link. Dragging
							// from anywhere on the card would mean every click has to
							// be told apart from a very short drag, and the one that
							// guesses wrong either loses the drag or follows a link
							// somebody was only moving.
							<span class="canvas-grip" data-drag-handle aria-hidden="true">
								@icon("grip")
							</span>
							// Railway's card: what it is and where it answers at the
							// top, whether it is up at the foot.
							<span class="canvas-card-head">
								<span class="canvas-card-icon">
									@sourceMark(n.App.Source)
								</span>
								<span class="min-w-0 flex-1">
									<span class="block truncate font-semibold">{ n.App.ServiceName() }</span>
									if n.App.Host != "" {
										<span class="block truncate text-[12px] text-muted-foreground">{ n.App.Host }</span>
									}
								</span>
								@stagedMarker(d.Staged.For(n.App.Name))
							</span>
							{{ label, class := cardStatus(n.App) }}
							<span class={ "canvas-card-status", class }>
								<span class="card-status-dot" aria-hidden="true"></span>
								{ label }
							</span>
						</a>
						if n.Volume != nil {
							<a
								href={ templ.URL("/apps/" + n.App.Name + "/settings#volumes") }
								class="canvas-volume"
							>
								@icon("disk")
								<span class="min-w-0 flex-1 truncate">{ n.Volume.Name }</span>
								<span class="text-muted-foreground">{ gigabytes(n.Volume.SizeBytes) } GB</span>
							</a>
						}
					</div>
				}
			</div>
			@canvasAdd(d.Project.Slug, d.Buckets)
			@stagedBar(d)
			// Floating on the surface rather than in the bar, because they act on
			// the view rather than on the project — and because an infinite canvas
			// has no edge to hang them off. Hidden until the script runs: buttons
			// that do nothing without JavaScript say the page is broken rather
			// than that the feature is unavailable.
			<div class="canvas-controls" data-canvas-controls hidden>
				<form method="post" action={ templ.URL("/projects/" + d.Project.Slug + "/arrange") }>
					<button class="canvas-ctl" type="submit" title="Lay the cards out from their dependencies again" aria-label="Auto-arrange">
						@icon("grid")
					</button>
				</form>
				<div class="canvas-ctl-group">
					<button class="canvas-ctl" type="button" data-zoom="in" title="Zoom in" aria-label="Zoom in">
						@icon("plus")
					</button>
					<button class="canvas-ctl canvas-ctl-level" type="button" data-zoom="reset" title="Reset to 100%">
						<span data-zoom-level>100%</span>
					</button>
					<button class="canvas-ctl" type="button" data-zoom="out" title="Zoom out" aria-label="Zoom out">
						@icon("minus")
					</button>
					<button class="canvas-ctl" type="button" data-zoom="fit" title="Fit the whole graph" aria-label="Fit">
						@icon("maximize")
					</button>
				</div>
			</div>
		</div>
		// A second sheet, at page level rather than inside the first: the
		// deployments list lives in the app's sheet, and a panel nested inside
		// the thing it covers cannot sit above it.
		@sheet.Sheet(sheet.Props{ID: "deploy-logs-sheet", Side: sheet.SideRight}) {
			@sheet.Content(sheet.ContentProps{Class: "canvas-sheet"}) {
				<div id="deploy-log-panel" class="flex min-h-0 flex-1 flex-col"></div>
			}
		}
		if d.Open != nil {
			// Rendered open, with its content already in it. Fetching the panel
			// after the page arrives would mean the app somebody navigated
			// straight to shows an empty sheet until a second request lands.
			@sheet.Sheet(sheet.Props{ID: "canvas-sheet", Side: sheet.SideRight, Open: true}) {
				// Named by the service's title, so the dialog is announced
				// as the service rather than as an unnamed dialog.
				@sheet.Content(sheet.ContentProps{
					Class:      "canvas-sheet",
					Attributes: templ.Attributes{"aria-labelledby": canvasSheetTitle},
				}) {
					@appPanelBody(*d.Open)
				}
			}
		}
	}
}

// canvasSheetTitle is the id of the open service's title, which names the
// sheet it is in.
const canvasSheetTitle = "canvas-sheet-title"

// appPanelBody is the app's detail, shown in the sheet over its canvas.
//
// The same tabs the app used to have a page of its own for. It does not need
// one: what an app relates to is the canvas behind this panel, and a page that
// replaced the canvas hid every relationship at the moment somebody was
// changing one.
templ appPanelBody(d AppDetailData) {
	@sheet.Header(sheet.HeaderProps{Class: "canvas-sheet-head"}) {
		@sheet.Title(sheet.TitleProps{ID: canvasSheetTitle}) {
			<span class="flex min-w-0 items-center gap-2.5">
				@sourceMark(d.App.Source)
				<span class="truncate">{ d.App.ServiceName() }</span>
				if d.App.Environment() != app.DefaultEnvironment {
					<span class="tag">{ d.App.Environment() }</span>
				}
				@appStatus(d.App)
			</span>
		}
		if d.App.Host != "" {
			@sheet.Description() {
				<a
					class="mono inline-flex max-w-full items-center gap-1.5 hover:underline"
					href={ templ.URL(d.App.URLScheme() + "://" + d.App.Host) }
					target="_blank"
					rel="noreferrer"
				>
					<span class="truncate">{ d.App.Host }</span>
					<span class="[&>svg]:size-3.5">
						@icon("external")
					</span>
				</a>
			}
		} else {
			@sheet.Description() {
				<span class={ "mono truncate", templ.KV("italic text-muted-foreground", imageIsPending(d.App.Image)) }>{ appImageLabel(d.App) }</span>
			}
		}
	}
	// Railway's header is the service and nothing else. Redeploy is on the
	// live deployment and Delete is in Settings › Danger, where each is
	// next to what it acts on; sleeping and waking stay here, since they are
	// about the app as a whole and have nowhere better.
	if hasSleepActions(d) {
		<div class="canvas-sheet-actions">
			@sleepActions(d)
		</div>
	}
	if !d.App.Source.Workload() {
		@bucketTabs(d)
		<div class="canvas-sheet-body">
			@bucketPanelBody(d)
		</div>
	} else {
		@appTabs(d.App.Name, d.Tab) {
			@databaseTabs(d)
		}
		@serviceTabBody(d)
	}
}

// serviceTabBody is a running service's tab: everything but a bucket's.
templ serviceTabBody(d AppDetailData) {
	<div class="canvas-sheet-body">
		@sleepCallout(d)
		switch d.Tab {
			case "variables":
				@appVariables(d)
			case "metrics":
				@appMetrics(d)
			case "console":
				@appConsole(d)
			case "settings", "domains", "storage":
				// The old Domains and Storage addresses, and the forms that answer
				// to them, land on Settings, where both now live.
				@appSettings(d)
			case "database":
				@appDatabase(d)
			case "backups":
				@appBackups(d)
			default:
				@appDeployments(d)
		}
	</div>
}

// ProjectList is every canvas a team has.
//
// Shaped like the cluster page, because it answers the same kind of question:
// how much is here, and what are the pieces. The counts come first so the size
// of the install is readable without counting rows.
templ ProjectList(d ProjectListData) {
	@pageHead("Projects", "A project is one canvas: the apps that make up a system, and what connects them.", nil)
	if d.Error != "" {
		<div class="callout callout-err mb-5">
			<div class="min-w-0">
				<div class="font-medium">Could not create that project</div>
				<p class="mt-0.5 text-muted-foreground">{ d.Error }</p>
			</div>
		</div>
	}
	<div class="metrics mb-5">
		@metric("Projects", strconv.Itoa(len(d.Projects)), "")
		@metric("Apps", strconv.FormatInt(totalApps(d.Projects), 10), "across every project")
	</div>
	<div class="panel">
		<div class="panel-header">
			<span class="panel-title">All projects</span>
			<form method="post" action="/projects" class="flex items-center gap-2">
				<input
					id="new-project"
					class="control h-8 w-[180px]"
					name="name"
					placeholder="New project"
					aria-label="New project name"
					required
					autofocus?={ d.Focus }
				/>
				<button class="btn btn-sm" type="submit">Create</button>
			</form>
		</div>
		if len(d.Projects) == 0 {
			<div class="empty">
				<p class="font-medium text-foreground">No projects</p>
				<p>Create one above, then deploy an app onto its canvas.</p>
			</div>
		} else {
			<div class="rows">
				for _, p := range d.Projects {
					@projectRow(p)
				}
			</div>
		}
	</div>
}

templ projectRow(p app.Project) {
	<a class="row-link" href={ templ.URL("/projects/" + p.Slug) }>
		@icon("boxes")
		<span class="min-w-0 flex-1">
			<span class="block truncate font-medium">{ p.Name }</span>
			<span class="mono block truncate text-muted-foreground">/projects/{ p.Slug }</span>
		</span>
		<span class="tabular-nums text-muted-foreground">{ plural(int(p.Apps), "app") }</span>
	</a>
}

// canvasAdd is Railway's Add: one button on the canvas, and everything a
// project can be given behind it. Each entry is the flow that already
// exists for it, into this project.
templ canvasAdd(project string, buckets bool) {
	<div class="canvas-add">
		@popover.Root() {
			@popover.Trigger(popover.TriggerProps{TriggerType: popover.TriggerTypeClick}) {
				<button type="button" class="btn btn-sm canvas-add-btn">
					@icon("plus")
					Add
				</button>
			}
			@popover.Content(popover.ContentProps{Placement: popover.PlacementBottomEnd, Exclusive: true}) {
				// The GitHub step: a search over the team's repositories, in the
				// menu, as Railway's is. Shown by canvas.js; without it the
				// GitHub entry is a link to the same list on a page.
				<div class="canvas-add-github" data-add-step="github" hidden>
					<div class="flex items-center gap-2 border-b border-border p-2">
						<button type="button" class="btn btn-ghost btn-sm btn-icon" data-add-back aria-label="Back">
							@icon("chevron-right")
						</button>
						<input type="hidden" name="project" value={ project }/>
						<input
							class="control h-8 flex-1"
							type="search"
							name="q"
							placeholder="Search repositories"
							autocomplete="off"
							hx-get="/apps/new/github/repositories"
							hx-trigger="input changed delay:200ms, search"
							hx-target="next [data-add-rows]"
							hx-include="previous [name='project']"
						/>
					</div>
					<div class="canvas-add-rows" data-add-rows></div>
				</div>
				<div class="flex min-w-[230px] flex-col gap-px p-1" data-add-step="root">
					<div class="px-2 pb-1 pt-1.5 text-[11px] font-medium uppercase tracking-wide text-muted-foreground">Create</div>
					<a class="switcher-item" href={ templ.URL(githubDeployHref(project)) } data-add-open="github">
						@icon("github")
						<span class="flex-1">GitHub Repository</span>
					</a>
					@canvasAddDatabase(project)
					if buckets {
						@canvasAddBucket(project)
					}
					<a class="switcher-item" href={ templ.URL("/templates" + projectQuery("?", project)) }>
						@icon("layers")
						<span class="flex-1">Template</span>
					</a>
					<a class="switcher-item" href={ templ.URL(sourceHref(app.SourceImage, project)) }>
						@icon("package")
						<span class="flex-1">Docker Image</span>
					</a>
					<a class="switcher-item" href={ templ.URL(sourceHref(app.SourceGit, project)) }>
						@icon("box")
						<span class="flex-1">Git Repository</span>
					</a>
					<a class="switcher-item" href={ templ.URL(sourceHref(sourceEmpty, project)) }>
						@icon("square-dashed")
						<span class="flex-1">Empty Service</span>
					</a>
				</div>
			}
		}
	</div>
}
